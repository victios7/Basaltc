@lang go
@prelude go "box __go = 1 int64"
@rule go "package main" => "// package"
@rule go "import \"fmt\"" => "// fmt"
@rule go "func main() {" => "@cpu main(): int32 ["
@rule go "func $name() {" => "@cpu $name(): int32 ["
@rule go "func $name() int64 {" => "@cpu $name(): int64 ["
@rule go "func $name() int {" => "@cpu $name(): int64 ["
@rule go "var $name int64 = $val" => "box $name = $val int64"
@rule go "var $name int = $val" => "box $name = $val int64"
@rule go "var $name = $val" => "box $name = $val int64"
@rule go "$name := $val" => "box $name = $val int64"
@rule go "$name += $val" => "$name = $name + $val"
@rule go "$name -= $val" => "$name = $name - $val"
@rule go "$name *= $val" => "$name = $name * $val"
@rule go "$name = $val" => "$name = $val"
@rule go "for $cond {" => "while $cond ["
@rule go "for {" => "while 1 ["
@rule go "if $cond {" => "if $cond ["
@rule go "} else if $cond {" => "] else [ if $cond ["
@rule go "} else {" => "] else ["
@rule go "}" => "]"
@rule go "fmt.Println($name)" => "print_int($name)\nprint_nl()"
@rule go "fmt.Print($name)" => "print_int($name)"
@rule go "return $val" => "return($val)"
@rule go "return" => "return(0)"
@rule go "true" => "1"
@rule go "false" => "0"
