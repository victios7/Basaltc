@lang c
@prelude c "box __c = 1 int64"
@rule c "int main(void) {" => "@cpu main(): int32 ["
@rule c "int main() {" => "@cpu main(): int32 ["
@rule c "int $name(void) {" => "@cpu $name(): int32 ["
@rule c "long long $name(void) {" => "@cpu $name(): int64 ["
@rule c "int64_t $name = $val;" => "box $name = $val int64"
@rule c "long long $name = $val;" => "box $name = $val int64"
@rule c "int $name = $val;" => "box $name = $val int32"
@rule c "long $name = $val;" => "box $name = $val int64"
@rule c "$name += $val;" => "$name = $name + $val"
@rule c "$name -= $val;" => "$name = $name - $val"
@rule c "$name *= $val;" => "$name = $name * $val"
@rule c "$name = $val;" => "$name = $val"
@rule c "while ($cond) {" => "while $cond ["
@rule c "if ($cond) {" => "if $cond ["
@rule c "} else if ($cond) {" => "] else [ if $cond ["
@rule c "} else {" => "] else ["
@rule c "}" => "]"
@rule c "printf(\"%lld\\n\", (long long)$name);" => "print_int($name)\nprint_nl()"
@rule c "printf(\"%d\\n\", $name);" => "print_int($name)\nprint_nl()"
@rule c "return $val;" => "return($val)"
@rule c "return;" => "return(0)"
