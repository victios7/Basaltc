@lang python
@prelude python "box __python = 1 int64"
@rule python "def main():" => "@cpu main(): int32 ["
@rule python "def $name():" => "@cpu $name(): int32 ["
@rule python "def $name() -> int:" => "@cpu $name(): int64 ["
@rule python "$name = $val" => "box $name = $val int64"
@rule python "$name += $val" => "$name = $name + $val"
@rule python "$name -= $val" => "$name = $name - $val"
@rule python "$name *= $val" => "$name = $name * $val"
@rule python "$name //= $val" => "$name = $name / $val"
@rule python "while $cond:" => "while $cond ["
@rule python "if $cond:" => "if $cond ["
@rule python "else:" => "] else ["
@rule python "print($name)" => "print_int($name)\nprint_nl()"
@rule python "return $val" => "return($val)"
@rule python "return" => "return(0)"
@rule python "True" => "1"
@rule python "False" => "0"
@rule python "pass" => "// pass"
@rule python "and" => "*"
@rule python "or" => "+"
@rule python "not " => "!"
