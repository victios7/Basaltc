@lang zig
@prelude zig "box __zig = 1 int64"

// --- imports / noise ---
@rule zig "const std = @import(\"std\");" => "// std"
@rule zig "const builtin = @import(\"builtin\");" => "// builtin"
@rule zig "const $name = @import(\"$rest\");" => "// import"
@rule zig "@import(\"std\");" => "// std"
@rule zig "pub usingnamespace $rest;" => "// usingnamespace"
@rule zig "test \"$rest\" {" => "// test ["
@rule zig "comptime {" => "["
@rule zig "inline " => ""
@rule zig "nosuspend " => ""
@rule zig "export " => ""
@rule zig "callconv(.C) " => ""
@rule zig "unreachable;" => "panic(\"unreachable\")"
@rule zig "@panic(\"$rest\");" => "panic(\"$rest\")"
@rule zig "@compileError(\"$rest\");" => "@comptime_error(\"$rest\")"
@rule zig "@compileLog($rest);" => "// compileLog"

// --- var / const ---
@rule zig "var $name: i64 = $val;" => "box $name = $val int64"
@rule zig "var $name: i32 = $val;" => "box $name = $val int32"
@rule zig "var $name: i16 = $val;" => "box $name = $val int64"
@rule zig "var $name: i8 = $val;" => "box $name = $val int64"
@rule zig "var $name: u64 = $val;" => "box $name = $val int64"
@rule zig "var $name: u32 = $val;" => "box $name = $val int64"
@rule zig "var $name: u16 = $val;" => "box $name = $val int64"
@rule zig "var $name: u8 = $val;" => "box $name = $val int64"
@rule zig "var $name: usize = $val;" => "box $name = $val int64"
@rule zig "var $name: isize = $val;" => "box $name = $val int64"
@rule zig "var $name: f64 = $val;" => "box $name = $val float64"
@rule zig "var $name: f32 = $val;" => "box $name = $val float64"
@rule zig "var $name: f16 = $val;" => "box $name = $val float64"
@rule zig "var $name: bool = $val;" => "box $name = $val int64"
@rule zig "var $name: c_int = $val;" => "box $name = $val int32"
@rule zig "var $name: c_long = $val;" => "box $name = $val int64"
@rule zig "var $name: c_uint = $val;" => "box $name = $val int64"
@rule zig "var $name i64 = $val;" => "box $name = $val int64"
@rule zig "var $name i32 = $val;" => "box $name = $val int32"
@rule zig "var $name = $val;" => "box $name = $val int64"
@rule zig "const $name: i64 = $val;" => "box $name = $val int64"
@rule zig "const $name: i32 = $val;" => "box $name = $val int32"
@rule zig "const $name: usize = $val;" => "box $name = $val int64"
@rule zig "const $name: isize = $val;" => "box $name = $val int64"
@rule zig "const $name: f64 = $val;" => "box $name = $val float64"
@rule zig "const $name: f32 = $val;" => "box $name = $val float64"
@rule zig "const $name: bool = $val;" => "box $name = $val int64"
@rule zig "const $name: u64 = $val;" => "box $name = $val int64"
@rule zig "const $name = $val;" => "box $name = $val int64"
@rule zig "comptime var $name: i64 = $val;" => "box $name = $val int64"
@rule zig "comptime var $name = $val;" => "box $name = $val int64"
@rule zig "comptime const $name = $val;" => "box $name = $val int64"
@rule zig "threadlocal var $name: i64 = $val;" => "box $name = $val int64"

// --- functions ---
@rule zig "pub fn main() void {" => "@cpu main(): int32 ["
@rule zig "pub fn main() anyerror!void {" => "@cpu main(): int32 ["
@rule zig "pub fn main() !void {" => "@cpu main(): int32 ["
@rule zig "pub fn main() anyerror!i32 {" => "@cpu main(): int32 ["
@rule zig "fn main() void {" => "@cpu main(): int32 ["
@rule zig "fn main() anyerror!void {" => "@cpu main(): int32 ["
@rule zig "fn main() !void {" => "@cpu main(): int32 ["
@rule zig "fn main() i32 {" => "@cpu main(): int32 ["
@rule zig "pub fn $name() void {" => "@cpu $name(): int32 ["
@rule zig "pub fn $name() i64 {" => "@cpu $name(): int64 ["
@rule zig "pub fn $name() i32 {" => "@cpu $name(): int32 ["
@rule zig "pub fn $name() u64 {" => "@cpu $name(): int64 ["
@rule zig "pub fn $name() usize {" => "@cpu $name(): int64 ["
@rule zig "pub fn $name() bool {" => "@cpu $name(): int64 ["
@rule zig "pub fn $name() f64 {" => "@cpu $name(): float64 ["
@rule zig "pub fn $name() !void {" => "@cpu $name(): int32 ["
@rule zig "pub fn $name() anyerror!void {" => "@cpu $name(): int32 ["
@rule zig "fn $name() void {" => "@cpu $name(): int32 ["
@rule zig "fn $name() i64 {" => "@cpu $name(): int64 ["
@rule zig "fn $name() i32 {" => "@cpu $name(): int32 ["
@rule zig "fn $name() u64 {" => "@cpu $name(): int64 ["
@rule zig "fn $name() bool {" => "@cpu $name(): int64 ["
@rule zig "fn $name() !void {" => "@cpu $name(): int32 ["
@rule zig "export fn $name() void {" => "@cpu $name(): int32 ["
@rule zig "export fn $name() i64 {" => "@cpu $name(): int64 ["
@rule zig "export fn $name() i32 {" => "@cpu $name(): int32 ["

// --- control ---
@rule zig "while ($cond) {" => "while $cond ["
@rule zig "while($cond){" => "while $cond ["
@rule zig "while ($cond) |" => "while $cond ["
@rule zig "inline while ($cond) {" => "while $cond ["
@rule zig "for ($cond) |" => "while $cond ["
@rule zig "for ($cond) {" => "while $cond ["
@rule zig "inline for ($cond) {" => "while $cond ["
@rule zig "if ($cond) {" => "if $cond ["
@rule zig "if($cond){" => "if $cond ["
@rule zig "if ($cond) |" => "if $cond ["
@rule zig "} else if ($cond) {" => "] else [ if $cond ["
@rule zig "} else if($cond){" => "] else [ if $cond ["
@rule zig "} else {" => "] else ["
@rule zig "} else{" => "] else ["
@rule zig "}" => "]"
@rule zig "switch ($name) {" => "if 1 ["
@rule zig "orelse" => "// orelse"
@rule zig "catch" => "// catch"
@rule zig "defer " => "// defer "
@rule zig "errdefer " => "// errdefer "

// --- ops ---
@rule zig "$name += $val;" => "$name = $name + $val"
@rule zig "$name -= $val;" => "$name = $name - $val"
@rule zig "$name *= $val;" => "$name = $name * $val"
@rule zig "$name /= $val;" => "$name = $name / $val"
@rule zig "$name %= $val;" => "$name = $name - ($name / $val) * $val"
@rule zig "$name = $val;" => "$name = $val"
@rule zig "$name += 1;" => "$name = $name + 1"
@rule zig "$name -= 1;" => "$name = $name - 1"
@rule zig "true" => "1"
@rule zig "false" => "0"
@rule zig "and" => "*"
@rule zig "or" => "+"

// --- I/O / return ---
@rule zig "print($name);" => "print_int($name)\nprint_nl()"
@rule zig "println($name);" => "print_int($name)\nprint_nl()"
@rule zig "std.debug.print(\"{}\", .{$name});" => "print_int($name)\nprint_nl()"
@rule zig "std.debug.print(\"{d}\\n\", .{$name});" => "print_int($name)\nprint_nl()"
@rule zig "std.debug.print(\"{d}\", .{$name});" => "print_int($name)"
@rule zig "std.debug.print(\"{any}\\n\", .{$name});" => "print_int($name)\nprint_nl()"
@rule zig "return $val;" => "return($val)"
@rule zig "return;" => "return(0)"
@rule zig "return error.$rest;" => "return(1)"
@rule zig "try $rest;" => "$rest"
@rule zig "break :$rest $val;" => "// break\n$val"
@rule zig "break $val;" => "// break"
@rule zig "continue :$rest;" => "// continue"
@rule zig "continue;" => "// continue"

// --- casts / builtins ---
@rule zig "@as(i64, $val)" => "($val)"
@rule zig "@as(i32, $val)" => "($val)"
@rule zig "@as(u64, $val)" => "($val)"
@rule zig "@as(usize, $val)" => "($val)"
@rule zig "@as(isize, $val)" => "($val)"
@rule zig "@as(f64, $val)" => "($val)"
@rule zig "@as(bool, $val)" => "($val)"
@rule zig "@intCast($val)" => "($val)"
@rule zig "@intFromBool($val)" => "($val)"
@rule zig "@boolFromInt($val)" => "($val)"
@rule zig "@bitCast($val)" => "($val)"
@rule zig "@truncate($val)" => "($val)"
@rule zig "@floatFromInt($val)" => "($val)"
@rule zig "@intFromFloat($val)" => "($val)"
@rule zig "@sizeOf($rest)" => "(8)"
@rule zig "@alignOf($rest)" => "(8)"
@rule zig "@TypeOf($rest)" => "// typeof"
