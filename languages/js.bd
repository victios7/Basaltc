@lang js
@prelude js "box __js = 1 int64"
@rule js "function main() {" => "@cpu main(): int32 ["
@rule js "function $name() {" => "@cpu $name(): int32 ["
@rule js "let $name = $val;" => "box $name = $val int64"
@rule js "const $name = $val;" => "box $name = $val int64"
@rule js "var $name = $val;" => "box $name = $val int64"
@rule js "$name += $val;" => "$name = $name + $val"
@rule js "$name -= $val;" => "$name = $name - $val"
@rule js "$name *= $val;" => "$name = $name * $val"
@rule js "$name = $val;" => "$name = $val"
@rule js "while ($cond) {" => "while $cond ["
@rule js "if ($cond) {" => "if $cond ["
@rule js "} else if ($cond) {" => "] else [ if $cond ["
@rule js "} else {" => "] else ["
@rule js "}" => "]"
@rule js "console.log($name);" => "print_int($name)\nprint_nl()"
@rule js "return $val;" => "return($val)"
@rule js "return;" => "return(0)"
@rule js "true" => "1"
@rule js "false" => "0"
