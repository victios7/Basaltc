@lang forge
@prelude forge "box __forge = 1 int64"

@rule forge "MAIN" => "@cpu main(): int32 ["
@rule forge "FN $name" => "@cpu $name(): int32 ["
@rule forge "END" => "]"
@rule forge "LET $name = $val" => "box $name = $val int64"
@rule forge "let $name = $val" => "box $name = $val int64"
@rule forge "VAR $name = $val" => "box $name = $val int64"
@rule forge "SET $name = $val" => "$name = $val"
@rule forge "set $name = $val" => "$name = $val"
@rule forge "INC $name" => "$name = $name + 1"
@rule forge "DEC $name" => "$name = $name - 1"
@rule forge "inc $name" => "$name = $name + 1"
@rule forge "dec $name" => "$name = $name - 1"
@rule forge "ADD $name $val" => "$name = $name + $val"
@rule forge "SUB $name $val" => "$name = $name - $val"
@rule forge "MUL $name $val" => "$name = $name * $val"
@rule forge "DIV $name $val" => "$name = $name / $val"
@rule forge "add $name $val" => "$name = $name + $val"
@rule forge "sub $name $val" => "$name = $name - $val"
@rule forge "mul $name $val" => "$name = $name * $val"
@rule forge "div $name $val" => "$name = $name / $val"
@rule forge "MOV $dst $src" => "$dst = $src"
@rule forge "IF $cond" => "if $cond ["
@rule forge "WHILE $cond" => "while $cond ["
@rule forge "ELSE" => "] else ["
@rule forge "RET $val" => "return($val)"
@rule forge "RET" => "return(0)"
@rule forge "PRINT $name" => "print_int($name)\nprint_nl()"
@rule forge "SAY $rest" => "print_str(\"$rest\")\nprint_nl()"
@rule forge "TRUE" => "1"
@rule forge "FALSE" => "0"
