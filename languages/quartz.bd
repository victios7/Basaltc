@lang quartz
@prelude quartz "box __quartz = 1 int64"
@rule quartz "crystal $name" => "@cpu $name(): int64 ["
@rule quartz "crystal main" => "@cpu main(): int32 ["
@rule quartz "facet" => "]"
@rule quartz "vein $name = $val" => "box $name = $val int64"
@rule quartz "cut $name = $val" => "$name = $val"
@rule quartz "polish $name" => "$name = $name + 1"
@rule quartz "etch $name $val" => "$name = $name + $val"
@rule quartz "loop $cond" => "while $cond ["
@rule quartz "if $cond" => "if $cond ["
@rule quartz "else" => "] else ["
@rule quartz "shine $name" => "print_int($name)\nprint_nl()"
@rule quartz "return $val" => "return($val)"
