@lang rust
@prelude rust "box __rust = 1 int64"

// --- attributes / uses ---
@rule rust "use std::io;" => "// io"
@rule rust "use std::io::Write;" => "// write"
@rule rust "use std::io::Read;" => "// read"
@rule rust "use std::$rest;" => "// use"
@rule rust "mod $name;" => "// mod"
@rule rust "pub mod $name;" => "// mod"
@rule rust "#![$rest]" => "// attr"
@rule rust "#[$rest]" => "// attr"
@rule rust "#![$rest]" => "// attr"

// --- ownership markers (compile-time via rust_ownership_check) ---
// move: let x = y;  →  annotate y moved
@rule rust "let $name = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let mut $name = $val;" => "box $name = $val int64"
@rule rust "let $name: i64 = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let $name: i32 = $val;" => "box $name = $val int32\n// !move $val"
@rule rust "let $name: u64 = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let $name: usize = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let $name: isize = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let $name: f64 = $val;" => "box $name = $val float64\n// !move $val"
@rule rust "let $name: f32 = $val;" => "box $name = $val float64\n// !move $val"
@rule rust "let $name: bool = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let $name: i16 = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let $name: i8 = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let $name: u32 = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let $name: u16 = $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let $name: u8 = $val;" => "box $name = $val int64\n// !move $val"

// mut: no move marker (Copy-like for scalars in this dialect)
@rule rust "let mut $name: i64 = $val;" => "box $name = $val int64"
@rule rust "let mut $name: i32 = $val;" => "box $name = $val int32"
@rule rust "let mut $name: i16 = $val;" => "box $name = $val int64"
@rule rust "let mut $name: i8 = $val;" => "box $name = $val int64"
@rule rust "let mut $name: u64 = $val;" => "box $name = $val int64"
@rule rust "let mut $name: u32 = $val;" => "box $name = $val int64"
@rule rust "let mut $name: u16 = $val;" => "box $name = $val int64"
@rule rust "let mut $name: u8 = $val;" => "box $name = $val int64"
@rule rust "let mut $name: usize = $val;" => "box $name = $val int64"
@rule rust "let mut $name: isize = $val;" => "box $name = $val int64"
@rule rust "let mut $name: f64 = $val;" => "box $name = $val float64"
@rule rust "let mut $name: f32 = $val;" => "box $name = $val float64"
@rule rust "let mut $name: bool = $val;" => "box $name = $val int64"
@rule rust "let mut $name: i64;" => "box $name = 0 int64"
@rule rust "let mut $name;" => "box $name = 0 int64"
@rule rust "let $name: i64;" => "box $name = 0 int64"

// ref / borrow (read-only alias — no move of source)
@rule rust "let $name = &$val;" => "box $name = $val int64\n// @borrow $val"
@rule rust "let $name = &mut $val;" => "box $name = $val int64"
@rule rust "let mut $name = &$val;" => "box $name = $val int64"
@rule rust "let mut $name = &mut $val;" => "box $name = $val int64"
@rule rust "let $name: &i64 = &$val;" => "box $name = $val int64\n// @borrow $val"
@rule rust "let $name: &mut i64 = &mut $val;" => "box $name = $val int64"

// explicit move!
@rule rust "let $name = move $val;" => "box $name = $val int64\n// !move $val"
@rule rust "let mut $name = move $val;" => "box $name = $val int64\n// !move $val"

// const / static
@rule rust "const $name: i64 = $val;" => "box $name = $val int64"
@rule rust "const $name: i32 = $val;" => "box $name = $val int32"
@rule rust "const $name = $val;" => "box $name = $val int64"
@rule rust "static $name: i64 = $val;" => "box $name = $val int64"
@rule rust "static mut $name: i64 = $val;" => "box $name = $val int64"

// --- functions ---
@rule rust "fn main() {" => "@cpu main(): int32 ["
@rule rust "pub fn main() {" => "@cpu main(): int32 ["
@rule rust "fn main() -> i32 {" => "@cpu main(): int32 ["
@rule rust "fn main() -> () {" => "@cpu main(): int32 ["
@rule rust "fn $name() {" => "@cpu $name(): int32 ["
@rule rust "fn $name() -> i64 {" => "@cpu $name(): int64 ["
@rule rust "fn $name() -> i32 {" => "@cpu $name(): int32 ["
@rule rust "fn $name() -> u64 {" => "@cpu $name(): int64 ["
@rule rust "fn $name() -> usize {" => "@cpu $name(): int64 ["
@rule rust "fn $name() -> isize {" => "@cpu $name(): int64 ["
@rule rust "fn $name() -> bool {" => "@cpu $name(): int64 ["
@rule rust "fn $name() -> f64 {" => "@cpu $name(): float64 ["
@rule rust "fn $name() -> () {" => "@cpu $name(): int32 ["
@rule rust "pub fn $name() {" => "@cpu $name(): int32 ["
@rule rust "pub fn $name() -> i64 {" => "@cpu $name(): int64 ["
@rule rust "pub fn $name() -> i32 {" => "@cpu $name(): int32 ["
@rule rust "pub fn $name() -> bool {" => "@cpu $name(): int64 ["
@rule rust "pub fn $name() -> () {" => "@cpu $name(): int32 ["
@rule rust "unsafe fn $name() {" => "@cpu $name(): int32 ["
@rule rust "unsafe fn $name() -> i64 {" => "@cpu $name(): int64 ["

// --- control ---
@rule rust "while $cond {" => "while $cond ["
@rule rust "while $cond{" => "while $cond ["
@rule rust "loop {" => "while 1 ["
@rule rust "for _ in 0..$val {" => "box __fi = 0 int64\nwhile __fi < $val [\n__fi = __fi + 1"
@rule rust "for $name in 0..$val {" => "box $name = 0 int64\nwhile $name < $val ["
@rule rust "for $name in 0..=$val {" => "box $name = 0 int64\nwhile $name <= $val ["
@rule rust "for _ in 0..=$val {" => "box __fi = 0 int64\nwhile __fi <= $val ["
@rule rust "if $cond {" => "if $cond ["
@rule rust "if $cond{" => "if $cond ["
@rule rust "} else if $cond {" => "] else [ if $cond ["
@rule rust "} else if $cond{" => "] else [ if $cond ["
@rule rust "} else {" => "] else ["
@rule rust "} else{" => "] else ["
@rule rust "}" => "]"
@rule rust "match $name {" => "if 1 ["
@rule rust "=>" => "// arm"

// --- ops ---
@rule rust "$name += $val;" => "$name = $name + $val"
@rule rust "$name -= $val;" => "$name = $name - $val"
@rule rust "$name *= $val;" => "$name = $name * $val"
@rule rust "$name /= $val;" => "$name = $name / $val"
@rule rust "$name %= $val;" => "$name = $name - ($name / $val) * $val"
@rule rust "$name = $val;" => "$name = $val"
@rule rust "$name += 1;" => "$name = $name + 1"
@rule rust "$name -= 1;" => "$name = $name - 1"
@rule rust "true" => "1"
@rule rust "false" => "0"
@rule rust " && " => " * "
@rule rust " || " => " + "
@rule rust "!" => "0 - "

// --- I/O ---
@rule rust "println!($name);" => "print_int($name)\nprint_nl()"
@rule rust "print!($name);" => "print_int($name)"
@rule rust "println!(\"{}\", $name);" => "print_int($name)\nprint_nl()"
@rule rust "println!(\"{:?}\", $name);" => "print_int($name)\nprint_nl()"
@rule rust "print!(\"{}\", $name);" => "print_int($name)"
@rule rust "eprintln!($name);" => "print_int($name)\nprint_nl()"
@rule rust "dbg!($name);" => "print_int($name)\nprint_nl()"

// --- return / flow ---
@rule rust "return $val;" => "return($val)"
@rule rust "return;" => "return(0)"
@rule rust "break;" => "// break"
@rule rust "continue;" => "// continue"
@rule rust "drop($name);" => "// drop $name\n// !move $name"

// --- methods / casts ---
@rule rust "$name.wrapping_add($val)" => "($name + $val)"
@rule rust "$name.wrapping_mul($val)" => "($name * $val)"
@rule rust "$name.wrapping_sub($val)" => "($name - $val)"
@rule rust "$name.saturating_add($val)" => "($name + $val)"
@rule rust "$name.saturating_sub($val)" => "($name - $val)"
@rule rust "$name as i64" => "($name)"
@rule rust "$name as i32" => "($name)"
@rule rust "$name as i16" => "($name)"
@rule rust "$name as i8" => "($name)"
@rule rust "$name as u64" => "($name)"
@rule rust "$name as u32" => "($name)"
@rule rust "$name as usize" => "($name)"
@rule rust "$name as isize" => "($name)"
@rule rust "$name as f64" => "($name)"
@rule rust "$name.clone()" => "($name)"
@rule rust "$name.copy()" => "($name)"
