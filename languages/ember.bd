@lang ember
@prelude ember "box __ember = 1 int64"
@rule ember "spark $name" => "@cpu $name(): int32 ["
@rule ember "spark main" => "@cpu main(): int32 ["
@rule ember "ash" => "]"
@rule ember "coal $name = $val" => "box $name = $val int64"
@rule ember "stoke $name $val" => "$name = $name + $val"
@rule ember "douse $name $val" => "$name = $name - $val"
@rule ember "burn $name $val" => "$name = $name * $val"
@rule ember "while $cond" => "while $cond ["
@rule ember "when $cond" => "if $cond ["
@rule ember "else" => "] else ["
@rule ember "glow $name" => "print_int($name)\nprint_nl()"
@rule ember "ember $val" => "return($val)"
@rule ember "yes" => "1"
@rule ember "no" => "0"
