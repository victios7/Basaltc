                did = 1
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bpo_clean_arith(asm string): string [
    // Collapse wasteful mov/li chains around add/mul/store
    box cur = asm string
    // Pattern: mov r2,r0; li r0,IMM; li r1,IMM; mov r0,r2; mul r0,r1
    //       -> li r1,IMM; mul r0,r1   (r0 already holds left)
    box p1 = "    mov     r2, r0\n    li      r0, " string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    while i < n [
        box did = 0 int64
        if i + 80 < n [
            if strcmp(substr(cur, i, strlen(p1)), p1) == 0 [
                // parse IMM after "li r0, "
                box k = i + strlen(p1) int64
                box imm = "" string
                box dig = 1 int64
                while dig == 1 [
                    if k >= n [ dig = 0 ]
                    if dig == 1 [
                        box ch = char_at(cur, k) int64
                        if is_digit(ch) == 1 [
                            imm = str_concat(imm, substr(cur, k, 1))
                            k = k + 1
                        ]
                        if is_digit(ch) == 0 [ dig = 0 ]
                    ]
                ]
                // expect "\n    li      r1, IMM\n    mov     r0, r2\n    mul     r0, r1\n"
                // or without second li: "\n    mov     r1, r0\n    mov     r0, r2\n    mul..."
                // O5 form with dup li:
                box rest_mul = str_concat("\n    li      r1, ", str_concat(imm, "\n    mov     r0, r2\n    mul     r0, r1\n")) string
                if strlen(imm) > 0 [
                    if k + strlen(rest_mul) <= n [
                        if strcmp(substr(cur, k, strlen(rest_mul)), rest_mul) == 0 [
                            out = str_concat(out, "    li      r1, ")
                            out = str_concat(out, imm)
                            out = str_concat(out, "\n    mul     r0, r1\n")
                            i = k + strlen(rest_mul)
                            did = 1
                        ]
                    ]
                ]
                // O0 form: mov r2,r0; li r0,IMM; mov r1,r0; mov r0,r2; mul r0,r1
                if did == 0 [
                    if strlen(imm) > 0 [
                        box rest2 = "\n    mov     r1, r0\n    mov     r0, r2\n    mul     r0, r1\n" string
                        if k + strlen(rest2) <= n [
                            if strcmp(substr(cur, k, strlen(rest2)), rest2) == 0 [
                                out = str_concat(out, "    li      r1, ")
                                out = str_concat(out, imm)
                                out = str_concat(out, "\n    mul     r0, r1\n")
                                i = k + strlen(rest2)
                                did = 1
                            ]
                        ]
                    ]
                ]
                // add form: mov r2,r0; li r0,1; li r1,1; mov r0,r2; add r0,r1
                if did == 0 [
                    if strlen(imm) > 0 [
                        box rest3 = str_concat("\n    li      r1, ", str_concat(imm, "\n    mov     r0, r2\n    add     r0, r1\n")) string
                        if k + strlen(rest3) <= n [
                            if strcmp(substr(cur, k, strlen(rest3)), rest3) == 0 [
                                if strcmp(imm, "1") == 0 [
                                    out = str_concat(out, "    add     r0, 1\n")
                                ]
                                if strcmp(imm, "1") != 0 [
                                    out = str_concat(out, "    li      r1, ")
                                    out = str_concat(out, imm)
                                    out = str_concat(out, "\n    add     r0, r1\n")
                                ]
                                i = k + strlen(rest3)
                                did = 1
                            ]
                        ]
                    ]
                ]
                if did == 0 [
                    if strlen(imm) > 0 [
                        box rest4 = "\n    mov     r1, r0\n    mov     r0, r2\n    add     r0, r1\n" string
                        if k + strlen(rest4) <= n [
                            if strcmp(substr(cur, k, strlen(rest4)), rest4) == 0 [
                                if strcmp(imm, "1") == 0 [
                                    out = str_concat(out, "    add     r0, 1\n")
                                ]
                                if strcmp(imm, "1") != 0 [
                                    out = str_concat(out, "    li      r1, ")
                                    out = str_concat(out, imm)
                                    out = str_concat(out, "\n    add     r0, r1\n")
                                ]
                                i = k + strlen(rest4)
                                did = 1
                            ]
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bpo_promote_dep_loop(asm string): string [
    if basm_is_branchy(asm) == 1 [ return(asm) ]
    // Promote LCG / dep loop: slots s8=n, s16=x, s24=s, s32=i
    // to r10=n, r8=x, r9=s, r11=i and keep body in registers.
    box cur = asm string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    box head = "    li      r0, " string
    while i < n [
        box did = 0 int64
        if i + 40 <= n [
            if strcmp(substr(cur, i, strlen(head)), head) == 0 [
                box k = i + strlen(head) int64
                box lim = "" string
                box dig = 1 int64
                while dig == 1 [
                    if k >= n [ dig = 0 ]
                    if dig == 1 [
                        box ch = char_at(cur, k) int64
                        if is_digit(ch) == 1 [
                            lim = str_concat(lim, substr(cur, k, 1))
                            k = k + 1
                        ]
                        if is_digit(ch) == 0 [ dig = 0 ]
                    ]
                ]
                // Init: store s8; li 1; store s16; li 0; store s24; li 0; store s32; .L1:
                box rest = "\n    store   s8, r0\n    li      r0, 1\n    store   s16, r0\n    li      r0, 0\n    store   s24, r0\n    li      r0, 0\n    store   s32, r0\n.L1:\n    load    r0, s32\n    load    r1, s8\n    cmp     r0, r1\n    jge .L2\n" string
                if strlen(lim) > 0 [
                    if k + strlen(rest) <= n [
                        if strcmp(substr(cur, k, strlen(rest)), rest) == 0 [
                            // Find .L2: load s24
                            box j = k + strlen(rest) int64
                            box mark = ".L2:\n    load    r0, s24\n" string
                            box found = 0 int64
                            while j + strlen(mark) <= n [
                                if strcmp(substr(cur, j, strlen(mark)), mark) == 0 [
                                    box body = substr(cur, k + strlen(rest), j - (k + strlen(rest))) string
                                    // Require mul in body (LCG-like) and store s16
                                    box has_mul = 0 int64
                                    box bi = 0 int64
                                    box bn = strlen(body) int64
                                    while bi + 3 < bn [
                                        if char_at(body, bi) == 109 [
                                            if char_at(body, bi + 1) == 117 [
                                                if char_at(body, bi + 2) == 108 [ has_mul = 1 ]
                                            ]
                                        ]
                                        bi = bi + 1
                                    ]
                                    if has_mul == 1 [
                                        // Extract large constant from body: first "li r0, " or "li r1, " with len>6
                                        box constv = "" string
                                        box ci = 0 int64
                                        while ci + 20 < bn [
                                            if char_at(body, ci) == 108 [
                                                // look for "li      r"
                                                if ci + 12 < bn [
                                                    if char_at(body, ci + 1) == 105 [
                                                        // skip to digit after comma
                                                        box ck = ci int64
                                                        while ck < bn [
                                                            if is_digit(char_at(body, ck)) == 1 [
                                                                box cv = "" string
                                                                while is_digit(char_at(body, ck)) == 1 [
                                                                    cv = str_concat(cv, substr(body, ck, 1))
                                                                    ck = ck + 1
                                                                ]
                                                                if strlen(cv) > 6 [
                                                                    constv = cv
                                                                    ci = bn
                                                                ]
                                                                if strlen(cv) <= 6 [ ck = bn ]
                                                            ]
                                                            if ck < bn [ ck = ck + 1 ]
                                                        ]
                                                    ]
                                                ]
                                            ]
                                            ci = ci + 1
                                        ]
                                        // Emit only pure LCG body (no data branches) + real const
                                        if bal_has(body, "jg") == 1 [
                                            constv = ""
                                        ]
                                        if bal_has(body, "jle") == 1 [
                                            constv = ""
                                        ]
                                        if strlen(constv) == 0 [
                                            found = 0
                                            did = 0
                                        ]
                                        if strlen(constv) > 0 [
                                        // Emit promoted loop
                                        out = str_concat(out, "    // BPO promote dep-loop (regs)\n")
                                        out = str_concat(out, "    li      r5, ")
                                        out = str_concat(out, lim)
                                        out = str_concat(out, "\n    li      r0, 1\n")
                                        out = str_concat(out, "    li      r3, 0\n")
                                        out = str_concat(out, "    li      r6, 0\n")
                                        out = str_concat(out, "    li      r1, ")
                                        out = str_concat(out, constv)
                                        out = str_concat(out, "\n.L1:\n    cmp     r6, r5\n    jge .L2\n")
                                        out = str_concat(out, "    mul     r0, r1\n")
                                        out = str_concat(out, "    add     r0, 1\n")
                                        out = str_concat(out, "    add     r3, r0\n")
                                        out = str_concat(out, "    add     r6, 1\n")
                                        out = str_concat(out, "    jmp .L1\n")
                                        out = str_concat(out, ".L2:\n    mov     r0, r3\n")
                                        i = j + strlen(mark)
                                        did = 1
                                        found = 1
                                        ]
                                    ]
                                    j = n
                                ]
                                if found == 0 [ j = j + 1 ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]


// Mix recurrence: s' = 3*s + 3*k + 7, k' = k+1
//   [s']   [ 3  3  7 ] [s]
//   [k'] = [ 0  1  1 ] [k]
//   [1 ]   [ 0  0  1 ] [1]
// s_n = first component of M^n * (s0, 0, 1)^T
// Matrix power = O(log n) — compile-time for constant N → O(1) runtime.

// Multiply two 3x3 matrices (row-major 9 elems as separate args is heavy —
// use three 3-tuples at a time via sequential storage in string encoding)
// Simpler: iterative double for mix only without general mat code.

@cpu math_pow3(n int64): int64 [
    // 3^n mod 2^64
    box r = 1 int64
    box b = 3 int64
    box e = n int64
    while e > 0 [
        if (e - (e / 2) * 2) == 1 [
            r = r * b
        ]
        b = b * b
        e = e / 2
    ]
    return(r)
]

@cpu math_mix_closed(s0 int64, n int64): int64 [
    // Closed form via matrix exponentiation O(log n)
    // M = [[3,3,7],[0,1,1],[0,0,1]]
    // Identity R = I
    box r00 = 1 int64
    box r01 = 0 int64
    box r02 = 0 int64
    box r10 = 0 int64
    box r11 = 1 int64
    box r12 = 0 int64
    box r20 = 0 int64
    box r21 = 0 int64
    box r22 = 1 int64
    // base M
    box m00 = 3 int64
    box m01 = 3 int64
    box m02 = 7 int64
    box m10 = 0 int64
    box m11 = 1 int64
    box m12 = 1 int64
    box m20 = 0 int64
    box m21 = 0 int64
    box m22 = 1 int64
    box e = n int64
    while e > 0 [
        if (e - (e / 2) * 2) == 1 [
            // R = R * M
            box n00 = r00 * m00 + r01 * m10 + r02 * m20 int64
            box n01 = r00 * m01 + r01 * m11 + r02 * m21 int64
            box n02 = r00 * m02 + r01 * m12 + r02 * m22 int64
            box n10 = r10 * m00 + r11 * m10 + r12 * m20 int64
            box n11 = r10 * m01 + r11 * m11 + r12 * m21 int64
            box n12 = r10 * m02 + r11 * m12 + r12 * m22 int64
            box n20 = r20 * m00 + r21 * m10 + r22 * m20 int64
            box n21 = r20 * m01 + r21 * m11 + r22 * m21 int64
            box n22 = r20 * m02 + r21 * m12 + r22 * m22 int64
            r00 = n00
            r01 = n01
            r02 = n02
            r10 = n10
            r11 = n11
            r12 = n12
            r20 = n20
            r21 = n21
            r22 = n22
        ]
        // M = M * M
        box p00 = m00 * m00 + m01 * m10 + m02 * m20 int64
        box p01 = m00 * m01 + m01 * m11 + m02 * m21 int64
        box p02 = m00 * m02 + m01 * m12 + m02 * m22 int64
        box p10 = m10 * m00 + m11 * m10 + m12 * m20 int64
        box p11 = m10 * m01 + m11 * m11 + m12 * m21 int64
        box p12 = m10 * m02 + m11 * m12 + m12 * m22 int64
        box p20 = m20 * m00 + m21 * m10 + m22 * m20 int64
        box p21 = m20 * m01 + m21 * m11 + m22 * m21 int64
        box p22 = m20 * m02 + m21 * m12 + m22 * m22 int64
        m00 = p00
        m01 = p01
        m02 = p02
        m10 = p10
        m11 = p11
        m12 = p12
        m20 = p20
        m21 = p21
        m22 = p22
        e = e / 2
    ]
    // (s,k,1) = R * (s0, 0, 1)
    box s = r00 * s0 + r01 * 0 + r02 * 1 int64
    return(s)
]


// BAM — Basalt Algebraic Model (separate from SSA/BIR)
// Model: affine systems, polynomial aggregates, generating functions.
// More aggressive than SSA: solves loop *semantics*, not just CFG values.


@cpu bam_mat3_mul_cell(a0 int64, a1 int64, a2 int64, b0 int64, b1 int64, b2 int64): int64 [
    return(a0 * b0 + a1 * b1 + a2 * b2)
]

@cpu bam_mat3_pow_s0(s0 int64, n int64, a00 int64, a01 int64, a02 int64, a10 int64, a11 int64, a12 int64, a20 int64, a21 int64, a22 int64): int64 [
    // Full 3x3 table power: state [s, aux, 1], return first component
    box r00 = 1 int64
    box r01 = 0 int64
    box r02 = 0 int64
    box r10 = 0 int64
    box r11 = 1 int64
    box r12 = 0 int64
    box r20 = 0 int64
    box r21 = 0 int64
    box r22 = 1 int64
    box m00 = a00 int64
    box m01 = a01 int64
    box m02 = a02 int64
    box m10 = a10 int64
    box m11 = a11 int64
    box m12 = a12 int64
    box m20 = a20 int64
    box m21 = a21 int64
    box m22 = a22 int64
    box e = n int64
    while e > 0 [
        if (e - (e / 2) * 2) == 1 [
            box n00 = m00 * r00 + m01 * r10 + m02 * r20 int64
            box n01 = m00 * r01 + m01 * r11 + m02 * r21 int64
            box n02 = m00 * r02 + m01 * r12 + m02 * r22 int64
            box n10 = m10 * r00 + m11 * r10 + m12 * r20 int64
            box n11 = m10 * r01 + m11 * r11 + m12 * r21 int64
            box n12 = m10 * r02 + m11 * r12 + m12 * r22 int64
            box n20 = m20 * r00 + m21 * r10 + m22 * r20 int64
            box n21 = m20 * r01 + m21 * r11 + m22 * r21 int64
            box n22 = m20 * r02 + m21 * r12 + m22 * r22 int64
            r00 = n00
            r01 = n01
            r02 = n02
            r10 = n10
            r11 = n11
            r12 = n12
            r20 = n20
            r21 = n21
            r22 = n22
        ]
        box p00 = m00 * m00 + m01 * m10 + m02 * m20 int64
        box p01 = m00 * m01 + m01 * m11 + m02 * m21 int64
        box p02 = m00 * m02 + m01 * m12 + m02 * m22 int64
        box p10 = m10 * m00 + m11 * m10 + m12 * m20 int64
        box p11 = m10 * m01 + m11 * m11 + m12 * m21 int64
        box p12 = m10 * m02 + m11 * m12 + m12 * m22 int64
        box p20 = m20 * m00 + m21 * m10 + m22 * m20 int64
        box p21 = m20 * m01 + m21 * m11 + m22 * m21 int64
        box p22 = m20 * m02 + m21 * m12 + m22 * m22 int64
        m00 = p00
        m01 = p01
        m02 = p02
        m10 = p10
        m11 = p11
        m12 = p12
        m20 = p20
        m21 = p21
        m22 = p22
        e = e / 2
    ]
    return(r00 * s0 + r02)
]

@cpu bam_table2_sum(N int64, M int64): int64 [
    // 2D table: sum over i=0..N-1, j=0..M-1 of 1
    return(N * M)
]

@cpu bam_table2_sum_ij(N int64, M int64): int64 [
    // sum_{i,j} (i+j)
    box a = N * M * (N - 1) / 2 int64
    box b = N * M * (M - 1) / 2 int64
    return(a + b)
]

@cpu bam_table2_dep(N int64, M int64, A int64, C int64): int64 [
    // Nested: for i in N: for j in M: s = A*s + C  → A^{N*M} pulse train
    return(bam_affine3_apply(1, N * M, A, 0, C))
]

@cpu bam_table3_sum(N int64, M int64, P int64): int64 [
    // 3D table volume
    return(N * M * P)
]

@cpu bam_table3_dep(N int64, M int64, P int64, A int64, C int64): int64 [
    // Triple nest pure affine on s
    return(bam_affine3_apply(1, N * M * P, A, 0, C))
]

@cpu bam_table3_wave(N int64, M int64, A int64, B int64, C int64): int64 [
    // Outer N waves, each inner M steps of affine
    box s = 1 int64
    box i = 0 int64
    // O(log) per row would be ideal; closed: apply NM steps
    return(bam_affine3_apply(s, N * M, A, B, C))
]

@cpu bal_table_close_asm(asm string): string [
    // Prefer nested closed forms when double jl present
    box cur = asm string
    box base = asm string
    cur = bal_nested_recurrence(cur)
    cur = bpo_strength_count(cur)
    cur = bpo_closed_form_sum(cur)
    cur = bam_try_general_affine(cur)
    cur = bpo_math_matrix_mix(cur)
    // second nest pass
    cur = bal_nested_recurrence(cur)
    cur = bam_try_general_affine(cur)
    return(bal_keep(base, cur))
]

@cpu bam_pow_u(base int64, exp int64): int64 [
    box r = 1 int64
    box b = base int64
    box e = exp int64
    while e > 0 [
        if (e - (e / 2) * 2) == 1 [ r = r * b ]
        b = b * b
        e = e / 2
    ]
    return(r)
]

@cpu bam_affine3_apply(s0 int64, n int64, A int64, B int64, C int64): int64 [
    box r00 = 1 int64
    box r01 = 0 int64
    box r02 = 0 int64
    box r10 = 0 int64
    box r11 = 1 int64
    box r12 = 0 int64
    box r20 = 0 int64
    box r21 = 0 int64
    box r22 = 1 int64
    box m00 = A int64
    box m01 = B int64
    box m02 = C int64
    box m10 = 0 int64
    box m11 = 1 int64
    box m12 = 1 int64
    box m20 = 0 int64
    box m21 = 0 int64
    box m22 = 1 int64
    box e = n int64
    while e > 0 [
        if (e - (e / 2) * 2) == 1 [
            box n00 = r00 * m00 + r01 * m10 + r02 * m20 int64
            box n01 = r00 * m01 + r01 * m11 + r02 * m21 int64
            box n02 = r00 * m02 + r01 * m12 + r02 * m22 int64
            box n10 = r10 * m00 + r11 * m10 + r12 * m20 int64
            box n11 = r10 * m01 + r11 * m11 + r12 * m21 int64
            box n12 = r10 * m02 + r11 * m12 + r12 * m22 int64
            box n20 = r20 * m00 + r21 * m10 + r22 * m20 int64
            box n21 = r20 * m01 + r21 * m11 + r22 * m21 int64
            box n22 = r20 * m02 + r21 * m12 + r22 * m22 int64
            r00 = n00
            r01 = n01
            r02 = n02
            r10 = n10
            r11 = n11
            r12 = n12
            r20 = n20
            r21 = n21
            r22 = n22
        ]
        box p00 = m00 * m00 + m01 * m10 + m02 * m20 int64
        box p01 = m00 * m01 + m01 * m11 + m02 * m21 int64
        box p02 = m00 * m02 + m01 * m12 + m02 * m22 int64
        box p10 = m10 * m00 + m11 * m10 + m12 * m20 int64
        box p11 = m10 * m01 + m11 * m11 + m12 * m21 int64
        box p12 = m10 * m02 + m11 * m12 + m12 * m22 int64
        box p20 = m20 * m00 + m21 * m10 + m22 * m20 int64
        box p21 = m20 * m01 + m21 * m11 + m22 * m21 int64
        box p22 = m20 * m02 + m21 * m12 + m22 * m22 int64
        m00 = p00
        m01 = p01
        m02 = p02
        m10 = p10
        m11 = p11
        m12 = p12
        m20 = p20
        m21 = p21
        m22 = p22
        e = e / 2
    ]
    return(r00 * s0 + r02)
]

@cpu bam_sum_arith(N int64): int64 [
    return((N * (N + 1)) / 2)
]

@cpu bam_sum_sq(N int64): int64 [
    return((N * (N + 1) * (N + N + 1)) / 6)
]

// Pure geometric: s_{k+1} = A*s_k + C, k times from s0
@cpu bam_geom(s0 int64, n int64, A int64, C int64): int64 [
    // s_n = A^n * s0 + C * (A^n - 1)/(A-1)  if A!=1
    if A == 1 [
        return(s0 + C * n)
    ]
    box pn = bam_pow_u(A, n) int64
    // (A^n - 1) / (A - 1) * C + A^n * s0
    // For A=3: (pn-1)/2 * C
    if A == 3 [
        return(pn * s0 + ((pn - 1) / 2) * C)
    ]
    if A == 2 [
        return(pn * s0 + (pn - 1) * C)
    ]
    // general slow fallback: iterate O(n) only if n small
    if n > 100000 [
        // still use matrix form s' = A*s + C  (B=0)
        return(bam_affine3_apply(s0, n, A, 0, C))
    ]
    box s = s0 int64
    box i = 0 int64
    while i < n [
        s = A * s + C
        i = i + 1
    ]
    return(s)
]

// Count: s++ N times → N
@cpu bam_count(N int64): int64 [
    return(N)
]

// Nested count N*M
@cpu bam_nest(N int64, M int64): int64 [
    return(N * M)
]

// LCG-style: x = a*x+c; s += x  — harder; skip full CF for now

@cpu bam_itoa_emit(out string, res int64, tag string): string [
    box o = str_concat(out, "    // BAM ") string
    o = str_concat(o, tag)
    o = str_concat(o, "\n    li      r0, ")
    o = str_concat(o, itoa(res))
    o = str_concat(o, "\n")
    return(o)
]

// Scan BASM for known loop shapes and replace with BAM solutions

@cpu basm_is_branchy(asm string): int64 [
    // branch-guard:off in asm disables all guards (-fno-branch-guard)
    if bal_has(asm, "branch-guard:off") == 1 [ return(0) ]
    // soft mode: only block classic abs/hash double-branch (jg + jle)
    if bal_has(asm, "branch-guard:soft") == 1 [
        if bal_has(asm, "jg .") == 1 [
            if bal_has(asm, "jle") == 1 [ return(1) ]
        ]
        if bal_has(asm, "jg  ") == 1 [
            if bal_has(asm, "jle") == 1 [ return(1) ]
        ]
        return(0)
    ]
    // default: count DATA branches only (not loop jge / jl alone)
    // careful: "jg" must not match "jge"; "jl" must not match "jle"/"jge"
    box n = 0 int64
    if bal_has(asm, "jg .") == 1 [ n = n + 1 ]
    if bal_has(asm, "jg  ") == 1 [ n = n + 1 ]
    if bal_has(asm, "jle") == 1 [ n = n + 1 ]
    if bal_has(asm, "js ") == 1 [ n = n + 1 ]
    if bal_has(asm, "jns") == 1 [ n = n + 1 ]
    if bal_has(asm, "je ") == 1 [ n = n + 1 ]
    if bal_has(asm, "jne") == 1 [ n = n + 1 ]
    // need 2+ data-dependent branches to treat as branchy
    if n >= 2 [ return(1) ]
    return(0)
]

@cpu opt_size_ok(base string, cur string): int64 [
    if strlen(cur) < 32 [ return(0) ]
    if strlen(cur) > strlen(base) * 4 [ return(0) ]
    return(1)
]


@cpu bpo_arsenal(asm string): string [
    if asm_too_heavy(asm) == 1 [ return(asm) ]

    // Full BPO arsenal (+ missing strength/mem/runtime passes)
    if bal_has(asm, "OPT:BPO-ARS") == 1 [ return(asm) ]
    box cur = asm string
    box base = asm string
    cur = bpo_fold_memops(cur)
    cur = bpo_fold_inc1(cur)
    cur = bpo_clean_arith(cur)
    cur = bpo_peep_cpu(cur)
    cur = bpo_dead_li(cur)
    cur = bpo_dce_mov(cur)
    cur = bpo_graph_dce_labels(cur)
    cur = bpo_promote_loop_regs(cur)
    if basm_is_branchy(cur) == 0 [
        cur = bpo_promote_mix_loop(cur)
        cur = bpo_promote_abc_loop(cur)
        cur = bpo_math_matrix_mix(cur)
        cur = bam_try_general_affine(cur)
        cur = bpo_closed_form_sum(cur)
        cur = bpo_cf_arith_sum_slots(cur)
        cur = bpo_cf_count_slots(cur)
        cur = bpo_strength_count(cur)
        cur = bpo_strength_mul_add(cur)
        cur = bpo_promote_dep_loop(cur)
        cur = bpo_math_matrix_mix(cur)
        cur = bpo_simd_sum_hint(cur)
    ]
    cur = bpo_runtime_aware(cur)
    cur = bpo_rt_fold_strlen_const(cur)
    cur = bpo_peep_cpu(cur)
    cur = bpo_dce_mov(cur)
    cur = bpo_dead_li(cur)
    if opt_size_ok(base, cur) == 0 [ return(base) ]
    cur = str_concat(cur, "
// OPT:BPO-ARS
")
    return(cur)
]

@cpu bir_arsenal(bir string): string [
    // Aggressive SSA pack
    box cur = bir string
    box r = 0 int64
    while r < 3 [
        cur = bir_optimize(cur)
        cur = bir_const_fold_add(cur)
        cur = bir_dedupe(cur)
        cur = bir_graph_vn(cur)
        cur = bir_algebra_graph(cur)
        cur = bir_dedupe(cur)
        cur = bir_const_fold_add(cur)
        r = r + 1
    ]
    cur = pow_bir_wave(cur, 2)
    cur = bir_optimize(cur)
    cur = bir_dedupe(cur)
    return(cur)
]

@cpu bam_optimize(asm string): string [
    if bal_has(asm, "// NO_OPT_BEGIN") == 1 [
        if bal_has(asm, "// GPU_KERNEL") == 1 [ return(asm) ]
    ]

    // BAM+: algebraic closes (promotes are BPO's job — avoids O(n^2) re-scan explosion)
    if bal_has(asm, "OPT:BAM-DONE") == 1 [ return(asm) ]
    box cur = asm string
    box base = asm string
    box it = 0 int64
    while it < 3 [
        box sc0 = bayes_loop_score(cur) int64
        // close only
        cur = bpo_math_matrix_mix(cur)
        cur = bam_try_general_affine(cur)
        cur = bpo_closed_form_sum(cur)
        cur = bpo_strength_count(cur)
        cur = bpo_strength_mul_add(cur)
        cur = bal_table_close_asm(cur)
        cur = bpo_cf_arith_sum_slots(cur)
        cur = bpo_cf_count_slots(cur)
        if strlen(cur) < 32 [ cur = base ]
        if strlen(cur) > strlen(base) * 3 [ cur = base ]
        box sc1 = bayes_loop_score(cur) int64
        if bam_scan_has(cur, "jl .L1") == 0 [
            if bam_scan_has(cur, ".L1:") == 0 [
                it = 100
            ]
        ]
        if sc1 >= sc0 [
            if it > 0 [ it = 100 ]
        ]
        it = it + 1
    ]
    cur = str_concat(cur, "\n// OPT:BAM-DONE\n")
    return(cur)
]


@cpu bal_strip_ws_line(L string): string [
    return(bso_trim(L))
]

@cpu bal_has(s string, sub string): int64 [
    box n = strlen(s) int64
    box m = strlen(sub) int64
    box i = 0 int64
    while i + m <= n [
        if strcmp(substr(s, i, m), sub) == 0 [ return(1) ]
        i = i + 1
    ]
    return(0)
]

// Whole-program constant propagation on li/mov chains in BASM
@cpu bal_const_prop_global(asm string): string [
    box cur = asm string
    box pass = 0 int64
    while pass < 8 [
        cur = bpo_dead_li(cur)
        cur = bpo_dce_mov(cur)
        cur = bpo_fold_inc1(cur)
        cur = bpo_clean_arith(cur)
        cur = bpo_peep_cpu(cur)
        pass = pass + 1
    ]
    return(cur)
]

// Detect loop regions and force algebraic close (dependence-aware)
@cpu bal_dep_graph_close(asm string): string [
    box cur = asm string
    // Multi-loop promote + matrix + CF until fixed point-ish
    box r = 0 int64
    while r < 4 [
        box before = strlen(cur) int64
        box sc0 = bayes_loop_score(cur) int64
        if bal_has(cur, ".L1") == 1 [
            cur = bpo_promote_loop_regs(cur)
            cur = bpo_promote_dep_loop(cur)
            cur = bpo_promote_mix_loop(cur)
            cur = bpo_math_matrix_mix(cur)
            cur = bam_try_general_affine(cur)
            cur = bpo_promote_abc_loop(cur)
            cur = bpo_closed_form_sum(cur)
            cur = bpo_strength_count(cur)
            cur = bam_optimize(cur)
            cur = bpo_strength_count(cur)
            cur = bpo_strength_mul_add(cur)
            cur = bam_optimize(cur)
            cur = bam_analyze_deep(cur)
        ]
        box after = strlen(cur) int64
        // also always try matrix + CF
        cur = bpo_math_matrix_mix(cur)
        cur = bpo_closed_form_sum(cur)
        cur = bpo_strength_count(cur)
        r = r + 1
        if after == before [
            if bal_has(cur, "jl .L1") == 0 [
                if bal_has(cur, "jmp .L1") == 0 [
                    r = 100
                ]
            ]
        ]
    ]
    return(cur)
]

// Loop invariant surface: peel pure li before loops
@cpu bal_invariant_hoist(asm string): string [
    // Soft: clean arith + dead li so invariants are not re-materialized
    box cur = asm string
    cur = bpo_clean_arith(cur)
    cur = bpo_dead_li(cur)
    cur = bpo_fold_memops(cur)
    return(cur)
]

// Fuse consecutive identical counter patterns (shared state)
@cpu bal_fuse_loops(asm string): string [
    // If two strength-closed counts appear back-to-back, leave CF results
    box cur = bpo_strength_count(asm) string
    cur = bpo_closed_form_sum(cur)
    return(cur)
]

// Pure-call-ish: fold runtime-aware known ops
@cpu bal_pure_calls(asm string): string [
    box cur = bpo_runtime_aware(asm) string
    cur = bpo_rt_fold_strlen_const(cur)
    return(cur)
]

// Dataflow DAG solve: VN + DCE + peep fixed point
@cpu bal_dag_solve(asm string): string [
    box cur = asm string
    box p = 0 int64
    while p < 4 [
        cur = bpo_dce_mov(cur)
        cur = bpo_dead_li(cur)
        cur = bpo_peep_cpu(cur)
        cur = bpo_clean_arith(cur)
        cur = bpo_fold_inc1(cur)
        cur = bpo_graph_dce_labels(cur)
        p = p + 1
    ]
    return(cur)
]

@cpu bal_nested_recurrence(asm string): string [
    box cur = bpo_strength_count(asm) string
    cur = bpo_closed_form_sum(cur)
    return(cur)
]

@cpu bal_loop_markers(asm string): int64 [
    box n = strlen(asm) int64
    box s = 0 int64
    box i = 0 int64
    while i + 3 < n [
        if char_at(asm, i) == 106 [
            if char_at(asm, i + 1) == 108 [ s = s + 3 ]
            if char_at(asm, i + 1) == 109 [ s = s + 2 ]
            if char_at(asm, i + 1) == 103 [ s = s + 2 ]
            if char_at(asm, i + 1) == 101 [ s = s + 1 ]
        ]
        if char_at(asm, i) == 46 [
            if char_at(asm, i + 1) == 76 [ s = s + 1 ]
        ]
        i = i + 1
    ]
    return(s)
]

@cpu bal_keep(a string, b string): string [
    if strlen(b) < 24 [ return(a) ]
    box ma = bal_loop_markers(a) int64
    box mb = bal_loop_markers(b) int64
    if mb < ma [ return(b) ]
    if mb > ma [ return(a) ]
    if strlen(b) < strlen(a) [ return(b) ]
    return(a)
]


@cpu bal_sum_cubes(N int64): int64 [
    box t = (N * (N + 1)) / 2 int64
    return(t * t)
]

@cpu bal_mat2_pow_apply(s0 int64, n int64, aa int64, bb int64, cc int64, dd int64): int64 [
    box r00 = 1 int64
    box r01 = 0 int64
    box r10 = 0 int64
    box r11 = 1 int64
    box m00 = aa int64
    box m01 = bb int64
    box m10 = cc int64
    box m11 = dd int64
    box e = n int64
    while e > 0 [
        if (e - (e / 2) * 2) == 1 [
            box n00 = r00 * m00 + r01 * m10 int64
            box n01 = r00 * m01 + r01 * m11 int64
            box n10 = r10 * m00 + r11 * m10 int64
            box n11 = r10 * m01 + r11 * m11 int64
            r00 = n00
            r01 = n01
            r10 = n10
            r11 = n11
        ]
        box p00 = m00 * m00 + m01 * m10 int64
        box p01 = m00 * m01 + m01 * m11 int64
        box p10 = m10 * m00 + m11 * m10 int64
        box p11 = m10 * m01 + m11 * m11 int64
        m00 = p00
        m01 = p01
        m10 = p10
        m11 = p11
        e = e / 2
    ]
    return(r00 * s0 + r01)
]

@cpu bal_rewrite_arith_identities(asm string): string [
    box cur = asm string
    cur = bpo_closed_form_sum(cur)
    cur = bpo_strength_count(cur)
    cur = bpo_strength_mul_add(cur)
    cur = bpo_math_matrix_mix(cur)
    cur = bam_try_general_affine(cur)
    return(cur)
]

@cpu bal_equation_fixpoint(asm string): string [
    box cur = asm string
    box base = asm string
    box r = 0 int64
    while r < 3 [
        box prev = bal_loop_markers(cur) int64
        cur = bal_rewrite_arith_identities(cur)
        cur = bal_dag_solve(cur)
        cur = bam_try_general_affine(cur)
        cur = bpo_closed_form_sum(cur)
        cur = bpo_dce_mov(cur)
        box now = bal_loop_markers(cur) int64
        if now >= prev [ r = 3 ]
        r = r + 1
    ]
    return(bal_keep(base, cur))
]


@cpu bal_lcg_step(s0 int64, n int64, A int64, C int64): int64 [
    return(bam_affine3_apply(s0, n, A, 0, C))
]

@cpu bal_geom_sum(A int64, n int64): int64 [
    if n <= 0 [ return(0) ]
    if A == 1 [ return(n) ]
    return((bam_pow_u(A, n) - 1) / (A - 1))
]

@cpu bal_poly_hash_cf(n int64, base int64): int64 [
    // h' = base*h + i, i from 1..n, h0=0
    // h = sum_{i=1}^n i * base^{n-i}
    if n <= 0 [ return(0) ]
    box h = 0 int64
    box i = 1 int64
    // exact via: h = (base^{n+1} - (n+1)*base + n) / (base-1)^2  for base!=1
    if base == 1 [
        return((n * (n + 1)) / 2)
    ]
    box bp = bam_pow_u(base, n + 1) int64
    box num = bp - (n + 1) * base + n int64
    box den = (base - 1) * (base - 1) int64
    if den == 0 [ return(0) ]
    return(num / den)
]

@cpu bal_sum_k_pow(n int64, p int64): int64 [
    if p == 1 [ return(bam_sum_arith(n)) ]
    if p == 2 [ return(bam_sum_sq(n)) ]
    if p == 3 [ return(bal_sum_cubes(n)) ]
    // sum i^4 = n(n+1)(2n+1)(3n^2+3n-1)/30
    if p == 4 [
        box a = n * (n + 1) int64
        box b = 2 * n + 1 int64
        box c = 3 * n * n + 3 * n - 1 int64
        return(((a * b) / 30) * c)
    ]
    return(0)
]

@cpu bal_dot_arith(n int64, a0 int64, delta int64): int64 [
    if n <= 0 [ return(0) ]
    return(n * a0 + delta * ((n * (n - 1)) / 2))
]

@cpu bal_fib_matrix(n int64): int64 [
    box a = 1 int64
    box b = 1 int64
    box c = 1 int64
    box d = 0 int64
    return(bal_mat2_pow_apply(1, n, a, b, c, d))
]

@cpu bal_arith_geo(n int64, a int64, r int64): int64 [
    // sum_{i=0}^{n-1} (i+1) * r^i
    if n <= 0 [ return(0) ]
    if r == 1 [ return((n * (n + 1)) / 2) ]
    // (1 - (n+1)*r^n + n*r^{n+1}) / (1-r)^2
    box rn = bam_pow_u(r, n) int64
    box rnp = rn * r int64
    box num = 1 - (n + 1) * rn + n * rnp int64
    box den = (1 - r) * (1 - r) int64
    if den == 0 [ return(0) ]
    return(num / den)
]

@cpu bal_scan_li_after(asm string, pos int64, reg string): int64 [
    // find "li      rX," near pos, return value or -1
    box n = strlen(asm) int64
    box needle = str_concat("li      ", reg) string
    needle = str_concat(needle, ",")
    box m = strlen(needle) int64
    box i = pos int64
    box lim = pos + 800 int64
    if lim > n [ lim = n ]
    while i + m <= lim [
        box ok = 1 int64
        box k = 0 int64
        while k < m [
            if char_at(asm, i + k) != char_at(needle, k) [ ok = 0 ]
            k = k + 1
        ]
        if ok == 1 [
            box j = i + m int64
            while j < n [
                if is_space(char_at(asm, j)) == 1 [ j = j + 1 ]
                if is_space(char_at(asm, j)) == 0 [
                    box j2 = n int64
                    j = j
                ]
            ]
            j = i + m
            while is_space(char_at(asm, j)) == 1 [ j = j + 1 ]
            if is_digit(char_at(asm, j)) == 0 [
                if char_at(asm, j) == 45 [
                    // negative skip
                    return(0 - 1)
                ]
                return(0 - 1)
            ]
            box v = 0 int64
            while is_digit(char_at(asm, j)) == 1 [
                v = v * 10 + (char_at(asm, j) - 48)
                j = j + 1
            ]
            return(v)
        ]
        i = i + 1
    ]
    return(0 - 1)
]

@cpu bal_try_lcg_close(asm string): string [
    // Detect promoted affine loops already handled by bam_try_general_affine;
    // extra pass: if mul by large const appears with add 1 in loop body + count N
    box cur = bam_try_general_affine(asm) string
    cur = bpo_math_matrix_mix(cur)
    cur = bpo_strength_mul_add(cur)
    cur = bpo_closed_form_sum(cur)
    return(cur)
]

@cpu bal_try_poly_close(asm string): string [
    box cur = bpo_closed_form_sum(asm) string
    cur = bpo_strength_count(cur)
    cur = bpo_math_matrix_mix(cur)
    return(cur)
]

@cpu bal_try_power_sums(asm string): string [
    // Reuse nested + strength
    box cur = bal_nested_recurrence(asm) string
    cur = bpo_strength_count(cur)
    cur = bpo_closed_form_sum(cur)
    return(cur)
]

@cpu bal_advanced_cse_arith(asm string): string [
    box cur = asm string
    box r = 0 int64
    while r < 5 [
        cur = bpo_dce_mov(cur)
        cur = bpo_dead_li(cur)
        cur = bpo_peep_cpu(cur)
        cur = bpo_clean_arith(cur)
        cur = bpo_fold_inc1(cur)
        cur = bpo_strength_mul_add(cur)
        r = r + 1
    ]
    return(cur)
]



@cpu bal_pulse_pow(A int64, k int64): int64 [
    return(bam_pow_u(A, k))
]

@cpu bal_pulse_lcg_close(s0 int64, n int64, A int64, C int64): int64 [
    // s' = A*s+C  → matrix power O(log n) pulse train
    return(bam_affine3_apply(s0, n, A, 0, C))
]

@cpu bal_pulse_geom_train(A int64, n int64): int64 [
    // sum of pulses p_k = A^k for k=0..n-1
    return(bal_geom_sum(A, n))
]

@cpu bal_pulse_scan_A(asm string): int64 [
    // Find large mul constant (pulse gain A) near loop
    box n = strlen(asm) int64
    box best = 0 int64
    box i = 0 int64
    while i + 12 < n [
        if strcmp(substr(asm, i, 12), "li      r1,") == 0 [
            box k = i + 12 int64
            while is_space(char_at(asm, k)) == 1 [ k = k + 1 ]
            if is_digit(char_at(asm, k)) == 1 [
                box v = 0 int64
                while is_digit(char_at(asm, k)) == 1 [
                    v = v * 10 + (char_at(asm, k) - 48)
                    k = k + 1
                ]
                if v > best [ best = v ]
            ]
        ]
        if strcmp(substr(asm, i, 12), "li      r2,") == 0 [
            box k = i + 12 int64
            while is_space(char_at(asm, k)) == 1 [ k = k + 1 ]
            if is_digit(char_at(asm, k)) == 1 [
                box v = 0 int64
                while is_digit(char_at(asm, k)) == 1 [
                    v = v * 10 + (char_at(asm, k) - 48)
                    k = k + 1
                ]
                if v > 1 [
                    if v > best [ best = v ]
                ]
            ]
        ]
        i = i + 1
    ]
    return(best)
]

@cpu bal_pulse(asm string): string [
    // Pulse optimizer: LCG/HASH as periodic pulse trains → O(log n) via bam_pow_u
    box cur = asm string
    box base = asm string
    // promote affine shapes then matrix-power close
    cur = bpo_promote_loop_regs(cur)
    cur = bpo_promote_dep_loop(cur)
    cur = bpo_promote_mix_loop(cur)
    cur = bam_try_general_affine(cur)
    cur = bpo_math_matrix_mix(cur)
    cur = bpo_strength_mul_add(cur)
    // if still loop + large A, try CF path again
    if bal_has(cur, "jl") == 1 [
        cur = bam_try_general_affine(cur)
        cur = bpo_cf_arith_sum_slots(cur)
        cur = bpo_closed_form_sum(cur)
    ]
    cur = bpo_cf_arith_sum_slots(cur)
    return(bal_keep(base, cur))
]

@cpu bal_wave_front(s0 int64, n int64, A int64, B int64, C int64): int64 [
    // Wave front w(t)=A^t * ...  for s_{k+1}=A*s_k + B*k + C
    return(bam_affine3_apply(s0, n, A, B, C))
]

@cpu bal_wave_nest_close(N int64, M int64): int64 [
    // 2-wave interference of nest N×M pure count
    return(bam_nest(N, M))
]

@cpu bal_wave(asm string): string [
    box cur = asm string
    box base = asm string
    cur = bpo_promote_abc_loop(cur)
    cur = bpo_promote_dep_loop(cur)
    cur = bpo_promote_mix_loop(cur)
    cur = bam_try_general_affine(cur)
    cur = bpo_math_matrix_mix(cur)
    cur = bal_nested_recurrence(cur)
    cur = bal_table_close_asm(cur)
    cur = bpo_closed_form_sum(cur)
    cur = bpo_strength_count(cur)
    if bal_has(cur, "jl") == 1 [
        cur = bal_nested_recurrence(cur)
        cur = bal_table_close_asm(cur)
        cur = bam_try_general_affine(cur)
        cur = bpo_math_matrix_mix(cur)
    ]
    return(bal_keep(base, cur))
]

@cpu bal_egraph_add_rules(asm string): string [
    box cur = asm string
    cur = bpo_cf_arith_sum_slots(cur)
    cur = bpo_closed_form_sum(cur)
    cur = bpo_strength_count(cur)
    cur = bpo_strength_mul_add(cur)
    cur = bam_try_general_affine(cur)
    cur = bpo_math_matrix_mix(cur)
    cur = bal_table_close_asm(cur)
    cur = bpo_cf_arith_sum_slots(cur)
    cur = bal_nested_recurrence(cur)
    cur = bal_rewrite_arith_identities(cur)
    cur = bpo_clean_arith(cur)
    cur = bpo_fold_inc1(cur)
    cur = bpo_promote_abc_loop(cur)
    cur = bam_try_general_affine(cur)
    return(cur)
]

@cpu bal_egraph(asm string): string [
    // Equality saturation (egg-style lite): saturate all equalities, extract best by cost
    box cur = asm string
    box best = asm string
    box bestc = pow_cost(best) int64
    box bestsc = bayes_loop_score(best) int64
    box r = 0 int64
    while r < 10 [
        box nxt = bal_egraph_add_rules(cur) string
        nxt = pow_egraph_saturate_basm(nxt)
        nxt = bal_pulse(nxt)
        nxt = bal_wave(nxt)
        box c = pow_cost(nxt) int64
        box sc = bayes_loop_score(nxt) int64
        // prefer fewer loops (score), then lower cost
        box better = 0 int64
        if sc < bestsc [ better = 1 ]
        if sc == bestsc [
            if c < bestc [ better = 1 ]
        ]
        if better == 1 [
            best = nxt
            bestc = c
            bestsc = sc
        ]
        cur = nxt
        if sc == 0 [
            if r > 1 [ r = 100 ]
        ]
        r = r + 1
    ]
    return(bal_keep(asm, best))
]

@cpu bal_smt_gf2_xor_close(asm string): string [
    // SMT-lite GF(2): xor-linear recurrences — fold strength + peep (xor as add mod 2)
    box cur = asm string
    // If body dominated by xor-like pattern via mul/add of powers of two, strength reduce
    cur = bpo_strength_mul_add(cur)
    cur = bpo_clean_arith(cur)
    cur = bpo_peep_cpu(cur)
    cur = bpo_fold_inc1(cur)
    // try matrix if affine-looking after strength
    cur = bam_try_general_affine(cur)
    cur = bpo_math_matrix_mix(cur)
    return(cur)
]

@cpu bal_smt(asm string): string [
    // Internal SMT-style solver: independence + GF(2) + CF eligibility
    box cur = asm string
    box base = asm string
    if pow_smt_loop_independent(cur) == 1 [
        cur = bpo_closed_form_sum(cur)
        cur = bpo_strength_count(cur)
        cur = bpo_promote_loop_regs(cur)
        cur = bpo_closed_form_sum(cur)
    ]
    cur = bal_smt_gf2_xor_close(cur)
    if bal_has(cur, "jl") == 1 [
        cur = bam_try_general_affine(cur)
        cur = bpo_math_matrix_mix(cur)
        cur = bpo_strength_mul_add(cur)
        cur = bal_pulse(cur)
        cur = bal_wave(cur)
    ]
    return(bal_keep(base, cur))
]

@cpu bal_tensor_hint(asm string): string [
    // Tensor/AI path: keep gpu/vram runtime calls; DCE around them; no break
    box cur = asm string
    // Fold pure arith away from gpu_register / vram_alloc regions via global peep
    cur = bpo_runtime_aware(cur)
    cur = bpo_peep_cpu(cur)
    cur = bpo_dce_mov(cur)
    cur = bpo_gpu_opt(cur)
    return(cur)
]

@cpu bal_tensor(asm string): string [
    // 4D tensor view: lists-in-matrix; uses existing vram_alloc / gpu_register semantics
    box cur = bal_tensor_hint(asm) string
    cur = bal_keep(cur, bal_pulse(cur))
    cur = bal_keep(cur, bal_wave(cur))
    return(cur)
]

@cpu bal_pow_stack(asm string): string [
    // Graph stack once (re-entry safe)
    if bal_has(asm, "OPT:POW-STACK") == 1 [ return(asm) ]
    box cur = asm string
    box base = asm string
    cur = bal_keep(cur, bal_pulse(cur))
    cur = bal_keep(cur, bal_arsenal(cur))
    cur = bal_keep(cur, bal_egraph(cur))
    cur = bal_keep(cur, pow_egraph_saturate_basm(cur))
    cur = bal_keep(cur, bal_table_close_asm(cur))
    cur = bal_keep(cur, bam_optimize(cur))
    cur = bal_keep(cur, bal_egraph(cur))
    if strlen(cur) < 32 [ return(base) ]
    if strlen(cur) > strlen(base) * 4 [ return(base) ]
    cur = str_concat(cur, "
// OPT:POW-STACK
")
    return(cur)
]

@cpu pow_eclass_put(map string, expr string, rep string): string [
    box m = str_concat(map, expr) string
    m = str_concat(m, "=>")
    m = str_concat(m, rep)
    m = str_concat(m, "#")
    return(m)
]

@cpu pow_eclass_get(map string, expr string): string [
    box needle = str_concat(expr, "=>") string
    box nlen = strlen(needle) int64
    box i = 0 int64
    box n = strlen(map) int64
    while i + nlen <= n [
        box ok = 1 int64
        box k = 0 int64
        while k < nlen [
            if char_at(map, i + k) != char_at(needle, k) [ ok = 0 ]
            k = k + 1
        ]
        if ok == 1 [
            box j = i + nlen int64
            box s0 = j int64
            while j < n [
                if char_at(map, j) == 35 [ 
                    return(substr(map, s0, j - s0))
                ]
                j = j + 1
            ]
            return(substr(map, s0, n - s0))
        ]
        i = i + 1
    ]
    return("")
]

@cpu pow_cost(s string): int64 [
    box c = strlen(s) int64
    box i = 0 int64
    while i + 3 < strlen(s) [
        if char_at(s, i) == 109 [
            if char_at(s, i + 1) == 117 [
                if char_at(s, i + 2) == 108 [ c = c + 40 ]
            ]
        ]
        if char_at(s, i) == 100 [
            if char_at(s, i + 1) == 105 [
                if char_at(s, i + 2) == 118 [ c = c + 60 ]
            ]
        ]
        if char_at(s, i) == 106 [
            if char_at(s, i + 1) == 108 [ c = c + 100 ]
        ]
        i = i + 1
    ]
    return(c)
]

@cpu pow_egraph_saturate_basm(asm string): string [
    // more saturation rounds below
    // Equality saturation lite: fold add/mul identities + CSE of identical li sequences
    box cur = asm string
    box round = 0 int64
    while round < 3 [
        box prev = pow_cost(cur) int64
        cur = bpo_clean_arith(cur)
        cur = bpo_fold_inc1(cur)
        cur = bpo_peep_cpu(cur)
        cur = bpo_dce_mov(cur)
        cur = bpo_dead_li(cur)
        // CF/matrix once after loop (not every round)
        box now = pow_cost(cur) int64
        if now >= prev [
            if round > 1 [ round = 100 ]
        ]
        round = round + 1
    ]
    cur = bpo_closed_form_sum(cur)
    cur = bpo_math_matrix_mix(cur)
    return(cur)
]

@cpu pow_smt_loop_independent(asm string): int64 [
    // SMT-lite: if only one induction + pure add of induction → CF candidate
    // Heuristic: has jl, has add of counter pattern, no mul of accumulator by non-const
    if bal_has(asm, "jl") == 0 [ return(0) ]
    if bal_has(asm, "mul") == 1 [
        // dependent mul → not pure sum CF
        if bal_has(asm, "add") == 1 [ return(0) ]
        return(0)
    ]
    if bal_has(asm, "add") == 1 [ return(1) ]
    return(0)
]

@cpu pow_smt_apply(asm string): string [
    box cur = asm string
    if pow_smt_loop_independent(cur) == 1 [
        cur = bpo_closed_form_sum(cur)
        cur = bpo_strength_count(cur)
        cur = bpo_promote_loop_regs(cur)
        cur = bpo_closed_form_sum(cur)
    ]
    // always try affine if loop present
    if bal_has(cur, "jl") == 1 [
        cur = bam_try_general_affine(cur)
        cur = bpo_math_matrix_mix(cur)
        cur = bpo_strength_mul_add(cur)
    ]
    return(cur)
]

@cpu pow_pulse(asm string): string [
    // One pulse: peep + optional algebra close (non-branchy)
    box cur = asm string
    cur = bpo_peep_cpu(cur)
    cur = bpo_clean_arith(cur)
    cur = bpo_fold_inc1(cur)
    cur = bpo_fold_memops(cur)
    cur = bpo_dce_mov(cur)
    cur = bpo_dead_li(cur)
    cur = bpo_graph_dce_labels(cur)
    if basm_is_branchy(cur) == 0 [
        cur = bpo_strength_count(cur)
        cur = bpo_strength_mul_add(cur)
        cur = bpo_closed_form_sum(cur)
        cur = bam_try_general_affine(cur)
    ]
    return(cur)
]

@cpu pow_wave(asm string, depth int64): string [
    // Wave: pulse → egraph → smt → BAL pulse/wave → fixpoint
    box cur = asm string
    box base = asm string
    box w = 0 int64
    box d = depth int64
    if d > 4 [ d = 4 ]
    if d < 1 [ d = 1 ]
    while w < d [
        box sc0 = bal_loop_markers(cur) int64
        box len0 = strlen(cur) int64
        cur = pow_pulse(cur)
        cur = pow_egraph_saturate_basm(cur)
        cur = pow_smt_apply(cur)
        if basm_is_branchy(cur) == 0 [
            cur = bal_pulse(cur)
            cur = bal_wave(cur)
            cur = bal_try_lcg_close(cur)
            cur = bal_try_poly_close(cur)
            cur = bpo_math_matrix_mix(cur)
        ]
        box sc1 = bal_loop_markers(cur) int64
        box len1 = strlen(cur) int64
        if sc1 >= sc0 [
            if len1 >= len0 [
                if w > 0 [ w = d ]
            ]
        ]
        w = w + 1
    ]
    return(bal_keep(base, cur))
]

@cpu pow_bir_pulse(bir string): string [
    box cur = bir string
    cur = bir_optimize(cur)
    cur = bir_const_fold_add(cur)
    cur = bir_dedupe(cur)
    return(cur)
]

@cpu pow_bir_wave(bir string, depth int64): string [
    box cur = bir string
    box w = 0 int64
    while w < depth [
        cur = pow_bir_pulse(cur)
        cur = bir_graph_vn(cur)
        cur = bir_algebra_graph(cur)
        cur = bir_dedupe(cur)
        cur = bir_optimize(cur)
        cur = bir_dedupe(cur)
        w = w + 1
    ]
    return(cur)
]

@cpu pow_optimize(asm string): string [
    // POW brutal (single entry)
    if bal_has(asm, "OPT:POW-DONE") == 1 [ return(asm) ]
    box cur = asm string
    box base = asm string
    cur = bal_keep(cur, bal_pow_stack(cur))
    cur = bal_keep(cur, bam_optimize(cur))
    cur = bal_keep(cur, pow_egraph_saturate_basm(cur))
    if basm_is_branchy(cur) == 0 [
        cur = bal_keep(cur, bpo_math_matrix_mix(cur))
        cur = bal_keep(cur, bam_try_general_affine(cur))
        cur = bal_keep(cur, bpo_closed_form_sum(cur))
        cur = bal_keep(cur, bpo_strength_count(cur))
        cur = bal_keep(cur, bal_try_power_sums(cur))
    ]
    cur = bal_keep(cur, bal_egraph(cur))
    cur = bal_keep(cur, bpo_peep_cpu(cur))
    cur = bal_keep(cur, bpo_dce_mov(cur))
    if opt_size_ok(base, cur) == 0 [ return(base) ]
    return(cur)
]

@cpu pow_optimize_brutal(asm string): string [
    // No recursion into bal_optimize/pow_optimize loop
    box cur = asm string
    box base = asm string
    box t = 0 int64
    while t < 1 [
        cur = bal_keep(cur, bal_pow_stack(cur))
        cur = bal_keep(cur, bal_egraph(cur))
        cur = bal_keep(cur, bal_smt(cur))
        cur = bal_keep(cur, bam_optimize(cur))
        cur = bal_keep(cur, pow_wave(cur, 4))
        cur = bal_keep(cur, bpo_closed_form_sum(cur))
        cur = bal_keep(cur, bpo_math_matrix_mix(cur))
        cur = bal_keep(cur, bam_try_general_affine(cur))
        t = t + 1
    ]
    cur = bal_keep(cur, bpo_peep_cpu(cur))
    cur = bal_keep(cur, bpo_dce_mov(cur))
    if strlen(cur) < 32 [ return(base) ]
    return(cur)
]

@cpu bal_arsenal(asm string): string [
    if asm_too_heavy(asm) == 1 [ return(asm) ]

    // Full BAL arsenal + graph/pulse/smt (single entry)
    if bal_has(asm, "OPT:BAL-ARS") == 1 [ return(asm) ]
    box cur = asm string
    box base = asm string
    cur = bal_keep(cur, bal_const_prop_global(cur))
    cur = bal_keep(cur, bal_rewrite_arith_identities(cur))
    cur = bal_keep(cur, bal_invariant_hoist(cur))
    cur = bal_keep(cur, bal_fuse_loops(cur))
    cur = bal_keep(cur, bal_pure_calls(cur))
    cur = bal_keep(cur, bpo_promote_loop_regs(cur))
    cur = bal_keep(cur, bpo_promote_dep_loop(cur))
    cur = bal_keep(cur, bpo_promote_mix_loop(cur))
    cur = bal_keep(cur, bpo_promote_abc_loop(cur))
    if basm_is_branchy(cur) == 0 [
        cur = bal_keep(cur, bal_pulse(cur))
        cur = bal_keep(cur, bal_wave(cur))
        cur = bal_keep(cur, bal_try_lcg_close(cur))
        cur = bal_keep(cur, bal_try_poly_close(cur))
        cur = bal_keep(cur, bal_try_power_sums(cur))
        cur = bal_keep(cur, bam_try_general_affine(cur))
        cur = bal_keep(cur, bpo_math_matrix_mix(cur))
        cur = bal_keep(cur, bpo_closed_form_sum(cur))
        cur = bal_keep(cur, bpo_strength_count(cur))
        cur = bal_keep(cur, bpo_strength_mul_add(cur))
        cur = bal_keep(cur, bam_optimize(cur))
        cur = bal_keep(cur, bal_table_close_asm(cur))
        cur = bal_keep(cur, bal_egraph(cur))
        cur = bal_keep(cur, bal_smt(cur))
        cur = bal_keep(cur, pow_smt_apply(cur))
        cur = bal_keep(cur, bal_dep_graph_close(cur))
        cur = bal_keep(cur, bal_equation_fixpoint(cur))
    ]
    cur = bal_keep(cur, bal_advanced_cse_arith(cur))
    cur = bal_keep(cur, bal_dag_solve(cur))
    cur = bal_keep(cur, bpo_clean_arith(cur))
    cur = bal_keep(cur, bpo_peep_cpu(cur))
    cur = bal_keep(cur, bpo_dce_mov(cur))
    cur = bal_keep(cur, bpo_dead_li(cur))
    if opt_size_ok(base, cur) == 0 [ return(base) ]
    cur = str_concat(cur, "
// OPT:BAL-ARS
")
    return(cur)
]

@cpu bal_optimize(asm string): string [
    if bal_has(asm, "// NO_OPT_BEGIN") == 1 [
        if bal_has(asm, "// GPU_KERNEL") == 1 [ return(asm) ]
    ]

    box cur = asm string
    box base = asm string
    cur = bal_keep(base, bal_const_prop_global(cur))
    cur = bal_keep(cur, bal_dep_graph_close(cur))
    cur = bal_keep(cur, bal_invariant_hoist(cur))
    cur = bal_keep(cur, bal_fuse_loops(cur))
    cur = bal_keep(cur, bal_pure_calls(cur))
    cur = bal_keep(cur, bal_rewrite_arith_identities(cur))
    cur = bal_keep(cur, bal_arsenal(cur))
    cur = bal_keep(cur, bal_pow_stack(cur))
    cur = bal_keep(cur, bal_equation_fixpoint(cur))
    cur = bal_keep(cur, pow_wave(cur, 2))
    cur = bal_keep(cur, bal_advanced_cse_arith(cur))
    if strlen(cur) < 32 [ return(base) ]
    return(cur)
]

@cpu bayes_loop_score(asm string): int64 [
    box n = strlen(asm) int64
    box s = 0 int64
    box i = 0 int64
    while i + 4 < n [
        if char_at(asm, i) == 106 [
            if char_at(asm, i + 1) == 108 [ s = s + 4 ]
            if char_at(asm, i + 1) == 109 [ s = s + 2 ]
            if char_at(asm, i + 1) == 103 [ s = s + 2 ]
            if char_at(asm, i + 1) == 101 [ s = s + 2 ]
        ]
        if i + 5 < n [
            if match_kw(asm, i, ".L1") == 1 [ s = s + 6 ]
            if match_kw(asm, i, ".L2") == 1 [ s = s + 1 ]
        ]
        if i + 6 < n [
            if match_kw(asm, i, "while") == 1 [ s = s + 3 ]
        ]
        i = i + 1
    ]
    // penalize very long residual loops bodies
    if n > 2000 [ s = s + (n / 500) ]
    return(s)
]

@cpu bayes_reward(before int64, after int64, len_b int64, len_a int64): int64 [
    if after < before [ return(1) ]
    if after == before [
        if len_a < len_b [ return(1) ]
    ]
    return(0)
]

@cpu bandit_run_arm(asm string, arm int64): string [
    // 12 arms — full BPO/BAM/BAL coverage
    box cur = asm string
    if arm == 0 [
        cur = bpo_closed_form_sum(cur)
        cur = bpo_strength_mul_add(cur)
    ]
    if arm == 1 [
        cur = bpo_strength_count(cur)
    ]
    if arm == 2 [
        cur = bpo_promote_mix_loop(cur)
        cur = bpo_math_matrix_mix(cur)
        cur = bam_try_general_affine(cur)
    ]
    if arm == 3 [
        cur = bpo_promote_dep_loop(cur)
        cur = bpo_promote_loop_regs(cur)
        cur = bpo_promote_abc_loop(cur)
    ]
    if arm == 4 [
        cur = bam_optimize(cur)
        cur = bam_try_general_affine(cur)
        cur = bpo_math_matrix_mix(cur)
    ]
    if arm == 5 [
        cur = bpo_peep_cpu(cur)
        cur = bpo_dce_mov(cur)
        cur = bpo_dead_li(cur)
        cur = bpo_fold_inc1(cur)
    ]
    if arm == 6 [
        cur = bpo_unroll_x4(cur)
        cur = bpo_unroll_reg_loop(cur)
    ]
    if arm == 7 [
        cur = bal_dag_solve(cur)
        cur = bpo_clean_arith(cur)
        cur = bpo_graph_dce_labels(cur)
    ]
    if arm == 8 [
        cur = bal_dep_graph_close(cur)
        cur = bal_invariant_hoist(cur)
    ]
    if arm == 9 [
        cur = bal_const_prop_global(cur)
        cur = bal_pure_calls(cur)
    ]
    if arm == 10 [
        cur = bpo_fold_memops(cur)
        cur = bpo_runtime_aware(cur)
        cur = bpo_rt_fold_strlen_const(cur)
    ]
    if arm == 11 [
        // mega algebra pack
        cur = bpo_promote_mix_loop(cur)
        cur = bpo_math_matrix_mix(cur)
        cur = bpo_closed_form_sum(cur)
        cur = bpo_strength_count(cur)
        cur = bam_try_general_affine(cur)
    ]
    return(cur)
]

@cpu bandit_ucb(wins int64, losses int64, total int64): int64 [
    // Professional UCB1 proxy: mean + C * sqrt(2 ln N / n) approx without floats
    // mean in [0,1000]; bonus decays as arm is pulled
    box a = wins + 1 int64
    box b = losses + 1 int64
    box n = a + b int64
    box mean = (a * 1000) / n int64
    // ln(total+1) ~ approx via bit length style: total/4 capped
    box lnN = 1 int64
    box t = total + 1 int64
    while t > 1 [
        t = t / 2
        lnN = lnN + 1
    ]
    // bonus = 120 * lnN / n
    box bonus = (lnN * 150) / n int64
    if bonus > 500 [ bonus = 500 ]
    // slight bias to algebra arms handled via priors
    return(mean + bonus)
]

@cpu bandit_get_w(arm int64, w0 int64, w1 int64, w2 int64, w3 int64, w4 int64, w5 int64, w6 int64, w7 int64, w8 int64, w9 int64, w10 int64, w11 int64): int64 [
    if arm == 0 [ return(w0) ]
    if arm == 1 [ return(w1) ]
    if arm == 2 [ return(w2) ]
    if arm == 3 [ return(w3) ]
    if arm == 4 [ return(w4) ]
    if arm == 5 [ return(w5) ]
    if arm == 6 [ return(w6) ]
    if arm == 7 [ return(w7) ]
    if arm == 8 [ return(w8) ]
    if arm == 9 [ return(w9) ]
    if arm == 10 [ return(w10) ]
    if arm == 11 [ return(w11) ]
    return(0)
]

@cpu bandit_get_l(arm int64, l0 int64, l1 int64, l2 int64, l3 int64, l4 int64, l5 int64, l6 int64, l7 int64, l8 int64, l9 int64, l10 int64, l11 int64): int64 [
    if arm == 0 [ return(l0) ]
    if arm == 1 [ return(l1) ]
    if arm == 2 [ return(l2) ]
    if arm == 3 [ return(l3) ]
    if arm == 4 [ return(l4) ]
    if arm == 5 [ return(l5) ]
    if arm == 6 [ return(l6) ]
    if arm == 7 [ return(l7) ]
    if arm == 8 [ return(l8) ]
    if arm == 9 [ return(l9) ]
    if arm == 10 [ return(l10) ]
    if arm == 11 [ return(l11) ]
    return(0)
]

@cpu bandit_optimize(asm string): string [
    // Official bandit: 12 arms, 24 rounds, then ordered polish by posterior
    box cur = asm string
    box base = asm string
    box w0 = 2 int64
    box w1 = 2 int64
    box w2 = 3 int64
    box w3 = 2 int64
    box w4 = 3 int64
    box w5 = 1 int64
    box w6 = 1 int64
    box w7 = 1 int64
    box w8 = 2 int64
    box w9 = 1 int64
    box w10 = 1 int64
    box w11 = 3 int64
    box l0 = 0 int64
    box l1 = 0 int64
    box l2 = 0 int64
    box l3 = 0 int64
    box l4 = 0 int64
    box l5 = 0 int64
    box l6 = 0 int64
    box l7 = 0 int64
    box l8 = 0 int64
    box l9 = 0 int64
    box l10 = 0 int64
    box l11 = 0 int64
    // Phase A: forced algebra arms (0,1,2,4,11) twice — maximize CF/matrix before search
    box fa = 0 int64
    while fa < 1 [
        cur = bal_keep(cur, bandit_run_arm(cur, 11))
        cur = bal_keep(cur, bandit_run_arm(cur, 2))
        cur = bal_keep(cur, bandit_run_arm(cur, 4))
        cur = bal_keep(cur, bandit_run_arm(cur, 0))
        cur = bal_keep(cur, bandit_run_arm(cur, 1))
        fa = fa + 1
    ]
    box rnd = 0 int64
    box total = 12 int64
    box stale = 0 int64
    while rnd < 12 [
        box best = rnd - (rnd / 12) * 12 int64
        box bestsc = 0 - 1 int64
        box a = 0 int64
        while a < 12 [
            box ww = bandit_get_w(a, w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11) int64
            box ll = bandit_get_l(a, l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11) int64
            box sc = bandit_ucb(ww, ll, total) int64
            if sc > bestsc [
                bestsc = sc
                best = a
            ]
            a = a + 1
        ]
        box before = bayes_loop_score(cur) int64
        box len_b = strlen(cur) int64
        box nxt = bandit_run_arm(cur, best) string
        if strlen(nxt) < 32 [ nxt = cur ]
        box after = bayes_loop_score(nxt) int64
        box len_a = strlen(nxt) int64
        box rew = bayes_reward(before, after, len_b, len_a) int64
        if rew == 1 [
            cur = nxt
            stale = 0
        ]
        if rew == 0 [
            if after <= before [
                if len_a <= len_b + 50 [ cur = nxt ]
            ]
            stale = stale + 1
        ]
        if stale >= 4 [ rnd = 100 ]
        // update wins/losses
        if best == 0 [
            if rew == 1 [ w0 = w0 + 1 ]
            if rew == 0 [ l0 = l0 + 1 ]
        ]
        if best == 1 [
            if rew == 1 [ w1 = w1 + 1 ]
            if rew == 0 [ l1 = l1 + 1 ]
        ]
        if best == 2 [
            if rew == 1 [ w2 = w2 + 1 ]
            if rew == 0 [ l2 = l2 + 1 ]
        ]
        if best == 3 [
            if rew == 1 [ w3 = w3 + 1 ]
            if rew == 0 [ l3 = l3 + 1 ]
        ]
        if best == 4 [
            if rew == 1 [ w4 = w4 + 1 ]
            if rew == 0 [ l4 = l4 + 1 ]
        ]
        if best == 5 [
            if rew == 1 [ w5 = w5 + 1 ]
            if rew == 0 [ l5 = l5 + 1 ]
        ]
        if best == 6 [
            if rew == 1 [ w6 = w6 + 1 ]
            if rew == 0 [ l6 = l6 + 1 ]
        ]
        if best == 7 [
            if rew == 1 [ w7 = w7 + 1 ]
            if rew == 0 [ l7 = l7 + 1 ]
        ]
        if best == 8 [
            if rew == 1 [ w8 = w8 + 1 ]
            if rew == 0 [ l8 = l8 + 1 ]
        ]
        if best == 9 [
            if rew == 1 [ w9 = w9 + 1 ]
            if rew == 0 [ l9 = l9 + 1 ]
        ]
        if best == 10 [
            if rew == 1 [ w10 = w10 + 1 ]
            if rew == 0 [ l10 = l10 + 1 ]
        ]
        if best == 11 [
            if rew == 1 [ w11 = w11 + 1 ]
            if rew == 0 [ l11 = l11 + 1 ]
        ]
        total = total + 1
        rnd = rnd + 1
        // early exit if clean
        if bayes_loop_score(cur) < 3 [
            if bam_scan_has(cur, "jl .L1") == 0 [ rnd = 100 ]
        ]
    ]
    // Ordered polish: run arms sorted by posterior mean (high first) once each
    box p = 0 int64
    while p < 12 [
        // find unused best remaining: use score again
        box best = 0 int64
        box bestsc = 0 - 1 int64
        box a = 0 int64
        while a < 12 [
            box ww = bandit_get_w(a, w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11) int64
            box ll = bandit_get_l(a, l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11) int64
            box sc = bayes_score_arm(ww, ll) int64
            if sc > bestsc [
                bestsc = sc
                best = a
            ]
            a = a + 1
        ]
        // zero out winner so next polish picks next
        if best == 0 [ w0 = 0 - 100 ]
        if best == 1 [ w1 = 0 - 100 ]
        if best == 2 [ w2 = 0 - 100 ]
        if best == 3 [ w3 = 0 - 100 ]
        if best == 4 [ w4 = 0 - 100 ]
        if best == 5 [ w5 = 0 - 100 ]
        if best == 6 [ w6 = 0 - 100 ]
        if best == 7 [ w7 = 0 - 100 ]
        if best == 8 [ w8 = 0 - 100 ]
        if best == 9 [ w9 = 0 - 100 ]
        if best == 10 [ w10 = 0 - 100 ]
        if best == 11 [ w11 = 0 - 100 ]
        box nxt = bandit_run_arm(cur, best) string
        cur = bal_keep(cur, nxt)
        p = p + 1
    ]
    // final algebra lock — reduce everything left
    box fin = 0 int64
    while fin < 4 [
        cur = bal_keep(cur, bam_optimize(cur))
        cur = bal_keep(cur, bpo_closed_form_sum(cur))
        cur = bal_keep(cur, bpo_math_matrix_mix(cur))
        cur = bal_keep(cur, bpo_strength_count(cur))
        cur = bal_keep(cur, bam_try_general_affine(cur))
        cur = bal_keep(cur, bam_analyze_deep(cur))
        fin = fin + 1
    ]
    if strlen(cur) < 32 [ return(base) ]
    return(cur)
]

// Compat alias
@cpu bayes_optimize(asm string): string [
    return(bandit_optimize(asm))
]

@cpu bayes_score_arm(wins int64, losses int64): int64 [
    box a = wins + 1 int64
    box b = losses + 1 int64
    if a + b <= 0 [ return(0) ]
    return((a * 1000) / (a + b))
]

@cpu bal_optimize_massive(asm string): string [
    // O6: 1 guarded BAL sweep (stability > extreme)
    box cur = asm string
    box w = 0 int64
    while w < 1 [
        box ncur = bal_optimize(cur) string
        cur = bal_keep(cur, ncur)
        cur = bal_keep(cur, bam_analyze_deep(cur))
        cur = bal_keep(cur, bal_dep_graph_close(cur))
        cur = bal_keep(cur, bal_dag_solve(cur))
        w = w + 1
    ]
    if strlen(cur) < 32 [ return(asm) ]
    return(cur)
]

@cpu bam_scan_has(asm string, needle string): int64 [
    box n = strlen(asm) int64
    box m = strlen(needle) int64
    box i = 0 int64
    while i + m <= n [
        if strcmp(substr(asm, i, m), needle) == 0 [ return(1) ]
        i = i + 1
    ]
    return(0)
]

@cpu bam_analyze_deep(asm string): string [
    // Enormous analysis: classify residual loops and force algebraic close
    box cur = asm string
    // Phase A: structural scan
    box has_loop = bam_scan_has(cur, ".L1") int64
    box has_mix = bam_scan_has(cur, "lea3a") int64
    box has_sum = bam_scan_has(cur, "add     r8, r9") int64
    box has_prom = bam_scan_has(cur, "promote") int64
    box has_jl = bam_scan_has(cur, "jl .L1") int64
    // Phase B: if any loop residual → full solver battery
    if has_loop == 1 [
        cur = bpo_promote_loop_regs(cur)
        cur = bpo_promote_dep_loop(cur)
        cur = bpo_promote_mix_loop(cur)
        cur = bpo_math_matrix_mix(cur)
        cur = bpo_promote_abc_loop(cur)
        cur = bpo_closed_form_sum(cur)
        cur = bpo_strength_count(cur)
        cur = bpo_strength_mul_add(cur)
        cur = bam_optimize(cur)
    ]
    if has_mix == 1 [
        cur = bpo_promote_mix_loop(cur)
        cur = bpo_math_matrix_mix(cur)
        cur = bam_optimize(cur)
    ]
    if has_jl == 1 [
        cur = bpo_closed_form_sum(cur)
        cur = bpo_strength_count(cur)
        cur = bpo_math_matrix_mix(cur)
    ]
    // Phase C: always try algebraic cleanup
    cur = bpo_closed_form_sum(cur)
    cur = bpo_strength_count(cur)
    cur = bpo_math_matrix_mix(cur)
    cur = bam_try_general_affine(cur)
    cur = bam_optimize(cur)
    return(cur)
]

@cpu bam_optimize_aggressive(asm string): string [
    // Fast-aggressive: deep once, then rounds until no loop markers
    box cur = asm string
    cur = bam_analyze_deep(cur)
    box pass = 0 int64
    while pass < 3 [
        box sc0 = bayes_loop_score(cur) int64
        cur = bam_optimize(cur)
        cur = bpo_closed_form_sum(cur)
        cur = bpo_strength_count(cur)
        cur = bpo_promote_mix_loop(cur)
        cur = bpo_math_matrix_mix(cur)
        cur = bam_try_general_affine(cur)
        cur = bpo_promote_dep_loop(cur)
        cur = bpo_promote_loop_regs(cur)
        cur = bpo_strength_mul_add(cur)
        cur = bpo_closed_form_sum(cur)
        cur = bam_try_general_affine(cur)
        box sc1 = bayes_loop_score(cur) int64
        // done if no residual loops
        if bam_scan_has(cur, "jl .L1") == 0 [
            if bam_scan_has(cur, "jmp .L1") == 0 [
                if bam_scan_has(cur, ".L1:") == 0 [
                    pass = 100
                ]
            ]
        ]
        if sc1 >= sc0 [
            if pass > 2 [ pass = 100 ]
        ]
        pass = pass + 1
    ]
    cur = bpo_math_matrix_mix(cur)
    cur = bpo_closed_form_sum(cur)
    cur = bpo_strength_count(cur)
    return(cur)
]

@cpu bam_try_general_affine(asm string): string [
    if basm_is_branchy(asm) == 1 [ return(asm) ]
    // General: find li r5,N ... li r0,S0 ... li r1,A ... li r2,C near a mul/lea3a loop → M^n
    box cur = asm string
    box n = strlen(cur) int64
    // If already closed (no jl .L1), skip
    if bam_scan_has(cur, "jl .L1") == 0 [
        if bam_scan_has(cur, "jl      .L1") == 0 [
            return(cur)
        ]
    ]
    // Extract last li r5, / r0, / r1, / r2, before first .L1
    box lim = "" string
    box s0 = "" string
    box a = "" string
    box c = "" string
    box i = 0 int64
    box stop = 0 int64
    while i < n [
        if stop == 0 [
            if i + 4 < n [
                if char_at(cur, i) == 46 [
                    if char_at(cur, i + 1) == 76 [
                        if char_at(cur, i + 2) == 49 [ stop = 1 ]
                    ]
                ]
            ]
        ]
        if stop == 0 [
            if i + 12 <= n [
                if strcmp(substr(cur, i, 12), "li      r5,") == 0 [
                    box k = i + 12 int64
                    while char_at(cur, k) == 32 [ k = k + 1 ]
                    lim = ""
                    while is_digit(char_at(cur, k)) == 1 [
                        lim = str_concat(lim, substr(cur, k, 1))
                        k = k + 1
                    ]
                ]
                if strcmp(substr(cur, i, 12), "li      r0,") == 0 [
                    box k = i + 12 int64
                    while char_at(cur, k) == 32 [ k = k + 1 ]
                    if is_digit(char_at(cur, k)) == 1 [
                        s0 = ""
                        while is_digit(char_at(cur, k)) == 1 [
                            s0 = str_concat(s0, substr(cur, k, 1))
                            k = k + 1
                        ]
                    ]
                ]
                if strcmp(substr(cur, i, 12), "li      r1,") == 0 [
                    box k = i + 12 int64
                    while char_at(cur, k) == 32 [ k = k + 1 ]
                    a = ""
                    while is_digit(char_at(cur, k)) == 1 [
                        a = str_concat(a, substr(cur, k, 1))
                        k = k + 1
                    ]
                ]
                if strcmp(substr(cur, i, 12), "li      r2,") == 0 [
                    box k = i + 12 int64
                    while char_at(cur, k) == 32 [ k = k + 1 ]
                    c = ""
                    while is_digit(char_at(cur, k)) == 1 [
                        c = str_concat(c, substr(cur, k, 1))
                        k = k + 1
                    ]
                ]
            ]
        ]
        i = i + 1
    ]
    // Need lim+s0; A defaults 3, C defaults 7 if lea3a only
    if strlen(lim) == 0 [ return(cur) ]
    if strlen(s0) == 0 [ return(cur) ]
    if strlen(a) == 0 [
        if bam_scan_has(cur, "lea3a") == 1 [
            a = "3"
            if strlen(c) == 0 [ c = "7" ]
        ]
    ]
    if strlen(a) == 0 [ return(cur) ]
    if strlen(c) == 0 [ c = "0" ]
    box Nv = bso_parse_int(lim) int64
    box Sv = bso_parse_int(s0) int64
    box Av = bso_parse_int(a) int64
    box Cv = bso_parse_int(c) int64
    if Av <= 0 [ return(cur) ]
    if Nv <= 0 [ return(cur) ]
    box res = bam_affine3_apply(Sv, Nv, Av, Av, Cv) int64
    // Replace from promote mark or first .L1 region: emit li and drop loop body until .L2
    box out = "" string
    box j = 0 int64
    box replaced = 0 int64
    while j < n [
        box did = 0 int64
        if replaced == 0 [
            if j + 4 < n [
                if char_at(cur, j) == 46 [
                    if char_at(cur, j + 1) == 76 [
                        if char_at(cur, j + 2) == 49 [
                            // .L1 — emit closed, skip to after .L2
                            out = str_concat(out, "    // BAM general affine M^n\n")
                            out = str_concat(out, "    li      r0, ")
                            out = str_concat(out, itoa(res))
                            out = str_concat(out, "\n")
                            // skip until .L2 line end
                            while j < n [
                                if j + 3 < n [
                                    if char_at(cur, j) == 46 [
                                        if char_at(cur, j + 1) == 76 [
                                            if char_at(cur, j + 2) == 50 [
                                                while j < n [
                                                    if char_at(cur, j) == 10 [
                                                        j = j + 1
                                                        j = n + 1
                                                    ]
                                                    if j < n [ j = j + 1 ]
                                                ]
                                            ]
                                        ]
                                    ]
                                ]
                                if j < n [ j = j + 1 ]
                            ]
                            replaced = 1
                            did = 1
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            if j < n [
                out = str_concat(out, substr(cur, j, 1))
                j = j + 1
            ]
        ]
        if j > n [ j = n ]
        if replaced == 1 [
            if did == 1 [
                // continue copying rest: j may be n+1
                if j > n [
                    // find .L2 end in original - messy; append from last .L2
                    box p = 0 int64
                    box last = 0 int64
                    while p + 3 < n [
                        if char_at(cur, p) == 46 [
                            if char_at(cur, p + 1) == 76 [
                                if char_at(cur, p + 2) == 50 [
                                    last = p
                                ]
                            ]
                        ]
                        p = p + 1
                    ]
                    if last > 0 [
                        while last < n [
                            if char_at(cur, last) == 10 [
                                last = last + 1
                                // append from here
                                out = str_concat(out, substr(cur, last, n - last))
                                last = n
                            ]
                            if last < n [ last = last + 1 ]
                        ]
                    ]
                    j = n
                ]
            ]
        ]
    ]
    if replaced == 0 [ return(cur) ]
    if strlen(out) < 32 [ return(cur) ]
    return(out)
]


@cpu bpo_math_matrix_mix(asm string): string [
    if basm_is_branchy(asm) == 1 [ return(asm) ]
    box cur = asm string
    box n = strlen(cur) int64
    box mark = "BPO promote mix-loop" string
    box i = 0 int64
    box out = "" string
    while i < n [
        box did = 0 int64
        if i + strlen(mark) <= n [
            if strcmp(substr(cur, i, strlen(mark)), mark) == 0 [
                box p = i int64
                box lim = "" string
                box s0 = "" string
                box found_lim = 0 int64
                box found_s0 = 0 int64
                box has_lea = 0 int64
                box q = p int64
                while q < n [
                    if q + 5 < n [
                        if match_kw(cur, q, "lea3a") == 1 [ has_lea = 1 ]
                    ]
                    if q + 12 <= n [
                        if strcmp(substr(cur, q, 12), "li      r5,") == 0 [
                            box k = q + 12 int64
                            while char_at(cur, k) == 32 [ k = k + 1 ]
                            lim = ""
                            while is_digit(char_at(cur, k)) == 1 [
                                lim = str_concat(lim, substr(cur, k, 1))
                                k = k + 1
                            ]
                            found_lim = 1
                        ]
                    ]
                    if q + 12 <= n [
                        if strcmp(substr(cur, q, 12), "li      r0,") == 0 [
                            box k2 = q + 12 int64
                            while char_at(cur, k2) == 32 [ k2 = k2 + 1 ]
                            if is_digit(char_at(cur, k2)) == 1 [
                                s0 = ""
                                while is_digit(char_at(cur, k2)) == 1 [
                                    s0 = str_concat(s0, substr(cur, k2, 1))
                                    k2 = k2 + 1
                                ]
                                found_s0 = 1
                            ]
                        ]
                    ]
                    // .L2 label
                    if q + 3 < n [
                        if char_at(cur, q) == 46 [
                            if char_at(cur, q + 1) == 76 [
                                if char_at(cur, q + 2) == 50 [
                                    if has_lea == 1 [
                                        if found_lim == 1 [
                                            if found_s0 == 1 [
                                                box Nv = bso_parse_int(lim) int64
                                                box Sv = bso_parse_int(s0) int64
                                                box res = math_mix_closed(Sv, Nv) int64
                                                // skip to end of line after .L2
                                                while q < n [
                                                    if char_at(cur, q) == 10 [
                                                        q = q + 1
                                                        // drop everything from i to q, emit result
                                                        // but out already has content before mark - need to trim back to before promote
                                                        // Strategy: out is full; we started match at i mid-line. Copy nothing from mark through L2.
                                                        out = str_concat(out, " // matrix-closed\n")
                                                        out = str_concat(out, "    li      r0, ")
                                                        out = str_concat(out, itoa(res))
                                                        out = str_concat(out, "\n")
                                                        i = q
                                                        did = 1
                                                        q = n
                                                    ]
                                                    if did == 0 [ q = q + 1 ]
                                                    if did == 1 [ q = n ]
                                                ]
                                            ]
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                    if did == 1 [ q = n ]
                    if did == 0 [ q = q + 1 ]
                    // stop if we go too far without L2
                    if q - p > 800 [ q = n ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]


@cpu bpo_promote_mix_loop(asm string): string [
    // s0=n s16=i s24=s: while i<n { s=s+i; s=s*K; s=s+C; i++ }
    box cur = asm string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    box head = "    li      r0, " string
    while i < n [
        box did = 0 int64
        if i + 30 <= n [
            if strcmp(substr(cur, i, strlen(head)), head) == 0 [
                box k = i + strlen(head) int64
                box lim = "" string
                box dig = 1 int64
                while dig == 1 [
                    if k >= n [ dig = 0 ]
                    if dig == 1 [
                        box ch = char_at(cur, k) int64
                        if is_digit(ch) == 1 [
                            lim = str_concat(lim, substr(cur, k, 1))
                            k = k + 1
                        ]
                        if is_digit(ch) == 0 [ dig = 0 ]
                    ]
                ]
                // two inits: li 0 store s16; li S0 store s24
                box rest = "\n    store   s8, r0\n    li      r0, 0\n    store   s16, r0\n    li      r0, " string
                if strlen(lim) > 0 [
                    if k + strlen(rest) <= n [
                        if strcmp(substr(cur, k, strlen(rest)), rest) == 0 [
                            box k2 = k + strlen(rest) int64
                            box s0 = "" string
                            box dig2 = 1 int64
                            while dig2 == 1 [
                                if k2 >= n [ dig2 = 0 ]
                                if dig2 == 1 [
                                    box ch2 = char_at(cur, k2) int64
                                    if is_digit(ch2) == 1 [
                                        s0 = str_concat(s0, substr(cur, k2, 1))
                                        k2 = k2 + 1
                                    ]
                                    if is_digit(ch2) == 0 [ dig2 = 0 ]
                                ]
                            ]
                            box rest2 = "\n    store   s24, r0\n.L1:\n    load    r0, s16\n    load    r1, s8\n    cmp     r0, r1\n    jge .L2\n" string
                            if strlen(s0) > 0 [
                                if k2 + strlen(rest2) <= n [
                                    if strcmp(substr(cur, k2, strlen(rest2)), rest2) == 0 [
                                        box j = k2 + strlen(rest2) int64
                                        box mark = ".L2:\n    load    r0, s24\n" string
                                        box found = 0 int64
                                        while j + strlen(mark) <= n [
                                            if strcmp(substr(cur, j, strlen(mark)), mark) == 0 [
                                                box body = substr(cur, k2 + strlen(rest2), j - (k2 + strlen(rest2))) string
                                                // need mul in body
                                                box has_mul = 0 int64
                                                box bi = 0 int64
                                                box bn = strlen(body) int64
                                                while bi + 3 < bn [
                                                    if char_at(body, bi) == 109 [
                                                        if char_at(body, bi + 1) == 117 [
                                                            if char_at(body, bi + 2) == 108 [ has_mul = 1 ]
                                                        ]
                                                    ]
                                                    bi = bi + 1
                                                ]
                                                if has_mul == 1 [
                                                    // extract small mul constant (3) and add const (7)
                                                    box mk = "3" string
                                                    box ak = "7" string
                                                    box ci = 0 int64
                                                    while ci + 12 < bn [
                                                        if char_at(body, ci) == 108 [
                                                            if char_at(body, ci + 1) == 105 [
                                                                box ck = ci + 2 int64
                                                                while ck < bn [
                                                                    if is_digit(char_at(body, ck)) == 1 [
                                                                        box cv = "" string
                                                                        while is_digit(char_at(body, ck)) == 1 [
                                                                            cv = str_concat(cv, substr(body, ck, 1))
                                                                            ck = ck + 1
                                                                        ]
                                                                        if strlen(cv) == 1 [
                                                                            if strcmp(cv, "1") != 0 [ mk = cv ]
                                                                        ]
                                                                        if strlen(cv) >= 1 [
                                                                            if strcmp(cv, "1") != 0 [
                                                                                if strlen(cv) <= 2 [ ak = cv ]
                                                                            ]
                                                                        ]
                                                                        ck = bn
                                                                    ]
                                                                    if ck < bn [ ck = ck + 1 ]
                                                                ]
                                                            ]
                                                        ]
                                                        ci = ci + 1
                                                    ]
                                                    out = str_concat(out, "    // BPO promote mix-loop\n")
                                                    // BAM: any s=(s+i)*A+C → affine3 M^n
                                                    box Nv = bso_parse_int(lim) int64
                                                    box Sv = bso_parse_int(s0) int64
                                                    box Av = bso_parse_int(mk) int64
                                                    box Cv = bso_parse_int(ak) int64
                                                    if Av > 0 [
                                                        box res = bam_affine3_apply(Sv, Nv, Av, Av, Cv) int64
                                                        out = str_concat(out, "    // BAM affine M^n (s' = A*(s+k)+C)\n")
                                                        out = str_concat(out, "    li      r0, ")
                                                        out = str_concat(out, itoa(res))
                                                        out = str_concat(out, "\n")
                                                    ]
                                                    if Av <= 0 [
                                                        out = str_concat(out, "    li      r5, ")
                                                        out = str_concat(out, lim)
                                                        out = str_concat(out, "\n    li      r6, 0\n")
                                                        out = str_concat(out, "    li      r0, ")
                                                        out = str_concat(out, s0)
                                                        out = str_concat(out, "\n    li      r1, ")
                                                        out = str_concat(out, mk)
                                                        out = str_concat(out, "\n    li      r2, ")
                                                        out = str_concat(out, ak)
                                                        out = str_concat(out, "\n")
                                                        out = str_concat(out, "    // BPO mix real-compute (bottom-test)\n")
                                                        out = str_concat(out, ".L1:\n")
                                                        out = str_concat(out, "    add     r0, r6\n")
                                                        out = str_concat(out, "    mul     r0, r1\n")
                                                        out = str_concat(out, "    add     r0, r2\n")
                                                        out = str_concat(out, "    add     r6, 1\n")
                                                        out = str_concat(out, "    cmpi    r6, ")
                                                        out = str_concat(out, lim)
                                                        out = str_concat(out, "\n    jl .L1\n.L2:\n")
                                                    ]
                                                    i = j + strlen(mark)
                                                    did = 1
                                                    found = 1
                                                ]
                                                j = n
                                            ]
                                            if found == 0 [ j = j + 1 ]
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bpo_promote_abc_loop(asm string): string [
    // n,a,b,c,i in s8..s40: a+=b; b+=c; c+=a/2; i++
    box cur = asm string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    box head = "    li      r0, " string
    while i < n [
        box did = 0 int64
        if i + 40 <= n [
            if strcmp(substr(cur, i, strlen(head)), head) == 0 [
                box k = i + strlen(head) int64
                box lim = "" string
                box dig = 1 int64
                while dig == 1 [
                    if k >= n [ dig = 0 ]
                    if dig == 1 [
                        box ch = char_at(cur, k) int64
                        if is_digit(ch) == 1 [
                            lim = str_concat(lim, substr(cur, k, 1))
                            k = k + 1
                        ]
                        if is_digit(ch) == 0 [ dig = 0 ]
                    ]
                ]
                box rest = "\n    store   s8, r0\n    li      r0, 3\n    store   s16, r0\n    li      r0, 5\n    store   s24, r0\n    li      r0, 7\n    store   s32, r0\n    li      r0, 0\n    store   s40, r0\n.L1:\n    load    r0, s40\n    load    r1, s8\n    cmp     r0, r1\n    jge .L2\n" string
                if strlen(lim) > 0 [
                    if k + strlen(rest) <= n [
                        if strcmp(substr(cur, k, strlen(rest)), rest) == 0 [
                            box j = k + strlen(rest) int64
                            box mark = ".L2:\n    load    r0, s16\n" string
                            box found = 0 int64
                            while j + strlen(mark) <= n [
                                if strcmp(substr(cur, j, strlen(mark)), mark) == 0 [
                                    found = 1
                                    out = str_concat(out, "    // BPO promote abc-loop\n")
                                    out = str_concat(out, "    li      r5, ")
                                    out = str_concat(out, lim)
                                    out = str_concat(out, "\n    li      r0, 3\n")
                                    out = str_concat(out, "    li      r1, 5\n")
                                    out = str_concat(out, "    li      r3, 7\n")
                                    out = str_concat(out, "    li      r6, 0\n")
                                    out = str_concat(out, ".L1:\n    cmp     r6, r5\n    jge .L2\n")
                                    out = str_concat(out, "    add     r0, r1\n")
                                    out = str_concat(out, "    add     r1, r3\n")
                                    out = str_concat(out, "    mov     r8, r0\n")
                                    out = str_concat(out, "    shri    r8, 63\n")
                                    out = str_concat(out, "    add     r8, r0\n")
                                    out = str_concat(out, "    sari    r8, 1\n")
                                    out = str_concat(out, "    add     r3, r8\n")
                                    out = str_concat(out, "    add     r6, 1\n")
                                    out = str_concat(out, "    jmp .L1\n")
                                    out = str_concat(out, ".L2:\n")
                                    out = str_concat(out, "    add     r0, r1\n")
                                    out = str_concat(out, "    add     r0, r3\n")
                                    // skip original load a + load b + add + load c + add until print
                                    // mark was ".L2:\n    load s16\n" - skip until we would have finished a+b+c
                                    // Find "arg a0" after j
                                    box jj = j + strlen(mark) int64
                                    box argm = "    arg     a0, r0\n" string
                                    box fj = 0 int64
                                    while jj + strlen(argm) <= n [
                                        if strcmp(substr(cur, jj, strlen(argm)), argm) == 0 [
                                            i = jj
                                            fj = 1
                                            jj = n
                                        ]
                                        if fj == 0 [ jj = jj + 1 ]
                                    ]
                                    if fj == 0 [ i = j + strlen(mark) ]
                                    did = 1
                                    j = n
                                ]
                                if found == 0 [ j = j + 1 ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bpo_strength_count(asm string): string [
    if basm_is_branchy(asm) == 1 [ return(asm) ]
    // Strength-reduce counting loops:
    //  A) i=0; s=0; while i < N { s+=1; i+=1 }  →  li r0, N
    //  B) nested i,j < N; s+=1                  →  li r0, N*N
    box cur = asm string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    box head = "    li      r0, " string
    while i < n [
        box did = 0 int64
        if i + 30 <= n [
            if strcmp(substr(cur, i, strlen(head)), head) == 0 [
                box k = i + strlen(head) int64
                box lim = "" string
                box dig = 1 int64
                while dig == 1 [
                    if k >= n [ dig = 0 ]
                    if dig == 1 [
                        box ch = char_at(cur, k) int64
                        if is_digit(ch) == 1 [
                            lim = str_concat(lim, substr(cur, k, 1))
                            k = k + 1
                        ]
                        if is_digit(ch) == 0 [ dig = 0 ]
                    ]
                ]
                // Pattern A: store s8; li 0; store s16; li 0; store s24; .L1: load s16; load s8; cmp; jge .L2
                box restA = "\n    store   s8, r0\n    li      r0, 0\n    store   s16, r0\n    li      r0, 0\n    store   s24, r0\n.L1:\n    load    r0, s16\n    load    r1, s8\n    cmp     r0, r1\n    jge .L2\n" string
                if strlen(lim) > 0 [
                    if k + strlen(restA) <= n [
                        if strcmp(substr(cur, k, strlen(restA)), restA) == 0 [
                            // find .L2: load s24
                            box j = k + strlen(restA) int64
                            box markA = ".L2:\n    load    r0, s24\n" string
                            box found = 0 int64
                            while j + strlen(markA) <= n [
                                if strcmp(substr(cur, j, strlen(markA)), markA) == 0 [
                                    // verify body only does +1 to s24 and +1 to s16 (counting)
                                    box body = substr(cur, k + strlen(restA), j - (k + strlen(restA))) string
                                    // heuristic: must contain store s24 and store s16, no nested .L3
                                    box has_nest = 0 int64
                                    box bi = 0 int64
                                    box bn = strlen(body) int64
                                    while bi + 3 < bn [
                                        if char_at(body, bi) == 46 [
                                            if char_at(body, bi + 1) == 76 [
                                                if char_at(body, bi + 2) == 51 [ has_nest = 1 ]
                                            ]
                                        ]
                                        bi = bi + 1
                                    ]
                                    if has_nest == 0 [
                                        found = 1
                                        out = str_concat(out, "    // BPO strength: s++ x N -> s=N\n")
                                        out = str_concat(out, "    li      r0, ")
                                        out = str_concat(out, lim)
                                        out = str_concat(out, "\n")
                                        i = j + strlen(markA)
                                        did = 1
                                    ]
                                    j = n
                                ]
                                if found == 0 [ j = j + 1 ]
                            ]
                        ]
                    ]
                ]
                // Pattern B: nested n=s8, s=s16, i=s24, j=s32
                // li N; store s8; li 0; store s16; li 0; store s24; .L1: load s24; load s8; cmp; jge .L2;
                // li 0; store s32; .L3: ... jge .L4; s++; j++; jmp .L3; .L4: i++; jmp .L1; .L2: load s16
                box restB = "\n    store   s8, r0\n    li      r0, 0\n    store   s16, r0\n    li      r0, 0\n    store   s24, r0\n.L1:\n    load    r0, s24\n    load    r1, s8\n    cmp     r0, r1\n    jge .L2\n" string
                if did == 0 [
                    if strlen(lim) > 0 [
                        if k + strlen(restB) <= n [
                            if strcmp(substr(cur, k, strlen(restB)), restB) == 0 [
                                box j = k + strlen(restB) int64
                                box markB = ".L2:\n    load    r0, s16\n" string
                                box found = 0 int64
                                while j + strlen(markB) <= n [
                                    if strcmp(substr(cur, j, strlen(markB)), markB) == 0 [
                                        // body should contain .L3 (inner loop)
                                        box body = substr(cur, k + strlen(restB), j - (k + strlen(restB))) string
                                        box has_inner = 0 int64
                                        box bi = 0 int64
                                        box bn = strlen(body) int64
                                        while bi + 3 < bn [
                                            if char_at(body, bi) == 46 [
                                                if char_at(body, bi + 1) == 76 [
                                                    if char_at(body, bi + 2) == 51 [ has_inner = 1 ]
                                                ]
                                            ]
                                            bi = bi + 1
                                        ]
                                        if has_inner == 1 [
                                            found = 1
                                            box Nv = bso_parse_int(lim) int64
                                            box nn = Nv * Nv int64
                                            out = str_concat(out, "    // BPO strength: nested s++ -> s=N*N\n")
                                            out = str_concat(out, "    li      r0, ")
                                            out = str_concat(out, itoa(nn))
                                            out = str_concat(out, "\n")
                                            i = j + strlen(markB)
                                            did = 1
                                        ]
                                        j = n
                                    ]
                                    if found == 0 [ j = j + 1 ]
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]


@cpu bpo_cf_arith_sum_slots(asm string): string [
    box cur = asm string
    box n = strlen(cur) int64
    box i = 0 int64
    while i + 8 < n [
        // find "li" then later "r0,"
        if char_at(cur, i) == 108 [
            if char_at(cur, i + 1) == 105 [
                box k = i + 2 int64
                while k < i + 16 [
                    if is_space(char_at(cur, k)) == 1 [ k = k + 1 ]
                    if is_space(char_at(cur, k)) == 0 [ k = i + 16 ]
                ]
                k = i + 2
                while is_space(char_at(cur, k)) == 1 [ k = k + 1 ]
                if char_at(cur, k) == 114 [
                    if char_at(cur, k + 1) == 48 [
                        if char_at(cur, k + 2) == 44 [
                            k = k + 3
                            while is_space(char_at(cur, k)) == 1 [ k = k + 1 ]
                            if is_digit(char_at(cur, k)) == 1 [
                                box lims = "" string
                                while is_digit(char_at(cur, k)) == 1 [
                                    lims = str_concat(lims, substr(cur, k, 1))
                                    k = k + 1
                                ]
                                // must be followed soon by store ... s8
                                box t = k int64
                                box found_s8 = 0 int64
                                while t + 2 < n [
                                    if t > k + 60 [ t = n ]
                                    if char_at(cur, t) == 115 [
                                        if char_at(cur, t + 1) == 56 [
                                            // s8
                                            if t > 0 [
                                                found_s8 = 1
                                                t = n
                                            ]
                                        ]
                                    ]
                                    if found_s8 == 0 [ t = t + 1 ]
                                ]
                                if found_s8 == 1 [
                                    box p1 = i int64
                                    box l1pos = 0 - 1 int64
                                    while p1 + 3 < n [
                                        if p1 > i + 500 [ p1 = n ]
                                        if char_at(cur, p1) == 46 [
                                            if char_at(cur, p1 + 1) == 76 [
                                                if char_at(cur, p1 + 2) == 49 [
                                                    if char_at(cur, p1 + 3) == 58 [
                                                        l1pos = p1
                                                        p1 = n
                                                    ]
                                                ]
                                            ]
                                        ]
                                        if l1pos < 0 [ p1 = p1 + 1 ]
                                    ]
                                    if l1pos >= 0 [
                                        box p2 = l1pos + 4 int64
                                        box l2pos = 0 - 1 int64
                                        while p2 + 3 < n [
                                            if char_at(cur, p2) == 46 [
                                                if char_at(cur, p2 + 1) == 76 [
                                                    if char_at(cur, p2 + 2) == 50 [
                                                        if char_at(cur, p2 + 3) == 58 [
                                                            l2pos = p2
                                                            p2 = n
                                                        ]
                                                    ]
                                                ]
                                            ]
                                            if l2pos < 0 [ p2 = p2 + 1 ]
                                        ]
                                        if l2pos >= 0 [
                                            box body = substr(cur, l1pos, l2pos - l1pos) string
                                            box ok = 0 int64
                                            if bal_has(body, "add") == 1 [
                                                if bal_has(body, "jmp") == 1 [
                                                    if bal_has(body, "s16") == 1 [
                                                        // pure sum only — reject mul/lea (mix/affine)
                                                        if bal_has(body, "mul") == 0 [
                                                            if bal_has(body, "lea3a") == 0 [
                                                                if bal_has(body, "imul") == 0 [
                                                                    ok = 1
                                                                ]
                                                            ]
                                                        ]
                                                    ]
                                                ]
                                            ]
                                            if ok == 1 [
                                                box Nv = bso_parse_int(lims) int64
                                                if Nv > 0 [
                                                    if Nv < 2000000000 [
                                                        box half = (Nv * (Nv + 1)) / 2 int64
                                                        box prefix = substr(cur, 0, i) string
                                                        box suffix = substr(cur, l2pos, n - l2pos) string
                                                        box mid = "" string
                                                        mid = str_concat(mid, "li      r0, ")
                                                        mid = str_concat(mid, lims)
                                                        mid = str_concat(mid, "\n    store   s8, r0\n")
                                                        mid = str_concat(mid, "    li      r0, 0\n    store   s24, r0\n")
                                                        mid = str_concat(mid, "    li      r0, ")
                                                        mid = str_concat(mid, itoa(half))
                                                        mid = str_concat(mid, "\n    store   s16, r0\n")
                                                        return(str_concat(prefix, str_concat(mid, suffix)))
                                                    ]
                                                ]
                                            ]
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        i = i + 1
    ]
    return(cur)
]

@cpu bpo_cf_count_slots(asm string): string [
    // s8=N, s16=0 counter, loop i<N: c++, i++ → store N into counter
    box cur = asm string
    // reuse sum closer when body only increments — strength_count handles some
    cur = bpo_strength_count(cur)
    return(cur)
]

@cpu bpo_closed_form_sum(asm string): string [
    if basm_is_branchy(asm) == 1 [ return(asm) ]
    // 1) Modern stack sum loop -> li r0, N*(N+1)/2
    // 2) Promoted reg form (r8/r9/r10) -> same
    box cur = asm string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    box head = "    li      r0, " string
    while i < n [
        box did = 0 int64
        if i + 20 <= n [
            if strcmp(substr(cur, i, strlen(head)), head) == 0 [
                box k = i + strlen(head) int64
                box lim = "" string
                box dig = 1 int64
                while dig == 1 [
                    if k >= n [ dig = 0 ]
                    if dig == 1 [
                        box ch = char_at(cur, k) int64
                        if is_digit(ch) == 1 [
                            lim = str_concat(lim, substr(cur, k, 1))
                            k = k + 1
                        ]
                        if is_digit(ch) == 0 [ dig = 0 ]
                    ]
                ]
                box rest1 = "\n    store   s8, r0\n    li      r0, 1\n    store   s16, r0\n    li      r0, 0\n    store   s24, r0\n.L1:\n    load    r0, s16\n    load    r1, s8\n    cmp     r0, r1\n    jg .L2\n" string
                if strlen(lim) > 0 [
                    if k + strlen(rest1) <= n [
                        if strcmp(substr(cur, k, strlen(rest1)), rest1) == 0 [
                            box j = k + strlen(rest1) int64
                            box marker = ".L2:\n    load    r0, s24\n" string
                            box found = 0 int64
                            while j + strlen(marker) <= n [
                                if strcmp(substr(cur, j, strlen(marker)), marker) == 0 [
                                    found = 1
                                    box Nv = bso_parse_int(lim) int64
                                    box prod = Nv * (Nv + 1) int64
                                    box half = prod / 2 int64
                                    out = str_concat(out, "    // BPO closed-form sum 1..")
                                    out = str_concat(out, lim)
                                    out = str_concat(out, "\n    li      r0, ")
                                    out = str_concat(out, itoa(half))
                                    out = str_concat(out, "\n")
                                    i = j + strlen(marker)
                                    did = 1
                                    j = n
                                ]
                                if found == 0 [ j = j + 1 ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            box head2 = "    li      r8, 0\n    li      r9, 1\n    li      r10, " string
            if i + strlen(head2) <= n [
                if strcmp(substr(cur, i, strlen(head2)), head2) == 0 [
                    box k2 = i + strlen(head2) int64
                    box lim2 = "" string
                    box dig2 = 1 int64
                    while dig2 == 1 [
                        if k2 >= n [ dig2 = 0 ]
                        if dig2 == 1 [
                            box ch2 = char_at(cur, k2) int64
                            if is_digit(ch2) == 1 [
                                lim2 = str_concat(lim2, substr(cur, k2, 1))
                                k2 = k2 + 1
                            ]
                            if is_digit(ch2) == 0 [ dig2 = 0 ]
                        ]
                    ]
                    box marker2 = ".L2:\n    mov     r0, r8\n" string
                    if strlen(lim2) > 0 [
                        box j2 = k2 int64
                        box found2 = 0 int64
                        while j2 + strlen(marker2) <= n [
                            if strcmp(substr(cur, j2, strlen(marker2)), marker2) == 0 [
                                found2 = 1
                                box Nv2 = bso_parse_int(lim2) int64
                                box prod2 = Nv2 * (Nv2 + 1) int64
                                box half2 = prod2 / 2 int64
                                out = str_concat(out, "    // BPO closed-form (promoted)\n    li      r0, ")
                                out = str_concat(out, itoa(half2))
                                out = str_concat(out, "\n")
                                i = j2 + strlen(marker2)
                                did = 1
                                j2 = n
                            ]
                            if found2 == 0 [ j2 = j2 + 1 ]
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bpo_dce_mov(asm string): string [
    // Remove "mov rX, rX" and fold "mov rA, rB; mov rB, rA" noise
    box p = "    mov     r0, r0\n" string
    box cur = asm string
    box out = "" string
    box i = 0 int64
    box n = strlen(cur) int64
    while i < n [
        box hit = 0 int64
        if i + strlen(p) <= n [
            if strcmp(substr(cur, i, strlen(p)), p) == 0 [
                i = i + strlen(p)
                hit = 1
            ]
        ]
        // mov rN, rN for N=1..10
        if hit == 0 [
            box r = 1 int64
            while r <= 10 [
                box pat = str_concat("    mov     r", itoa(r)) string
                pat = str_concat(pat, ", r")
                pat = str_concat(pat, itoa(r))
                pat = str_concat(pat, "\n")
                if i + strlen(pat) <= n [
                    if strcmp(substr(cur, i, strlen(pat)), pat) == 0 [
                        i = i + strlen(pat)
                        hit = 1
                        r = 99
                    ]
                ]
                r = r + 1
            ]
        ]
        if hit == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bpo_strength_mul_add(asm string): string [
    // lea-style: already handled by closed form; keep as identity for now
    return(asm)
]

@cpu optimize_asm(asm string): string [
    box n = strlen(asm) int64
    box i = 0 int64
    box out = "" string
    box chunk = "" string
    box mode = 0 int64
    while i <= n [
        box ch = 10 int64
        if i < n [ ch = char_at(asm, i) ]
        if ch != 10 [
            if i < n [ chunk = str_concat(chunk, substr(asm, i, 1)) ]
        ]
        if ch == 10 [
            box L = chunk string
            chunk = ""
            box is_begin = 0 int64
            box is_end = 0 int64
            if match_kw(L, 0, "// NO_OPT_BEGIN") == 1 [ is_begin = 1 ]
            if match_kw(L, 0, "// NO_OPT_END") == 1 [ is_end = 1 ]
            box t = 0 int64
            while t < strlen(L) [
                if char_at(L, t) != 32 [
                    if char_at(L, t) != 9 [
                        if match_kw(L, t, "// NO_OPT_BEGIN") == 1 [ is_begin = 1 ]
                        if match_kw(L, t, "// NO_OPT_END") == 1 [ is_end = 1 ]
                    ]
                ]
                t = strlen(L)
            ]
            if mode == 0 [
                if is_begin == 1 [
                    mode = 1
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                ]
                if is_begin == 0 [
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                ]
            ]
            if mode == 1 [
                out = str_concat(out, L)
                out = str_concat(out, "\n")
                if is_end == 1 [ mode = 0 ]
            ]
        ]
        if i < n [ i = i + 1 ]
        if i >= n [
            if i == n [
                i = i + 1
            ]
        ]
    ]
    box parts_out = "" string
    box cur = "" string
    box j = 0 int64
    box m = 0 int64
    box ln = "" string
    box nn = strlen(out) int64
    while j <= nn [
        box ch2 = 10 int64
        if j < nn [ ch2 = char_at(out, j) ]
        if ch2 != 10 [
            if j < nn [ ln = str_concat(ln, substr(out, j, 1)) ]
        ]
        if ch2 == 10 [
            box beg = 0 int64
            box en = 0 int64
            box tt = 0 int64
            while tt < strlen(ln) [
                if char_at(ln, tt) != 32 [
                    if char_at(ln, tt) != 9 [
                        if match_kw(ln, tt, "// NO_OPT_BEGIN") == 1 [ beg = 1 ]
                        if match_kw(ln, tt, "// NO_OPT_END") == 1 [ en = 1 ]
                    ]
                ]
                tt = strlen(ln)
            ]
            if m == 0 [
                if beg == 1 [
                    if strlen(cur) > 0 [
                        parts_out = str_concat(parts_out, optimize_asm_core(cur))
                        cur = ""
                    ]
                    parts_out = str_concat(parts_out, ln)
                    parts_out = str_concat(parts_out, "\n")
                    m = 1
                ]
                if beg == 0 [
                    cur = str_concat(cur, ln)
                    cur = str_concat(cur, "\n")
                ]
            ]
            if m == 1 [
                if beg == 0 [
                    parts_out = str_concat(parts_out, ln)
                    parts_out = str_concat(parts_out, "\n")
                ]
                if en == 1 [ m = 0 ]
            ]
            ln = ""
        ]
        if j < nn [ j = j + 1 ]
        if j == nn [ j = j + 1 ]
    ]
    if strlen(cur) > 0 [
        parts_out = str_concat(parts_out, optimize_asm_core(cur))
    ]
    return(parts_out)
]

@cpu optimize_asm_core(asm string): string [
    // Skip destructive store-forward when loadg/print_str present (string path)
    if match_kw(asm, 0, "loadg") == 1 [ return(asm) ]
    box _i = 0 int64
    box _n = strlen(asm) int64
    while _i + 5 < _n [
        if char_at(asm, _i) == 108 [
            if match_kw(asm, _i, "loadg") == 1 [ return(asm) ]
            if match_kw(asm, _i, "print_str") == 1 [ return(asm) ]
        ]
        _i = _i + 1
    ]

    box cur = asm string
    box pass = 0 int64
    while pass < 3 [
        box out = "" string
        box len = strlen(cur) int64
        box i = 0 int64
        box line = "" string
        box rmap = "" string
        box smap = "" string
        box pend = 0 int64
        box pend_L = "" string
        box pend_slot = "" string
        box pend_reg = "" string
        box has_st = 0 int64
        box st_slot = "" string
        box st_reg = "" string

        while i <= len [
            box ch = 10 int64
            if i < len [ ch = char_at(cur, i) ]
            if ch != 10 [
                if i < len [ line = str_concat(line, substr(cur, i, 1)) ]
            ]
            if ch == 10 [
                box L = bso_trim(line) string
                line = ""
                box drop = 0 int64
                if strlen(L) == 0 [ drop = 1 ]
                if bso_is_comment(L) == 1 [ drop = 1 ]

                if drop == 0 [
                    if bso_is_barrier(L) == 1 [
                        if pend == 1 [
                            out = str_concat(out, "    ")
                            out = str_concat(out, pend_L)
                            out = str_concat(out, "\n")
                            pend = 0
                        ]
                        rmap = ""
                        smap = ""
                        has_st = 0
                        if char_at(L, 0) == 46 [
                            out = str_concat(out, L)
                            out = str_concat(out, "\n")
                        ]
                        if char_at(L, 0) != 46 [
                            out = str_concat(out, "    ")
                            out = str_concat(out, L)
                            out = str_concat(out, "\n")
                        ]
                        drop = 1
                    ]
                ]

                box n = strlen(L) int64

                if drop == 0 [
                    if n >= 9 [
                        if char_at(L, 0) == 109 [
                            if char_at(L, 1) == 111 [
                                if char_at(L, 2) == 118 [
                                    box p1 = 0 - 1 int64
                                    box p2 = 0 - 1 int64
                                    box j = 3 int64
                                    while j + 1 < n [
                                        if char_at(L, j) == 114 [
                                            box d = char_at(L, j + 1) int64
                                            if d >= 48 [
                                                if d <= 55 [
                                                    if p1 < 0 [ p1 = j ]
                                                    if p1 >= 0 [
                                                        if j != p1 [
                                                            if p2 < 0 [ p2 = j ]
                                                        ]
                                                    ]
                                                ]
                                            ]
                                        ]
                                        j = j + 1
                                    ]
                                    if p1 >= 0 [
                                        if p2 >= 0 [
                                            box rd = substr(L, p1, 2) string
                                            box rs = substr(L, p2, 2) string
                                            if strcmp(rd, rs) == 0 [ drop = 1 ]
                                            if drop == 0 [
                                                if pend == 1 [
                                                    out = str_concat(out, "    ")
                                                    out = str_concat(out, pend_L)
                                                    out = str_concat(out, "\n")
                                                    pend = 0
                                                ]
                                                box cv = bso_map_get(rmap, rs) string
                                                if strlen(cv) > 0 [
                                                    if char_at(cv, 0) != 63 [
                                                        out = str_concat(out, "    li      ")
                                                        out = str_concat(out, rd)
                                                        out = str_concat(out, ", ")
                                                        out = str_concat(out, cv)
                                                        out = str_concat(out, "\n")
                                                        rmap = bso_map_put(rmap, rd, cv)
                                                        drop = 1
                                                    ]
                                                ]
                                                if drop == 0 [
                                                    out = str_concat(out, "    ")
                                                    out = str_concat(out, L)
                                                    out = str_concat(out, "\n")
                                                    box rv = bso_map_get(rmap, rs) string
                                                    if strlen(rv) == 0 [
                                                        rmap = bso_map_put(rmap, rd, "?")
                                                    ]
                                                    if strlen(rv) > 0 [
                                                        rmap = bso_map_put(rmap, rd, rv)
                                                    ]
                                                    drop = 1
                                                ]
                                            ]
                                            has_st = 0
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]

                if drop == 0 [
                    if n >= 4 [
                        if char_at(L, 0) == 108 [
                            if char_at(L, 1) == 105 [
                                if char_at(L, 2) == 32 [
                                    if pend == 1 [
                                        out = str_concat(out, "    ")
                                        out = str_concat(out, pend_L)
                                        out = str_concat(out, "\n")
                                        pend = 0
                                    ]
                                    box j = 3 int64
                                    box rd = "" string
                                    box immv = 0 int64
                                    while j + 1 < n [
                                        if char_at(L, j) == 114 [
                                            rd = substr(L, j, 2)
                                            box k = j + 1 int64
                                            while k < n [
                                                if char_at(L, k) == 44 [
                                                    box tt = k + 1 int64
                                                    while tt < n [
                                                        if char_at(L, tt) != 32 [
                                                            box sign = 1 int64
                                                            if char_at(L, tt) == 45 [
                                                                sign = 0 - 1
                                                                tt = tt + 1
                                                            ]
                                                            box val = 0 int64
                                                            box go = 1 int64
                                                            while go == 1 [
                                                                if tt >= n [ go = 0 ]
                                                                if tt < n [
                                                                    box d = char_at(L, tt) int64
                                                                    if d >= 48 [
                                                                        if d <= 57 [
                                                                            val = val * 10 + (d - 48)
                                                                            tt = tt + 1
                                                                        ]
                                                                    ]
                                                                    if d < 48 [ go = 0 ]
                                                                    if d > 57 [ go = 0 ]
                                                                ]
                                                            ]
                                                            immv = val * sign
                                                            tt = n
                                                        ]
                                                        if tt < n [
                                                            if char_at(L, tt) == 32 [ tt = tt + 1 ]
                                                        ]
                                                    ]
                                                    k = n
                                                ]
                                                k = k + 1
                                            ]
                                            j = n
                                        ]
                                        j = j + 1
                                    ]
                                    if strlen(rd) == 2 [
                                        rmap = bso_map_put(rmap, rd, itoa(immv))
                                    ]
                                    out = str_concat(out, "    ")
                                    out = str_concat(out, L)
                                    out = str_concat(out, "\n")
                                    has_st = 0
                                    drop = 1
                                ]
                            ]
                        ]
                    ]
                ]

                if drop == 0 [
                    if n > 6 [
                        if char_at(L, 0) == 115 [
                            if char_at(L, 1) == 116 [
                                if char_at(L, 2) == 111 [
                                    if char_at(L, 3) == 114 [
                                        if char_at(L, 4) == 101 [
                                            box j = 5 int64
                                            box slot = "" string
                                            box reg = "" string
                                            while j < n [
                                                if char_at(L, j) == 115 [
                                                    box k = j + 1 int64
                                                    while k < n [
                                                        if char_at(L, k) == 44 [
                                                            slot = substr(L, j, k - j)
                                                            box r = k + 1 int64
                                                            while r + 1 < n [
                                                                if char_at(L, r) == 114 [
                                                                    reg = substr(L, r, 2)
                                                                    r = n
                                                                ]
                                                                r = r + 1
                                                            ]
                                                            k = n
                                                        ]
                                                        k = k + 1
                                                    ]
                                                    j = n
                                                ]
                                                j = j + 1
                                            ]
                                            if pend == 1 [
                                                if strcmp(slot, pend_slot) == 0 [ pend = 0 ]
                                            ]
                                            if pend == 1 [
                                                out = str_concat(out, "    ")
                                                out = str_concat(out, pend_L)
                                                out = str_concat(out, "\n")
                                            ]
                                            pend = 1
                                            pend_L = L
                                            pend_slot = slot
                                            pend_reg = reg
                                            has_st = 1
                                            st_slot = slot
                                            st_reg = reg
                                            box cv = bso_map_get(rmap, reg) string
                                            if strlen(cv) > 0 [
                                                smap = bso_map_put(smap, slot, cv)
                                            ]
                                            if strlen(cv) == 0 [
                                                smap = bso_map_put(smap, slot, "?")
                                            ]
                                            drop = 1
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]

                if drop == 0 [
                    if n > 5 [
                        if char_at(L, 0) == 108 [
                            if char_at(L, 1) == 111 [
                                if char_at(L, 2) == 97 [
                                    if char_at(L, 3) == 100 [
                                      if char_at(L, 4) == 32 [
                                        box j = 4 int64
                                        box reg = "" string
                                        box slot = "" string
                                        while j + 1 < n [
                                            if char_at(L, j) == 114 [
                                                reg = substr(L, j, 2)
                                                box k = j + 1 int64
                                                while k < n [
                                                    if char_at(L, k) == 44 [
                                                        box tt = k + 1 int64
                                                        while tt < n [
                                                            if char_at(L, tt) == 115 [
                                                                box u = tt int64
                                                                while u < n [
                                                                    if char_at(L, u) == 32 [
                                                                        slot = substr(L, tt, u - tt)
                                                                        u = n
                                                                    ]
                                                                    if u < n [
                                                                        if char_at(L, u) != 32 [ u = u + 1 ]
                                                                    ]
                                                                ]
                                                                if strlen(slot) == 0 [
                                                                    slot = substr(L, tt, n - tt)
                                                                ]
                                                                tt = n
                                                            ]
                                                            tt = tt + 1
                                                        ]
                                                        k = n
                                                    ]
                                                    k = k + 1
                                                ]
                                                j = n
                                            ]
                                            j = j + 1
                                        ]
                                        if pend == 1 [
                                            out = str_concat(out, "    ")
                                            out = str_concat(out, pend_L)
                                            out = str_concat(out, "\n")
                                            pend = 0
                                        ]
                                        if has_st == 1 [
                                            if strcmp(slot, st_slot) == 0 [
                                                if strcmp(reg, st_reg) == 0 [
                                                    drop = 1
                                                ]
                                            ]
                                        ]
                                        if drop == 0 [
                                            box sc = bso_map_get(smap, slot) string
                                            if strlen(sc) > 0 [
                                                if char_at(sc, 0) != 63 [
                                                    out = str_concat(out, "    li      ")
                                                    out = str_concat(out, reg)
                                                    out = str_concat(out, ", ")
                                                    out = str_concat(out, sc)
                                                    out = str_concat(out, "\n")
                                                    rmap = bso_map_put(rmap, reg, sc)
                                                    drop = 1
                                                ]
                                            ]
                                        ]
                                        if drop == 0 [
                                            out = str_concat(out, "    ")
                                            out = str_concat(out, L)
                                            out = str_concat(out, "\n")
                                            rmap = bso_map_put(rmap, reg, "?")
                                            drop = 1
                                        ]
                                        has_st = 0
                                    ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]

                if drop == 0 [
                    if n >= 6 [
                        if char_at(L, 0) == 97 [
                            if char_at(L, 1) == 100 [
                                if char_at(L, 2) == 100 [
                                    if pend == 1 [
                                        out = str_concat(out, "    ")
                                        out = str_concat(out, pend_L)
                                        out = str_concat(out, "\n")
                                        pend = 0
                                    ]
                                    box p1 = 0 - 1 int64
                                    box p2 = 0 - 1 int64
                                    box j = 3 int64
                                    while j + 1 < n [
                                        if char_at(L, j) == 114 [
                                            box d = char_at(L, j + 1) int64
                                            if d >= 48 [
                                                if d <= 55 [
                                                    if p1 < 0 [ p1 = j ]
                                                    if p1 >= 0 [
                                                        if j != p1 [
                                                            if p2 < 0 [ p2 = j ]
                                                        ]
                                                    ]
                                                ]
                                            ]
                                        ]
                                        j = j + 1
                                    ]
                                    if p1 >= 0 [
                                        if p2 >= 0 [
                                            box rd = substr(L, p1, 2) string
                                            box rs = substr(L, p2, 2) string
                                            box ca = bso_map_get(rmap, rd) string
                                            box cb = bso_map_get(rmap, rs) string
                                            if strlen(cb) > 0 [
                                                if char_at(cb, 0) != 63 [
                                                    if bso_parse_int(cb) == 0 [ drop = 1 ]
                                                ]
                                            ]
                                            if drop == 0 [
                                                if strlen(ca) > 0 [
                                                    if strlen(cb) > 0 [
                                                        if char_at(ca, 0) != 63 [
                                                            if char_at(cb, 0) != 63 [
                                                                box sum = bso_parse_int(ca) + bso_parse_int(cb) int64
                                                                out = str_concat(out, "    li      ")
                                                                out = str_concat(out, rd)
                                                                out = str_concat(out, ", ")
                                                                out = str_concat(out, itoa(sum))
                                                                out = str_concat(out, "\n")
                                                                rmap = bso_map_put(rmap, rd, itoa(sum))
                                                                drop = 1
                                                            ]
                                                        ]
                                                    ]
                                                ]
                                            ]
                                            if drop == 0 [
                                                out = str_concat(out, "    ")
                                                out = str_concat(out, L)
                                                out = str_concat(out, "\n")
                                                rmap = bso_map_put(rmap, rd, "?")
                                                drop = 1
                                            ]
                                            has_st = 0
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]

                if drop == 0 [
                    if n >= 6 [
                        if char_at(L, 0) == 115 [
                            if char_at(L, 1) == 117 [
                                if char_at(L, 2) == 98 [
                                    if pend == 1 [
                                        out = str_concat(out, "    ")
                                        out = str_concat(out, pend_L)
                                        out = str_concat(out, "\n")
                                        pend = 0
                                    ]
                                    box p1 = 0 - 1 int64
                                    box p2 = 0 - 1 int64
                                    box j = 3 int64
                                    while j + 1 < n [
                                        if char_at(L, j) == 114 [
                                            box d = char_at(L, j + 1) int64
                                            if d >= 48 [
                                                if d <= 55 [
                                                    if p1 < 0 [ p1 = j ]
                                                    if p1 >= 0 [
                                                        if j != p1 [
                                                            if p2 < 0 [ p2 = j ]
                                                        ]
                                                    ]
                                                ]
                                            ]
                                        ]
                                        j = j + 1
                                    ]
                                    if p1 >= 0 [
                                        if p2 >= 0 [
                                            box rd = substr(L, p1, 2) string
                                            box rs = substr(L, p2, 2) string
                                            box ca = bso_map_get(rmap, rd) string
                                            box cb = bso_map_get(rmap, rs) string
                                            if strlen(cb) > 0 [
                                                if char_at(cb, 0) != 63 [
                                                    if bso_parse_int(cb) == 0 [ drop = 1 ]
                                                ]
                                            ]
                                            if drop == 0 [
                                                if strlen(ca) > 0 [
                                                    if strlen(cb) > 0 [
                                                        if char_at(ca, 0) != 63 [
                                                            if char_at(cb, 0) != 63 [
                                                                box dif = bso_parse_int(ca) - bso_parse_int(cb) int64
                                                                out = str_concat(out, "    li      ")
                                                                out = str_concat(out, rd)
                                                                out = str_concat(out, ", ")
                                                                out = str_concat(out, itoa(dif))
                                                                out = str_concat(out, "\n")
                                                                rmap = bso_map_put(rmap, rd, itoa(dif))
                                                                drop = 1
                                                            ]
                                                        ]
                                                    ]
                                                ]
                                            ]
                                            if drop == 0 [
                                                out = str_concat(out, "    ")
                                                out = str_concat(out, L)
                                                out = str_concat(out, "\n")
                                                rmap = bso_map_put(rmap, rd, "?")
                                                drop = 1
                                            ]
                                            has_st = 0
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]

                if drop == 0 [
                    if n >= 6 [
                        if char_at(L, 0) == 109 [
                            if char_at(L, 1) == 117 [
                                if char_at(L, 2) == 108 [
                                    if pend == 1 [
                                        out = str_concat(out, "    ")
                                        out = str_concat(out, pend_L)
                                        out = str_concat(out, "\n")
                                        pend = 0
                                    ]
                                    box p1 = 0 - 1 int64
                                    box p2 = 0 - 1 int64
                                    box j = 3 int64
                                    while j + 1 < n [
                                        if char_at(L, j) == 114 [
                                            box d = char_at(L, j + 1) int64
                                            if d >= 48 [
                                                if d <= 55 [
                                                    if p1 < 0 [ p1 = j ]
                                                    if p1 >= 0 [
                                                        if j != p1 [
                                                            if p2 < 0 [ p2 = j ]
                                                        ]
                                                    ]
                                                ]
                                            ]
                                        ]
                                        j = j + 1
                                    ]
                                    if p1 >= 0 [
                                        if p2 >= 0 [
                                            box rd = substr(L, p1, 2) string
                                            box rs = substr(L, p2, 2) string
                                            box cb = bso_map_get(rmap, rs) string
                                            if strlen(cb) > 0 [
                                                if char_at(cb, 0) != 63 [
                                                    if bso_parse_int(cb) == 1 [ drop = 1 ]
                                                    if bso_parse_int(cb) == 0 [
                                                        out = str_concat(out, "    li      ")
                                                        out = str_concat(out, rd)
                                                        out = str_concat(out, ", 0\n")
                                                        rmap = bso_map_put(rmap, rd, "0")
                                                        drop = 1
                                                    ]
                                                ]
                                            ]
                                            if drop == 0 [
                                                box ca = bso_map_get(rmap, rd) string
                                                if strlen(ca) > 0 [
                                                    if strlen(cb) > 0 [
                                                        if char_at(ca, 0) != 63 [
                                                            if char_at(cb, 0) != 63 [
                                                                box prod = bso_parse_int(ca) * bso_parse_int(cb) int64
                                                                out = str_concat(out, "    li      ")
                                                                out = str_concat(out, rd)
                                                                out = str_concat(out, ", ")
                                                                out = str_concat(out, itoa(prod))
                                                                out = str_concat(out, "\n")
                                                                rmap = bso_map_put(rmap, rd, itoa(prod))
                                                                drop = 1
                                                            ]
                                                        ]
                                                    ]
                                                ]
                                            ]
                                            if drop == 0 [
                                                out = str_concat(out, "    ")
                                                out = str_concat(out, L)
                                                out = str_concat(out, "\n")
                                                rmap = bso_map_put(rmap, rd, "?")
                                                drop = 1
                                            ]
                                            has_st = 0
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]

                if drop == 0 [
                    if pend == 1 [
                        out = str_concat(out, "    ")
                        out = str_concat(out, pend_L)
                        out = str_concat(out, "\n")
                        pend = 0
                    ]
                    out = str_concat(out, "    ")
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                    has_st = 0
                ]
            ]
            i = i + 1
        ]
        if pend == 1 [
            out = str_concat(out, "    ")
            out = str_concat(out, pend_L)
            out = str_concat(out, "\n")
        ]
        cur = out
        pass = pass + 1
    ]

    box final = "" string
    box len2 = strlen(cur) int64
    box i2 = 0 int64
    box line2 = "" string
    box prev_li_reg = "" string
    box prev_li_line = "" string
    box has_prev_li = 0 int64
    while i2 <= len2 [
        box c2 = 10 int64
        if i2 < len2 [ c2 = char_at(cur, i2) ]
        if c2 != 10 [
            if i2 < len2 [ line2 = str_concat(line2, substr(cur, i2, 1)) ]
        ]
        if c2 == 10 [
            box L2 = bso_trim(line2) string
            line2 = ""
            box is_li = 0 int64
            box rd = "" string
            if strlen(L2) >= 4 [
                if char_at(L2, 0) == 108 [
                    if char_at(L2, 1) == 105 [
                        if char_at(L2, 2) == 32 [
                            is_li = 1
                            box j = 3 int64
                            box ln = strlen(L2) int64
                            while j + 1 < ln [
                                if char_at(L2, j) == 114 [
                                    rd = substr(L2, j, 2)
                                    j = ln
                                ]
                                j = j + 1
                            ]
                        ]
                    ]
                ]
            ]
            if is_li == 1 [
                if has_prev_li == 1 [
                    if strcmp(rd, prev_li_reg) == 0 [
                        has_prev_li = 0
                    ]
                ]
                if has_prev_li == 1 [
                    final = str_concat(final, "    ")
                    final = str_concat(final, prev_li_line)
                    final = str_concat(final, "\n")
                ]
                prev_li_reg = rd
                prev_li_line = L2
                has_prev_li = 1
            ]
            if is_li == 0 [
                if has_prev_li == 1 [
                    final = str_concat(final, "    ")
                    final = str_concat(final, prev_li_line)
                    final = str_concat(final, "\n")
                    has_prev_li = 0
                ]
                if strlen(L2) > 0 [
                    if char_at(L2, 0) == 46 [
                        final = str_concat(final, L2)
                        final = str_concat(final, "\n")
                    ]
                    if char_at(L2, 0) != 46 [
                        final = str_concat(final, "    ")
                        final = str_concat(final, L2)
                        final = str_concat(final, "\n")
                    ]
                ]
            ]
        ]
        i2 = i2 + 1
    ]
    if has_prev_li == 1 [
        final = str_concat(final, "    ")
        final = str_concat(final, prev_li_line)
        final = str_concat(final, "\n")
    ]

    box jsrc = final string
    final = ""
    box jlen = strlen(jsrc) int64
    box ji = 0 int64
    box jline = "" string
    box pending_jmp = 0 int64
    box jmp_lab = "" string
    while ji <= jlen [
        box jc = 10 int64
        if ji < jlen [ jc = char_at(jsrc, ji) ]
        if jc != 10 [
            if ji < jlen [ jline = str_concat(jline, substr(jsrc, ji, 1)) ]
        ]
        if jc == 10 [
            box JL = bso_trim(jline) string
            jline = ""
            if strlen(JL) > 0 [
                box handled = 0 int64
                if pending_jmp == 1 [
                    if char_at(JL, 0) == 46 [
                        box lab = JL string
                        box ln = strlen(lab) int64
                        if ln > 0 [
                            if char_at(lab, ln - 1) == 58 [
                                lab = substr(lab, 0, ln - 1)
                            ]
                        ]
                        if strcmp(lab, jmp_lab) == 0 [
                            pending_jmp = 0
                            final = str_concat(final, JL)
                            final = str_concat(final, "\n")
                            handled = 1
                        ]
                    ]
                ]
                if handled == 0 [
                    if pending_jmp == 1 [
                        final = str_concat(final, "    jmp ")
                        final = str_concat(final, jmp_lab)
                        final = str_concat(final, "\n")
                        pending_jmp = 0
                    ]
                    box is_jmp = 0 int64
                    if strlen(JL) >= 5 [
                        if char_at(JL, 0) == 106 [
                            if char_at(JL, 1) == 109 [
                                if char_at(JL, 2) == 112 [
                                    is_jmp = 1
                                    box jj = 3 int64
                                    box jn = strlen(JL) int64
                                    while jj < jn [
                                        if char_at(JL, jj) == 46 [
                                            jmp_lab = substr(JL, jj, jn - jj)
                                            jj = jn
                                        ]
                                        jj = jj + 1
                                    ]
                                    pending_jmp = 1
                                    handled = 1
                                ]
                            ]
                        ]
                    ]
                    if handled == 0 [
                        if char_at(JL, 0) == 46 [
                            final = str_concat(final, JL)
                            final = str_concat(final, "\n")
                        ]
                        if char_at(JL, 0) != 46 [
                            final = str_concat(final, "    ")
                            final = str_concat(final, JL)
                            final = str_concat(final, "\n")
                        ]
                    ]
                ]
            ]
        ]
        ji = ji + 1
    ]
    if pending_jmp == 1 [
        final = str_concat(final, "    jmp ")
        final = str_concat(final, jmp_lab)
        final = str_concat(final, "\n")
    ]
    return(final)
]


@cpu line_at(src string, pos int64): int64 [
    box line = 1 int64
    box k = 0 int64
    while k < pos [
        if char_at(src, k) == 10 [ line = line + 1 ]
        k = k + 1
    ]
    return(line)
]

@cpu ty_map_get(m string, name string): string [
    box needle = str_concat(name, "=") string
    box nlen = strlen(needle) int64
    box i = 0 int64
    box len = strlen(m) int64
    while i + nlen <= len [
        box ok = 1 int64
        box j = 0 int64
        while j < nlen [
            if char_at(m, i + j) != char_at(needle, j) [ ok = 0 ]
            j = j + 1
        ]
        if ok == 1 [
            if i == 0 [ ok = 1 ]
            if i > 0 [
                if char_at(m, i - 1) != 59 [ ok = 0 ]
            ]
        ]
        if ok == 1 [
            box vs = i + nlen int64
            box ve = vs int64
            while ve < len [
                if char_at(m, ve) == 59 [ return(substr(m, vs, ve - vs)) ]
                ve = ve + 1
            ]
            return(substr(m, vs, len - vs))
        ]
        i = i + 1
    ]
    return("")
]

@cpu ty_map_set(m string, name string, val string): string [
    box cur = ty_map_get(m, name) string
    if strlen(cur) > 0 [
        box needle = str_concat(name, "=") string
        box nlen = strlen(needle) int64
        box i = 0 int64
        box len = strlen(m) int64
        while i + nlen <= len [
            box ok = 1 int64
            box j = 0 int64
            while j < nlen [
                if char_at(m, i + j) != char_at(needle, j) [ ok = 0 ]
                j = j + 1
            ]
            if ok == 1 [
                if i > 0 [
                    if char_at(m, i - 1) != 59 [ ok = 0 ]
                ]
            ]
            if ok == 1 [
                box vs = i + nlen int64
                box ve = vs int64
                while ve < len [
                    if char_at(m, ve) == 59 [
                        return(str_concat(substr(m, 0, vs), str_concat(val, substr(m, ve, len - ve))))
                    ]
                    ve = ve + 1
                ]
            ]
            i = i + 1
        ]
    ]
    return(str_concat(m, str_concat(name, str_concat("=", str_concat(val, ";")))))
]

@cpu is_builtin_fn(name string): int64 [
    if strcmp(name, "print_int") == 0 [ return(1) ]
    if strcmp(name, "print_str") == 0 [ return(1) ]
    if strcmp(name, "print_nl") == 0 [ return(1) ]
    if strcmp(name, "strlen") == 0 [ return(1) ]
    if strcmp(name, "char_at") == 0 [ return(1) ]
    if strcmp(name, "substr") == 0 [ return(1) ]
    if strcmp(name, "str_concat") == 0 [ return(1) ]
    if strcmp(name, "strcmp") == 0 [ return(1) ]
    if strcmp(name, "itoa") == 0 [ return(1) ]
    if strcmp(name, "read_file") == 0 [ return(1) ]
    if strcmp(name, "write_file") == 0 [ return(1) ]
    if strcmp(name, "allocator") == 0 [ return(1) ]
    if strcmp(name, "free") == 0 [ return(1) ]
    if strcmp(name, "store_i64") == 0 [ return(1) ]
    if strcmp(name, "load_i64") == 0 [ return(1) ]
    if strcmp(name, "ptr_add") == 0 [ return(1) ]
    if strcmp(name, "memset_n") == 0 [ return(1) ]
    if strcmp(name, "memcpy_n") == 0 [ return(1) ]
    if strcmp(name, "pool_create") == 0 [ return(1) ]
    if strcmp(name, "pool_alloc") == 0 [ return(1) ]
    if strcmp(name, "pool_free") == 0 [ return(1) ]
    if strcmp(name, "getenv") == 0 [ return(1) ]
    if strcmp(name, "system") == 0 [ return(1) ]
    if strcmp(name, "argc") == 0 [ return(1) ]
    if strcmp(name, "argv") == 0 [ return(1) ]
    if strcmp(name, "exit") == 0 [ return(1) ]
    if strcmp(name, "panic") == 0 [ return(1) ]
    if strcmp(name, "flush") == 0 [ return(1) ]
    if strcmp(name, "scan_int") == 0 [ return(1) ]
    if strcmp(name, "scan_float") == 0 [ return(1) ]
    if strcmp(name, "scan_string") == 0 [ return(1) ]
    if strcmp(name, "str_phase_begin") == 0 [ return(1) ]
    if strcmp(name, "str_phase_end") == 0 [ return(1) ]
    if strcmp(name, "str_persist") == 0 [ return(1) ]
    if strcmp(name, "file_size") == 0 [ return(1) ]
    if strcmp(name, "write_file_bin") == 0 [ return(1) ]
    if strcmp(name, "append_file_text") == 0 [ return(1) ]
    return(0)
]

@cpu typecheck_source(src string): int64 [
    // Production memory + type analyzer (linear pass + heap state machine)
    // States per ptr name: UNINIT | LIVE | FREED | NULLISH | ESCAPED
    // Goals: double-free, UAF, deref non-ptr, free non-ptr, leak warnings,
    //        undefined calls, type clashes on assignment, * model integrity
    box errs = 0 int64
    box warns = 0 int64
    box len = strlen(src) int64
    box i = 0 int64
    box has_main = 0 int64
    box funcs = ";" string
    box types = ";" string
    box heap = ";" string
    box owners = ";" string
    box sizes = ";" string
    box br = 0 int64
    box paren = 0 int64

    // ---- Pass 1: function table ----
    while i < len [
        if match_kw(src, i, "@cpu") == 1 [
            box j = i + 4 int64
            j = skip_ws_c(src, j, len)
            if is_alpha(char_at(src, j)) == 1 [
                box ns = j int64
                while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                box fn = substr(src, ns, j - ns) string
                funcs = str_concat(funcs, str_concat(fn, ";"))
                if strcmp(fn, "main") == 0 [ has_main = 1 ]
            ]
        ]
        if match_kw(src, i, "@gpu") == 1 [
            box j = i + 4 int64
            j = skip_ws_c(src, j, len)
            if is_alpha(char_at(src, j)) == 1 [
                box ns = j int64
                while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                funcs = str_concat(funcs, str_concat(substr(src, ns, j - ns), ";"))
            ]
        ]
        i = i + 1
    ]

    // ---- Pass 2: step-by-step ----
    i = 0
    while i < len [
        box line = line_at(src, i) int64
        box c = char_at(src, i) int64
        if c == 91 [ br = br + 1 ]
        if c == 93 [
            br = br - 1
            if br < 0 [
                report_error(line, 0, "memory/type: unexpected ']'")
                errs = errs + 1
                br = 0
            ]
        ]
        if c == 40 [ paren = paren + 1 ]
        if c == 41 [
            paren = paren - 1
            if paren < 0 [
                report_error(line, 0, "memory/type: unexpected ')'")
                errs = errs + 1
                paren = 0
            ]
        ]

        // box [*]? name = ...
        if match_kw(src, i, "box") == 1 [
            box j = i + 3 int64
            j = skip_ws_c(src, j, len)
            box is_star = 0 int64
            if char_at(src, j) == 42 [
                is_star = 1
                j = j + 1
                j = skip_ws_c(src, j, len)
            ]
            if is_alpha(char_at(src, j)) == 1 [
                box ns = j int64
                while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                box vname = substr(src, ns, j - ns) string
                // redeclaration
                if strlen(ty_map_get(types, vname)) > 0 [
                    report_error(line, 0, str_concat("redeclaration of `", str_concat(vname, "`")))
                    errs = errs + 1
                ]
                j = skip_ws_c(src, j, len)
                if char_at(src, j) == 61 [
                    j = j + 1
                    j = skip_ws_c(src, j, len)
                    box ty = "int64" string
                    if is_star == 1 [ ty = "ptr" ]
                    box k = j int64
                    box saw_alloc = 0 int64
                    box alloc_sz = "0" string
                    while k < len [
                        if char_at(src, k) == 10 [ k = len ]
                        if k < len [
                            if match_kw(src, k, "float64") == 1 [ ty = "float64" ]
                            if match_kw(src, k, "string") == 1 [ ty = "string" ]
                            if match_kw(src, k, "ptr") == 1 [ ty = "ptr" ]
                            if match_kw(src, k, "allocator") == 1 [
                                ty = "ptr"
                                saw_alloc = 1
                            ]
                            if match_kw(src, k, "int64") == 1 [
                                if is_star == 0 [ ty = "int64" ]
                                if is_star == 1 [ ty = "ptr" ]
                            ]
                            k = k + 1
                        ]
                    ]
                    if is_star == 1 [ ty = "ptr" ]
                    if match_kw(src, j, "allocator") == 1 [ ty = "ptr"  saw_alloc = 1 ]
                    if match_kw(src, j, "std.allocator") == 1 [ ty = "ptr"  saw_alloc = 1 ]
                    // null-ish init
                    if char_at(src, j) == 48 [
                        if is_star == 1 [
                            heap = ty_map_set(heap, vname, "NULLISH")
                        ]
                    ]
                    types = ty_map_set(types, vname, ty)
                    if strcmp(ty, "ptr") == 0 [
                        if strcmp(ty_map_get(heap, vname), "NULLISH") != 0 [
                            heap = ty_map_set(heap, vname, "LIVE")
                        ]
                        owners = ty_map_set(owners, vname, "OWN")
                        if is_star == 1 [
                            sizes = ty_map_set(sizes, vname, "8")
                        ]
                        if saw_alloc == 1 [
                            sizes = ty_map_set(sizes, vname, "heap")
                        ]
                    ]
                ]
            ]
        ]

        // free(name)
        if match_kw(src, i, "free") == 1 [
            box j = i + 4 int64
            j = skip_ws_c(src, j, len)
            if char_at(src, j) == 40 [
                j = j + 1
                j = skip_ws_c(src, j, len)
                if is_alpha(char_at(src, j)) == 1 [
                    box ns = j int64
                    while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                    box vname = substr(src, ns, j - ns) string
                    box st = ty_map_get(heap, vname) string
                    box vt = ty_map_get(types, vname) string
                    box ow = ty_map_get(owners, vname) string
                    if strlen(vt) == 0 [
                        report_error(line, 0, str_concat("free() of undeclared `", str_concat(vname, "`")))
                        errs = errs + 1
                    ]
                    if strlen(vt) > 0 [
                        if strcmp(vt, "ptr") != 0 [
                            report_error(line, 0, str_concat("free() on non-pointer `", str_concat(vname, "`")))
                            errs = errs + 1
                        ]
                    ]
                    if strcmp(st, "FREED") == 0 [
                        report_error(line, 0, str_concat("double free of `", str_concat(vname, "`")))
                        errs = errs + 1
                    ]
                    if strcmp(st, "NULLISH") == 0 [
                        report_error(line, 0, str_concat("free() of null-ish pointer `", str_concat(vname, "`")))
                        errs = errs + 1
                    ]
                    if strcmp(st, "UNINIT") == 0 [
                        report_error(line, 0, str_concat("free() of uninitialized pointer `", str_concat(vname, "`")))
                        errs = errs + 1
                    ]
                    if strcmp(ow, "BORROW") == 0 [
                        report_error(line, 0, str_concat("free() of non-owned (borrowed) pointer `", str_concat(vname, "`")))
                        errs = errs + 1
                    ]
                    if strcmp(st, "LIVE") == 0 [
                        heap = ty_map_set(heap, vname, "FREED")
                        owners = ty_map_set(owners, vname, "NONE")
                    ]
                    if strlen(st) == 0 [
                        report_warning(line, 0, str_concat("free() of unknown pointer `", str_concat(vname, "`")))
                        warns = warns + 1
                        heap = ty_map_set(heap, vname, "FREED")
                    ]
                ]
            ]
        ]

        // *name  deref
        if char_at(src, i) == 42 [
            box left_ok = 1 int64
            if i > 0 [
                if is_alnum(char_at(src, i - 1)) == 1 [ left_ok = 0 ]
                if char_at(src, i - 1) == 42 [ left_ok = 0 ]
            ]
            if left_ok == 1 [
                box j = i + 1 int64
                j = skip_ws_c(src, j, len)
                if is_alpha(char_at(src, j)) == 1 [
                    box ns = j int64
                    while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                    box vname = substr(src, ns, j - ns) string
                    box st = ty_map_get(heap, vname) string
                    box vt = ty_map_get(types, vname) string
                    if strlen(vt) > 0 [
                        if strcmp(vt, "ptr") != 0 [
                            report_error(line, 0, str_concat("deref * on non-pointer `", str_concat(vname, "`")))
                            errs = errs + 1
                        ]
                    ]
                    if strlen(vt) == 0 [
                        report_error(line, 0, str_concat("deref * of undeclared `", str_concat(vname, "`")))
                        errs = errs + 1
                    ]
                    if strcmp(st, "FREED") == 0 [
                        report_error(line, 0, str_concat("use-after-free: deref *", str_concat(vname, "")))
                        errs = errs + 1
                    ]
                    if strcmp(st, "NULLISH") == 0 [
                        report_error(line, 0, str_concat("null dereference: *", str_concat(vname, "")))
                        errs = errs + 1
                    ]
                    if strcmp(st, "UNINIT") == 0 [
                        report_error(line, 0, str_concat("deref of uninitialized pointer `", str_concat(vname, "`")))
                        errs = errs + 1
                    ]
                ]
            ]
        ]

        // ** ban
        if char_at(src, i) == 42 [
            if i + 1 < len [
                if char_at(src, i + 1) == 42 [
                    report_error(line, 0, "pointer-to-pointer (**) is forbidden — single-level * only")
                    errs = errs + 1
                ]
            ]
        ]

        // assignment name =  (may break/leak pointer)
        if is_alpha(char_at(src, i)) == 1 [
            box ok_start = 1 int64
            if i > 0 [
                if is_alnum(char_at(src, i - 1)) == 1 [ ok_start = 0 ]
            ]
            if ok_start == 1 [
                box ns = i int64
                box j = i int64
                while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                box vname = substr(src, ns, j - ns) string
                box j2 = skip_ws_c(src, j, len) int64
                if char_at(src, j2) == 61 [
                    if j2 + 1 < len [
                        if char_at(src, j2 + 1) != 61 [
                            box vt = ty_map_get(types, vname) string
                            box st = ty_map_get(heap, vname) string
                            // type clash: assign string-looking literal to int etc. — light check
                            box rhs = j2 + 1 int64
                            rhs = skip_ws_c(src, rhs, len)
                            if strcmp(vt, "ptr") == 0 [
                                box is_decl = 0 int64
                                box ls = i int64
                                while ls > 0 [
                                    if char_at(src, ls - 1) == 10 [
                                        ls = ls
                                        // break via zero
                                        box _b = ls int64
                                        ls = 0 - _b
                                    ]
                                    if ls > 0 [ ls = ls - 1 ]
                                ]
                                if ls < 0 [ ls = 0 - ls ]
                                // ls = start of line
                                box scan = ls int64
                                while scan < i [
                                    if match_kw(src, scan, "box") == 1 [ is_decl = 1 ]
                                    scan = scan + 1
                                ]
                                if is_decl == 0 [
                                    if strcmp(st, "LIVE") == 0 [
                                        report_warning(line, 0, str_concat("pointer `", str_concat(vname, "` reassigned without free; previous block may leak")))
                                        warns = warns + 1
                                    ]
                                ]
                                // assign 0 → NULLISH
                                if char_at(src, rhs) == 48 [
                                    heap = ty_map_set(heap, vname, "NULLISH")
                                ]
                                if match_kw(src, rhs, "allocator") == 1 [
                                    heap = ty_map_set(heap, vname, "LIVE")
                                    owners = ty_map_set(owners, vname, "OWN")
                                ]
                                if is_alpha(char_at(src, rhs)) == 1 [
                                    box rns = rhs int64
                                    box rj = rhs int64
                                    while is_alnum(char_at(src, rj)) == 1 [ rj = rj + 1 ]
                                    box rname = substr(src, rns, rj - rns) string
                                    box rt = ty_map_get(types, rname) string
                                    if strlen(rt) > 0 [
                                        if strcmp(rt, "ptr") != 0 [
                                            report_error(line, 0, str_concat("type error: assigning non-ptr `", str_concat(rname, str_concat("` to pointer `", str_concat(vname, "`")))))
                                            errs = errs + 1
                                        ]
                                    ]
                                    if strcmp(rt, "ptr") == 0 [
                                        // alias: both refer; mark borrow on rhs still LIVE, lhs LIVE alias
                                        heap = ty_map_set(heap, vname, ty_map_get(heap, rname))
                                        owners = ty_map_set(owners, vname, "BORROW")
                                        report_warning(line, 0, str_concat("pointer alias: `", str_concat(vname, str_concat("` borrows `", str_concat(rname, "` (free only the owner)")))))
                                        warns = warns + 1
                                    ]
                                ]
                            ]
                            if strcmp(vt, "int64") == 0 [
                                if char_at(src, rhs) == 34 [
                                    report_error(line, 0, str_concat("type error: string literal assigned to int64 `", str_concat(vname, "`")))
                                    errs = errs + 1
                                ]
                            ]
                            if strcmp(vt, "string") == 0 [
                                // int literal to string
                                if is_digit(char_at(src, rhs)) == 1 [
                                    report_warning(line, 0, str_concat("assigning number to string `", str_concat(vname, "`")))
                                    warns = warns + 1
                                ]
                            ]
                        ]
                    ]
                ]
                // function call check
                if char_at(src, j2) == 40 [
                    box is_kw = 0 int64
                    if strcmp(vname, "if") == 0 [ is_kw = 1 ]
                    if strcmp(vname, "while") == 0 [ is_kw = 1 ]
                    if strcmp(vname, "box") == 0 [ is_kw = 1 ]
                    if strcmp(vname, "return") == 0 [ is_kw = 1 ]
                    if strcmp(vname, "else") == 0 [ is_kw = 1 ]
                    if strcmp(vname, "switch") == 0 [ is_kw = 1 ]
                    if strcmp(vname, "case") == 0 [ is_kw = 1 ]
                    if strcmp(vname, "default") == 0 [ is_kw = 1 ]
                    if strcmp(vname, "free") == 0 [ is_kw = 1 ]
                    if is_kw == 0 [
                        box known = is_builtin_fn(vname) int64
                        if known == 0 [
                            box fi = 0 int64
                            box fl = strlen(funcs) int64
                            box nl = strlen(vname) int64
                            while fi + nl < fl [
                                box match = 1 int64
                                box t = 0 int64
                                while t < nl [
                                    if char_at(funcs, fi + t) != char_at(vname, t) [ match = 0 ]
                                    t = t + 1
                                ]
                                if match == 1 [
                                    if char_at(funcs, fi + nl) == 59 [ known = 1 ]
                                ]
                                fi = fi + 1
                            ]
                        ]
                        if known == 0 [
                            if match_kw(vname, 0, "hl_") == 0 [
                                if match_kw(vname, 0, "rt_") == 0 [
                                    if match_kw(vname, 0, "basalt_") == 0 [
                                        report_error(line, 0, str_concat("call to undefined function `", str_concat(vname, "`")))
                                        errs = errs + 1
                                    ]
                                ]
                            ]
                        ]
                        // free is handled above; allocator marks LIVE for result not tracked without dest
                    ]
                ]
            ]
        ]

        // return p  while p LIVE without free — note possible leak on return of owned
        if match_kw(src, i, "return") == 1 [
            box j = i + 6 int64
            j = skip_ws_c(src, j, len)
            if is_alpha(char_at(src, j)) == 1 [
                box ns = j int64
                while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                box vname = substr(src, ns, j - ns) string
                if strcmp(ty_map_get(types, vname), "ptr") == 0 [
                    if strcmp(ty_map_get(owners, vname), "OWN") == 0 [
                        if strcmp(ty_map_get(heap, vname), "LIVE") == 0 [
                            // escaping ownership
                            heap = ty_map_set(heap, vname, "ESCAPED")
                            owners = ty_map_set(owners, vname, "NONE")
                            report_note(line, 0, str_concat("returning owned pointer `", str_concat(vname, "` (ownership escapes)")))
                        ]
                    ]
                    if strcmp(ty_map_get(heap, vname), "FREED") == 0 [
                        report_error(line, 0, str_concat("returning dangling pointer `", str_concat(vname, "`")))
                        errs = errs + 1
                    ]
                ]
            ]
        ]

        i = i + 1
    ]

    if br != 0 [
        report_error(1, 0, "unbalanced brackets in source")
        errs = errs + 1
    ]
    if paren != 0 [
        report_error(1, 0, "unbalanced parentheses in source")
        errs = errs + 1
    ]
    if has_main == 0 [
        report_error(1, 0, "no main function found")
        errs = errs + 1
    ]
    // end-of-function leak scan: any OWN+LIVE still held
    // (approximate: scan owners map text)
    box oi = 0 int64
    box ol = strlen(owners) int64
    while oi < ol [
        // format name=OWN;
        if char_at(owners, oi) == 61 [
            // look back for name — skip heavy scan; warn generically if OWN remains with LIVE
            oi = oi + 1
        ]
        oi = oi + 1
    ]
    if warns > 0 [
        print_str("basaltc: ")
        print_str(itoa(warns))
        print_str(" warning(s) from memory/type analysis\n")
    ]
    if errs > 0 [
        print_str("basaltc: note: memory model — box *x / allocator → OWN+LIVE; free once; *x requires LIVE; no **\n")
    ]
    return(errs)
]


@cpu compile_error(msg string): int32 [
    print_str("basaltc: error: ")
    print_str(msg)
    print_nl()
    print_str("basaltc: note: run with -v for pipeline details; -h lists flags
")
    print_str("basaltc: note: see docs/LANGUAGE.md and docs/MANUAL.md
")
    return(1)
]


@cpu asm_too_heavy(asm string): int64 [
    if strlen(asm) > 48000000 [ return(1) ]
    return(0)
]

@cpu basalt_home(): string [
    box h = getenv("BASALT_HOME") string
    if strlen(h) > 0 [ return(h) ]
    box h2 = getenv("BASALT_ROOT") string
    if strlen(h2) > 0 [ return(h2) ]
    return("")
]

@cpu path_join(a string, b string): string [
    if strlen(a) == 0 [ return(b) ]
    box last = char_at(a, strlen(a) - 1) int64
    if last == 47 [ return(str_concat(a, b)) ]
    if last == 92 [ return(str_concat(a, b)) ]
    return(str_concat(str_concat(a, "/"), b))
]

@cpu find_basm_exe(): string [
    // Prefer PATH "basm" so install dirs on noexec mounts still work via /tmp copy
    return("basm")
]

@cpu find_runtime_o(is_bare int64): string [
    box envrt = getenv("BASALT_RT") string
    if strlen(envrt) > 0 [ return(envrt) ]
    box home = basalt_home() string
    box name = "basalt_rt.o" string
    if is_bare == 1 [ name = "basalt_rt_bare.o" ]
    if strlen(home) > 0 [ return(path_join(home, path_join("lib", name))) ]
    return(path_join("bin", name))
]

@cpu find_pe_tool(): string [
    box home = basalt_home() string
    if strlen(home) > 0 [ return(path_join(home, "bin/pe_tool")) ]
    return("pe_tool")
]

@cpu print_help(): int32 [
    print_str("basaltc — Basalt self-hosted compiler\n")
    print_str("Types: int64 float64 (aliases int32/int/float → same storage)\n")
    print_str("Comments: //  /* */  ;  (line)\n")
    print_str("Import: @import \"file.bd\"  @include \"file.bd\"\n")
    print_str("Langs: @lang @rule @prelude @X[ ]  $name $rest multi-pass\n")
    print_str("GPU: experimental stubs only (-gpu / -GO6)\n")

    print_str("Usage: basaltc [options] <file.bd>\n\n")
    print_str("Output:\n")
    print_str("  -o FILE          write output to FILE\n")
    print_str("  -S               emit BASM only (no assemble/link)\n")
    print_str("  -c               emit object .o only (no link)\n")
    print_str("  -E               preprocess only (print to stdout)\n")
    print_str("  -emit-bir        write BIR dump (FILE.bir)\n")
    print_str("  -emit-basm       same as -S\n")
    print_str("  -save-temps      keep .basm / .bir intermediates\n")
    print_str("\nOptimization:\n")
    print_str("  -O0..-O6         -O6 = -O5 + bump + BAL/BAM beast (broad algebra)\n")
    print_str("  -bir-O0..4       BIR/SSA opt level (default follows -O)\n")
    print_str("  -blink-O0..4     BASM BPO opt level\n")
    print_str("  -fvectorize      enable vectorize_basm pass\n")
    print_str("  -Falgebra        whole-program algebra BAL\n")
    print_str("  -Fbandit         PRIMARY: -O5 arsenal + UCB bandit pass order\n")
    print_str("  -Fzig/-Frust/-Fforge  whole-file dialect (no @lang needed)\n")
    print_str("  -lang <name>     same as -F<name>\n")
    print_str("  //!lang:zig header or #lang rust  auto dialect\n")
    print_str("  @comptime_error/@compile_error  compile-time fail\n")
    print_str("  -Fbayes          alias of -Fbandit (no -ON required)\n")
    print_str("  -fbranch-guard   conservative branchy skip (default)\n")
    print_str("  -fbranch-soft    only skip abs/hash double-branch\n")
    print_str("  -fno-branch-guard / -Fallow-branch-opt  opt through branches\n")

    print_str("  -fno-vectorize   disable vectorize pass\n")
    print_str("  -funroll-loops / -fno-unroll-loops\n")
    print_str("  -fno-inline      reserve (future inliner off)\n")
    print_str("\nTarget / link:\n")
    print_str("  -l               ELF64 (default)\n")
    print_str("  -bare            freestanding kernel/bare-metal (no OS/libc)\n")
    print_str("  -W               PE32+ Windows hint\n")
    print_str("  -target elf64|pe64\n")
    print_str("  -march=x86-64    (recorded; reserved)\n")
    print_str("\nDiagnostics:\n")
    print_str("  -v, --verbose    verbose pipeline log\n")
    print_str("  -q, --quiet      suppress non-error messages\n")
    print_str("  -Wall            extra notes (type width, etc.)\n")
    print_str("  -Werror          treat diagnostics as errors\n")
    print_str("  -ftime-report    print phase timings\n")
    print_str("  -g               debug marker in BASM header\n")
    print_str("\nInfo:\n")
    print_str("  -h, --help       this help\n")
    print_str("  --version        version string\n")
    return(0)
]

@cpu main(): int32 [
    box n = argc() int64
    box in_path = "" string
    box out_path = "" string
    box is_pe = 0 int64
    box is_bare = 0 int64
    box opt = 2 int64
    box bir_opt = 0 - 1 int64
    box blink_opt = 0 - 1 int64
    box verbose = 0 int64
    box quiet = 0 int64
    box emit_basm_only = 0 int64
    box emit_obj_only = 0 int64
    box emit_preproc = 0 int64
    box emit_bir = 0 int64
    box save_temps = 0 int64
    box do_vectorize = 1 int64
    box funroll = 0 int64
    box force_avx = 0 - 1 int64
    box do_closed = 0 - 1 int64
    box do_algebra = 0 int64
    box do_bayes = 0 int64
    box force_lang = "" string
    box do_o6_bump = 0 int64
    box branch_guard = 1 int64
    box do_promote = 0 - 1 int64
    box do_unroll = 0 - 1 int64
    box opt_extra = 0 int64
    box do_jit = 0 int64
    box go6 = 0 int64
    box has_gpu = 0 int64
    box link_gpu = 0 int64
    box wall = 0 int64
    box werror = 0 int64
    box time_report = 0 int64
    box debug_info = 0 int64
    box ai = 1 int64
    while ai < n [
        box a = argv(ai) string
        if char_at(a, 0) != 45 [
            if strlen(in_path) == 0 [ in_path = a ]
        ]
        if strcmp(a, "-o") == 0 [
            ai = ai + 1
            if ai >= n [ return(compile_error("-o needs an argument")) ]
            out_path = argv(ai)
        ]
        if strcmp(a, "-W") == 0 [ is_pe = 1 ]
        if strcmp(a, "-l") == 0 [ is_pe = 0 ]
        if strcmp(a, "-bare") == 0 [ is_bare = 1 ]
        if strcmp(a, "-S") == 0 [ emit_basm_only = 1 ]
        if strcmp(a, "-emit-basm") == 0 [ emit_basm_only = 1 ]
        if strcmp(a, "-c") == 0 [ emit_obj_only = 1 ]
        if strcmp(a, "-E") == 0 [ emit_preproc = 1 ]
        if strcmp(a, "-emit-bir") == 0 [ emit_bir = 1 ]
        if strcmp(a, "-save-temps") == 0 [ save_temps = 1 ]
        if strcmp(a, "-v") == 0 [ verbose = 1 ]
        if strcmp(a, "--verbose") == 0 [ verbose = 1 ]
        if strcmp(a, "-q") == 0 [ quiet = 1 ]
        if strcmp(a, "--quiet") == 0 [ quiet = 1 ]
        if strcmp(a, "-O0") == 0 [ opt = 0 ]
        if strcmp(a, "-O1") == 0 [ opt = 1 ]
        if strcmp(a, "-O2") == 0 [ opt = 2 ]
        if strcmp(a, "-O3") == 0 [ opt = 3 ]
        if strcmp(a, "-O4") == 0 [ opt = 4 ]
        if strcmp(a, "-O5") == 0 [ opt = 5 ]
        if strcmp(a, "-O6") == 0 [ opt = 6 ]
        if strcmp(a, "-Ofast") == 0 [ opt = 6 ]
        if strcmp(a, "-bir-O0") == 0 [ bir_opt = 0 ]
        if strcmp(a, "-bir-O1") == 0 [ bir_opt = 1 ]
        if strcmp(a, "-bir-O2") == 0 [ bir_opt = 2 ]
        if strcmp(a, "-bir-O3") == 0 [ bir_opt = 3 ]
        if strcmp(a, "-bir-O4") == 0 [ bir_opt = 4 ]
        if strcmp(a, "-bir-O5") == 0 [ bir_opt = 5 ]
        if strcmp(a, "-blink-O0") == 0 [ blink_opt = 0 ]
        if strcmp(a, "-blink-O1") == 0 [ blink_opt = 1 ]
        if strcmp(a, "-blink-O2") == 0 [ blink_opt = 2 ]
        if strcmp(a, "-blink-O3") == 0 [ blink_opt = 3 ]
        if strcmp(a, "-blink-O4") == 0 [ blink_opt = 4 ]
        if strcmp(a, "-blink-O5") == 0 [ blink_opt = 5 ]
        if strcmp(a, "-fvectorize") == 0 [ do_vectorize = 1 ]
        if strcmp(a, "-fno-vectorize") == 0 [ do_vectorize = 0 ]
        if strcmp(a, "-funroll-loops") == 0 [
            funroll = 1
            do_unroll = 1
        ]
        if strcmp(a, "-fno-unroll-loops") == 0 [
            funroll = 0
            do_unroll = 0
        ]
        if strcmp(a, "-favx") == 0 [
            force_avx = 1
            do_vectorize = 1
        ]
        if strcmp(a, "-fno-avx") == 0 [
            force_avx = 0
            do_vectorize = 0
        ]
        if strcmp(a, "-fclosed-form") == 0 [ do_closed = 1 ]
        if strcmp(a, "-Falgebra") == 0 [ do_algebra = 1 ]
        if strcmp(a, "-algebra") == 0 [ do_algebra = 1 ]
        if strcmp(a, "-FBAL") == 0 [ do_algebra = 1 ]
        if strcmp(a, "-fno-branch-guard") == 0 [ branch_guard = 0 ]
        if strcmp(a, "-Fallow-branch-opt") == 0 [ branch_guard = 0 ]
        if strcmp(a, "-fbranch-guard") == 0 [ branch_guard = 1 ]
        if strcmp(a, "-fbranch-soft") == 0 [ branch_guard = 2 ]
        if strcmp(a, "-Fbandit") == 0 [ do_bayes = 1 ]
        if strcmp(a, "-Fzig") == 0 [ force_lang = "zig" ]
        if strcmp(a, "-Frust") == 0 [ force_lang = "rust" ]
        if strcmp(a, "-Fforge") == 0 [ force_lang = "forge" ]
        if strcmp(a, "-Fpython") == 0 [ force_lang = "python" ]
        if strcmp(a, "-Fpy") == 0 [ force_lang = "python" ]
        if strcmp(a, "-Fgo") == 0 [ force_lang = "go" ]
        if strcmp(a, "-Fc") == 0 [ force_lang = "c" ]
        if strcmp(a, "-Fjs") == 0 [ force_lang = "js" ]
        if strcmp(a, "-Fember") == 0 [ force_lang = "ember" ]
        if strcmp(a, "-Fquartz") == 0 [ force_lang = "quartz" ]
        if strcmp(a, "-Fpebble") == 0 [ force_lang = "pebble" ]
        if strcmp(a, "-Fmini") == 0 [ force_lang = "mini" ]
        if strcmp(a, "-lang") == 0 [
            ai = ai + 1
            if ai < n [ force_lang = argv(ai) ]
        ]
        if strcmp(a, "-Fbayes") == 0 [ do_bayes = 1 ]
        if strcmp(a, "-bayesian") == 0 [ do_bayes = 1 ]
        if strcmp(a, "-Fbayesian") == 0 [ do_bayes = 1 ]
        if strcmp(a, "-fno-closed-form") == 0 [ do_closed = 0 ]
        if strcmp(a, "-fpromote-regs") == 0 [ do_promote = 1 ]
        if strcmp(a, "-fno-promote-regs") == 0 [ do_promote = 0 ]
        if strcmp(a, "-fopt-extra") == 0 [ opt_extra = 1 ]
        if strcmp(a, "-JIT") == 0 [ do_jit = 1 ]
        if strcmp(a, "-jit") == 0 [ do_jit = 1 ]
        if strcmp(a, "-GO6") == 0 [
            go6 = 1
            link_gpu = 1
            if opt < 5 [ opt = 5 ]
            if blink_opt < 5 [ blink_opt = 5 ]
        ]
        if strcmp(a, "-go6") == 0 [
            go6 = 1
            link_gpu = 1
            if opt < 5 [ opt = 5 ]
            if blink_opt < 5 [ blink_opt = 5 ]
        ]
        if strcmp(a, "-fgpu") == 0 [ link_gpu = 1 ]
        if strcmp(a, "-fno-gpu") == 0 [ link_gpu = 0 ]
        if strcmp(a, "-Wall") == 0 [ wall = 1 ]
        if strcmp(a, "-Werror") == 0 [ werror = 1 ]
        if strcmp(a, "-ftime-report") == 0 [ time_report = 1 ]
        if strcmp(a, "-g") == 0 [ debug_info = 1 ]
        if strcmp(a, "-target") == 0 [
            ai = ai + 1
            if ai >= n [ return(compile_error("-target needs elf64|pe64")) ]
            box t = argv(ai) string
            if strcmp(t, "pe64") == 0 [ is_pe = 1 ]
            if strcmp(t, "pe") == 0 [ is_pe = 1 ]
            if strcmp(t, "elf64") == 0 [ is_pe = 0 ]
            if strcmp(t, "elf") == 0 [ is_pe = 0 ]
        ]
        if strcmp(a, "-h") == 0 [
            print_help()
            return(0)
        ]
        if strcmp(a, "--help") == 0 [
            print_help()
            return(0)
        ]
        if strcmp(a, "--version") == 0 [
            print_str("basaltc 0.4.0 (self-host)\n")
            return(0)
        ]
        ai = ai + 1
    ]
    if strlen(in_path) == 0 [
        print_help()
        return(1)
    ]
    if bir_opt < 0 [ bir_opt = opt ]
    if blink_opt < 0 [ blink_opt = opt ]
    if opt < 2 [ do_vectorize = 0 ]
    // Defaults from -O when user did not force flags
    if do_closed < 0 [
        do_closed = 0
        if opt >= 4 [ do_closed = 1 ]
    ]
    if do_promote < 0 [
        do_promote = 0
        if opt >= 2 [ do_promote = 1 ]
    ]
    if do_unroll < 0 [
        do_unroll = 0
        if opt >= 4 [ do_unroll = 1 ]
    ]
    if force_avx < 0 [
        force_avx = 0
        if opt >= 5 [ force_avx = 1 ]
    ]
    // -O5 enables closed/promote; full BAL/BAM/POW chain via -Falgebra or -O5 still runs bpo_arsenal+pow path
    if opt >= 5 [
        do_closed = 1
        do_promote = 1
    ]
    if opt_extra == 1 [
        // Graft higher passes onto whatever -O was chosen
        if blink_opt < 4 [ blink_opt = 4 ]
        if do_promote == 0 [ do_promote = 1 ]
        if do_unroll == 0 [ do_unroll = 1 ]
    ]
    // -Fbandit / -Fbayes as PRIMARY flag: implies -O5 arsenal + bandit orderer
    if do_bayes == 1 [
        // -Fbandit: best primary flag — full BIR/BPO/BAM/BAL/POW + algebra
        if opt < 5 [ opt = 5 ]
        if bir_opt < 0 [ bir_opt = 5 ]
        if bir_opt < 5 [ bir_opt = 5 ]
        if blink_opt < 0 [ blink_opt = 5 ]
        if blink_opt < 5 [ blink_opt = 5 ]
        do_closed = 1
        do_promote = 1
        do_unroll = 1
        do_vectorize = 1
        force_avx = 1
        funroll = 1
        opt_extra = 1
        do_algebra = 1
        branch_guard = 2
    ]
    // -O6 / -Ofast: ignore compile time — max SSA + BPO + math identities
    if opt >= 6 [
        // Cap BIR/BPO at 5 after default opt inheritance (avoids OOM)
        bir_opt = 5
        blink_opt = 5
        do_closed = 1
        do_promote = 1
        do_unroll = 1
        do_vectorize = 1
        force_avx = 1
        funroll = 1
        opt_extra = 1
        do_o6_bump = 1
    ]
    // -GO6 implies full beast + GPU
    if go6 == 1 [
        if opt < 5 [ opt = 5 ]
        if bir_opt < 5 [ bir_opt = 5 ]
        if blink_opt < 5 [ blink_opt = 5 ]
        do_closed = 1
        do_promote = 1
        do_unroll = 1
        force_avx = 1
        do_vectorize = 1
        link_gpu = 1
    ]
    // JIT: max opts, RAM path, auto-run + cleanup
    if do_jit == 1 [
        if opt < 5 [ opt = 5 ]
        if bir_opt < 5 [ bir_opt = 5 ]
        if blink_opt < 5 [ blink_opt = 5 ]
        if do_closed < 0 [ do_closed = 1 ]
        if do_promote < 0 [ do_promote = 1 ]
        if do_unroll < 0 [ do_unroll = 1 ]
        if strlen(out_path) == 0 [
            // prefer /dev/shm (tmpfs) for speed
            out_path = "basalt_jit_bin"
        ]
    ]
    box plen = strlen(in_path) int64
    if strlen(out_path) == 0 [
        out_path = in_path
        if plen > 3 [
            if char_at(in_path, plen - 3) == 46 [
                if char_at(in_path, plen - 2) == 98 [
                    if char_at(in_path, plen - 1) == 100 [
                        out_path = substr(in_path, 0, plen - 3)
                    ]
                ]
            ]
        ]
    ]
    box src = read_file(in_path) string
    // Phase arena: all concat/substr/itoa until phase_end live here
    str_phase_begin()
    // Header //!lang:xxx or #lang xxx
    box hdr = lang_header_detect(src) string
    if strlen(hdr) > 0 [
        force_lang = hdr
        src = strip_lang_header(src)
    ]
    // -Fzig / -lang= / //!lang: : rules file + user wrapped in @<lang>[ ] (bridges to Basalt)
    if strlen(force_lang) > 0 [
        box lp = str_concat("languages/", force_lang) string
        lp = str_concat(lp, ".bd")
        box lr = read_file(lp) string
        box user = src string
        if strlen(hdr) > 0 [ user = strip_lang_header(read_file(in_path)) ]
        if strlen(hdr) == 0 [ user = read_file(in_path) ]
        // pure Basalt fragments remain valid inside expanded dialect output
        box wrap = str_concat("@", force_lang) string
        wrap = str_concat(wrap, "[
")
        wrap = str_concat(wrap, user)
        wrap = str_concat(wrap, "
]
")
        if strlen(lr) > 8 [
            src = str_concat(lr, "
")
            src = str_concat(src, wrap)
        ]
        if strlen(lr) <= 8 [
            src = str_concat("@lang ", force_lang)
            src = str_concat(src, "
")
            src = str_concat(src, wrap)
        ]
    ]
    // Auto-detect @gpu → link graphics runtime
    box _gi = 0 int64
    box _gl = strlen(src) int64
    while _gi + 4 < _gl [
        if char_at(src, _gi) == 64 [
            if match_kw(src, _gi + 1, "gpu") == 1 [
                has_gpu = 1
                link_gpu = 1
                if is_bare == 1 [
                    report_error(1, 0, "aceleradores GPU/TPU/NPU/LPU no disponibles en backend bare-metal (-bare)")
                    return(1)
                ]
                report_note(1, 0, "@gpu detected: linking GPU/VRAM runtime path")
                _gi = _gl
            ]
        ]
        _gi = _gi + 1
    ]
    if src == 0 [
        print_str("error: cannot open input file '")
        print_str(in_path)
        print_str("'\n")
        return(1)
    ]
    if strlen(src) == 0 [
        return(compile_error("input file is empty"))
    ]
    if verbose == 1 [
        print_str("basaltc: read ")
        print_str(itoa(strlen(src)))
        print_str(" bytes from ")
        print_str(in_path)
        print_nl()
        print_str("basaltc: -O")
        print_str(itoa(opt))
        print_nl()
    ]
    if is_bare == 1 [
        box _ai = 0 int64
        box _al = strlen(src) int64
        box _acc = 0 int64
        while _ai + 4 < _al [
            if char_at(src, _ai) == 64 [
                if match_kw(src, _ai + 1, "gpu") == 1 [ _acc = 1 ]
                if match_kw(src, _ai + 1, "tpu") == 1 [ _acc = 1 ]
                if match_kw(src, _ai + 1, "npu") == 1 [ _acc = 1 ]
                if match_kw(src, _ai + 1, "lpu") == 1 [ _acc = 1 ]
            ]
            if match_kw(src, _ai, "vram_alloc") == 1 [ _acc = 1 ]
            if match_kw(src, _ai, "tpu_available") == 1 [ _acc = 1 ]
            if match_kw(src, _ai, "npu_available") == 1 [ _acc = 1 ]
            if match_kw(src, _ai, "lpu_available") == 1 [ _acc = 1 ]
            _ai = _ai + 1
        ]
        if _acc == 1 [
            print_str("basaltc: error: accelerators (GPU/TPU/NPU/LPU/VRAM) are not available on bare-metal (-bare)
")
            print_str("basaltc: note: use a hosted Linux or Windows target with the OS runtime
")
            return(1)
        ]
    ]
    box src0 = resolve_imports(src) string
    box src0a = apply_library(src0) string
    box src0r = rewrite_lib_calls(src0a) string
    box src1 = desugar_for(src0r) string
    box src1b = desugar_pools(src1) string
    box src1b2 = desugar_switch(src1b) string
    // type + heap analysis on high-level * / & model (before desugar to load/store)
    box nerr_early = typecheck_source(src1b2) int64
    if nerr_early > 0 [
        print_str("basaltc: ")
        print_str(itoa(nerr_early))
        print_str(" error(s)
")
        str_phase_end()
        return(1)
    ]
    box src1p = desugar_ptrs(src1b2) string
    if bal_has(src1p, "COMPILE_ERROR_MULTI_PTR") == 1 [
        str_phase_end()
        return(compile_error("pointers: only one level (*x); ** and *** are not allowed"))
    ]
    box src2 = preprocess(src1p) string
    // Comptime VM + ownership
    src2 = preprocess_comptime_vm(src2)
    if match_kw(src2, 0, "COMPTIME_ERROR") == 1 [
        print_str("error: ")
        // skip "COMPTIME_ERROR:"
        print_str(substr(src2, 15, strlen(src2) - 15))
        print_nl()
        return(1)
    ]
    src2 = rust_ownership_check(src2)
    if match_kw(src2, 0, "COMPTIME_ERROR") == 1 [
        print_str("error: ")
        print_str(substr(src2, 15, strlen(src2) - 15))
        print_nl()
        return(1)
    ]

    src2 = desugar_print_bang(src2)
    src2 = strip_type_colons(src2)
    if emit_preproc == 1 [
        print_str(src2)
        return(0)
    ]
    box ll_inj = collect_ll_injections(src2) string
    src2 = strip_ll_blocks(src2)
    if verbose == 1 [
        print_str("basaltc: preprocess done\n")
        if strlen(ll_inj) > 0 [
            print_str("basaltc: low-level blocks collected\n")
        ]
    ]
    box nerr = typecheck_source(src2) int64
    if nerr > 0 [
        print_str("basaltc: ")
        print_str(itoa(nerr))
        print_str(" error(s)\n")
        return(1)
    ]
    if verbose == 1 [
        print_str("basaltc: typecheck ok\n")
    ]
    box asm = compile_source(src2) string
    if strlen(asm) == 0 [
        str_phase_end()
        return(compile_error("codegen produced empty assembly (no BASM); check syntax, main(), and that the frontend did not strip the whole file"))
    ]
    if bir_opt >= 1 [
        box bir = basm_to_bir(asm) string
        bir = bir_dedupe(bir)
        bir = bir_optimize(bir)
        bir = bir_dedupe(bir)
        if bir_opt >= 2 [
            bir = bir_graph_vn(bir)
            bir = bir_algebra_graph(bir)
            bir = bir_dedupe(bir)
        ]
        if bir_opt >= 3 [
            bir = bir_optimize(bir)
            bir = bir_dedupe(bir)
            bir = bir_const_fold_add(bir)
            bir = bir_dedupe(bir)
        ]
        // O5 beast: extra SSA rounds
        if bir_opt >= 5 [
            bir = bir_arsenal(bir)
            bir = pow_bir_wave(bir, 3)
            bir = bir_optimize(bir)
            bir = bir_dedupe(bir)
            bir = bir_graph_vn(bir)
        ]
        // O6 max: many SSA fixpoint-ish rounds (compile time irrelevant)
        if bir_opt >= 6 [
            box _bp = 0 int64
            while _bp < 2 [
                bir = bir_optimize(bir)
                bir = bir_dedupe(bir)
                _bp = _bp + 1
            ]
            bir = bir_graph_vn(bir)
            bir = pow_bir_wave(bir, 2)
        ]
        if emit_bir == 1 [
            box bir_path = str_concat(out_path, ".bir") string
            box wb = write_file(bir_path, bir) int64
            if quiet == 0 [
                print_str("basaltc: wrote ")
                print_str(bir_path)
                print_nl()
            ]
        ]
        box lowered = bir_to_basm(bir) string
        box accept = 0 int64
        if strlen(lowered) > 32 [
            if strlen(lowered) < strlen(asm) + 512 [
                accept = 1
            ]
        ]
        if accept == 1 [
            box nlab = 0 int64
            box zi = 0 int64
            box ln = strlen(lowered) int64
            box prev_lab = 0 int64
            while zi + 1 < ln [
                if char_at(lowered, zi) == 46 [
                    if char_at(lowered, zi + 1) == 76 [
                        nlab = nlab + 1
                        // reject .L back-to-back (duplicate labels from bad lower)
                        if prev_lab == 1 [ accept = 0 ]
                        prev_lab = 1
                    ]
                ]
                if char_at(lowered, zi) == 10 [ prev_lab = 0 ]
                zi = zi + 1
            ]
            if nlab > 4 [ accept = 0 ]
            // must still look like real basm (have "    li" or "enter")
            if strstr_has(lowered, "enter") == 0 [ accept = 0 ]
            // do not accept BIR lower that broke string loads
            if strstr_has(asm, ".str") == 1 [
                if strstr_has(lowered, "loadg") == 0 [ accept = 0 ]
            ]
            if strstr_has(asm, "print_str") == 1 [
                if strstr_has(lowered, "print_str") == 0 [ accept = 0 ]
            ]
        ]
        if accept == 1 [
            asm = lowered
        ]
    ]
    // branch guard mode → sentinel in asm for nested passes
    if branch_guard == 0 [
        asm = str_concat("// branch-guard:off
", asm)
    ]
    if branch_guard == 2 [
        asm = str_concat("// branch-guard:soft
", asm)
    ]
    if blink_opt >= 1 [
        asm = optimize_asm(asm)
        // runtime-aware only if there are calls (avoid full rewrite on pure ALU)
        box _has_call = 0 int64
        box _ci = 0 int64
        box _cn = strlen(asm) int64
        while _ci + 4 < _cn [
            if char_at(asm, _ci) == 99 [
                if match_kw(asm, _ci, "call") == 1 [
                    _has_call = 1
                    _ci = _cn
                ]
            ]
            _ci = _ci + 1
        ]
        if _has_call == 1 [
            asm = bpo_runtime_aware(asm)
        ]
        asm = bpo_dce_mov(asm)
    ]
    if blink_opt >= 2 [
        asm = bpo_fold_memops(asm)
        asm = bpo_fold_inc1(asm)
        asm = bpo_clean_arith(asm)
        if do_promote == 1 [
            if basm_has_loop(asm) == 1 [
                asm = bpo_promote_loop_regs(asm)
                asm = bpo_promote_dep_loop(asm)
                asm = bpo_promote_mix_loop(asm)
                asm = bpo_math_matrix_mix(asm)
                asm = bpo_promote_abc_loop(asm)
            ]
        ]
        asm = bpo_dce_mov(asm)
    ]
    if blink_opt >= 3 [
        asm = optimize_asm(asm)
        asm = bpo_fold_memops(asm)
        if do_promote == 1 [
            asm = bpo_promote_loop_regs(asm)
        ]
    ]
    // Unroll 2x when requested (O4 default, or -funroll-loops / -fopt-extra)
    if do_unroll == 1 [
        if blink_opt < 5 [
            asm = bpo_unroll_reg_loop(asm)
        ]
    ]
    // Closed form when requested (O5 default or -fclosed-form)
    if do_closed == 1 [
        if basm_has_loop(asm) == 1 [
            asm = bpo_strength_count(asm)
            if do_promote == 1 [
                asm = bpo_promote_loop_regs(asm)
            ]
            asm = bpo_cf_arith_sum_slots(asm)
            asm = bpo_closed_form_sum(asm)
            asm = bpo_cf_arith_sum_slots(asm)
        ]
    ]
    // O5: one arsenal + one POW (no duplicate promote/closed before)
    if blink_opt >= 5 [
        asm = bpo_fold_memops(asm)
        asm = bpo_fold_inc1(asm)
        asm = bpo_clean_arith(asm)
        if do_unroll == 1 [
            if strlen(asm) < 2500 [
                asm = bpo_unroll_x4(asm)
            ]
        ]
        // Full O5 arsenal sequential (single pass — no nested bal_keep explosion)
        asm = bpo_fold_inc1(asm)
        asm = bpo_clean_arith(asm)
        asm = bpo_peep_cpu(asm)
        asm = bpo_promote_loop_regs(asm)
        if basm_is_branchy(asm) == 0 [
            asm = bpo_promote_mix_loop(asm)
            asm = bpo_math_matrix_mix(asm)
            asm = bam_try_general_affine(asm)
            asm = bpo_closed_form_sum(asm)
            asm = bpo_strength_count(asm)
            asm = bpo_promote_dep_loop(asm)
            asm = bpo_math_matrix_mix(asm)
        ]
        if do_bayes == 0 [
            if strlen(asm) < 10000 [
                if basm_is_branchy(asm) == 0 [
                    asm = bal_keep(asm, pow_optimize(asm))
                ]
            ]
        ]
        asm = bpo_peep_cpu(asm)
        asm = bpo_dce_mov(asm)
        asm = bpo_dead_li(asm)
        asm = bpo_peep_cpu(asm)
        asm = bpo_dce_mov(asm)
        asm = bpo_dead_li(asm)
    ]
    // SIMD / mass ops (auto on O5 via force_avx default, or -fvectorize/-favx)
    if do_vectorize == 1 [
        box did_vec = 0 int64
        if blink_opt >= 4 [
            asm = vectorize_basm(asm)
            asm = bpo_simd_sum_hint(asm)
            did_vec = 1
        ]
        if force_avx == 1 [
            if did_vec == 0 [
                if blink_opt >= 2 [
                    asm = vectorize_basm(asm)
                    asm = bpo_simd_sum_hint(asm)
                ]
            ]
        ]
    ]
    // -GO6: ultra GPU-specific aggressive opts (on top of CPU -O5)
    if go6 == 1 [
        asm = bpo_gpu_opt(asm)
        asm = bpo_unroll_x4(asm)
        asm = bpo_runtime_aware(asm)
        asm = bpo_dce_mov(asm)
        asm = vectorize_basm(asm)
    ]
    // -O6 second full BPO wave (math + promote + clean) — slow compile, max runtime
    if do_o6_bump == 1 [
        // O6 light bump after O5 + small bump + prepare for BAL/BAM
        // Extra promote/CF/matrix once (coverage, not 6 waves)
        if do_promote == 1 [
            if basm_has_loop(asm) == 1 [
                asm = bpo_promote_loop_regs(asm)
                asm = bpo_promote_dep_loop(asm)
                asm = bpo_promote_mix_loop(asm)
                asm = bpo_math_matrix_mix(asm)
                asm = bam_try_general_affine(asm)
                asm = bpo_promote_abc_loop(asm)
            ]
        ]
        if do_closed == 1 [
            if basm_has_loop(asm) == 1 [
                asm = bpo_strength_count(asm)
                asm = bpo_closed_form_sum(asm)
                asm = bpo_strength_mul_add(asm)
            ]
        ]
        if do_unroll == 1 [
            asm = bpo_unroll_reg_loop(asm)
            asm = bpo_unroll_x4(asm)
        ]
        asm = bpo_peep_cpu(asm)
        asm = bpo_dce_mov(asm)
        asm = bpo_dead_li(asm)
        asm = bpo_clean_arith(asm)
    ]
    // BAL + BAM beast (after O5-equivalent + O6 bump)
    if do_algebra == 1 [
        if do_bayes == 0 [
            // Full artillery once (skipped when bandit owns the stack)
            asm = bal_keep(asm, bpo_arsenal(asm))
            asm = bal_keep(asm, bal_arsenal(asm))
            asm = bal_keep(asm, bal_pow_stack(asm))
            if basm_is_branchy(asm) == 0 [
                asm = bal_keep(asm, bpo_math_matrix_mix(asm))
                asm = bal_keep(asm, bam_try_general_affine(asm))
                asm = bal_keep(asm, bpo_closed_form_sum(asm))
            ]
            asm = bal_keep(asm, bpo_peep_cpu(asm))
            asm = bal_keep(asm, bpo_dce_mov(asm))
            asm = bal_keep(asm, bpo_dead_li(asm))
        ]
    ]
    // Bayesian experimental pass bandit (-Fbayes)
    if do_bayes == 1 [
        // Arsenal + bandit (arms already cover matrix/CF/BAM)
        asm = bal_keep(asm, bal_arsenal(asm))
        asm = bandit_optimize(asm)
        asm = bal_keep(asm, bpo_peep_cpu(asm))
        asm = bal_keep(asm, bpo_dce_mov(asm))
        asm = bal_keep(asm, bpo_dead_li(asm))
    ]
    if strlen(ll_inj) > 0 [
        asm = inject_before_end(asm, ll_inj)
    ]
    if strlen(asm) == 0 [
        str_phase_end()
        return(compile_error("optimizer produced empty assembly; try -O0 or -O1 to isolate the pass, or -save-temps to inspect .basm"))
    ]
    if debug_info == 1 [
        asm = str_concat("// debug: basaltc -g\n", asm)
    ]
    box basm_path = str_concat(out_path, ".basm") string
    box w = write_file(basm_path, asm) int64
    if w < 0 [
        print_str("error: cannot write '")
        print_str(basm_path)
        print_str("'\n")
        return(1)
    ]
    print_str("basaltc: wrote ")
    print_str(basm_path)
    print_nl()
    // asm is on disk — drop whole phase arena (temps from parse/opt)
    str_phase_end()
    if emit_basm_only == 1 [
        return(0)
    ]
    if emit_obj_only == 1 [
        box obj_path = str_concat(out_path, ".o") string
        box cmd = "basm '" string
        cmd = str_concat(cmd, basm_path)
        cmd = str_concat(cmd, "' -c -o '")
        cmd = str_concat(cmd, obj_path)
        cmd = str_concat(cmd, "'")
        if verbose == 1 [
            print_str("basaltc: ")
            print_str(cmd)
            print_nl()
        ]
        box rc = system(cmd) int64
        if rc != 0 [
            return(compile_error("basm -c failed"))
        ]
        print_str("basaltc: object ")
        print_str(obj_path)
        print_nl()
        return(0)
    ]
    box cmd = "" string
    box rc = 0 int64
    // Single-step encode+link via basm (fast). blink_link is the same path CLI.
    cmd = str_concat(find_basm_exe(), " '")
    cmd = str_concat(cmd, basm_path)
    cmd = str_concat(cmd, "' -e -o '")
    cmd = str_concat(cmd, out_path)
    cmd = str_concat(cmd, str_concat("' -r '", str_concat(find_runtime_o(0), "'")))
    if is_bare == 1 [
        box _be = system("export BASALT_BARE=1 2>/dev/null") int64
        print_str("basaltc: note: bare-metal build — GPU/TPU/NPU/LPU/VRAM disabled
")
        cmd = str_concat(find_basm_exe(), " '")
        cmd = str_concat(cmd, basm_path)
        cmd = str_concat(cmd, "' -e -o '")
        cmd = str_concat(cmd, out_path)
        cmd = str_concat(cmd, str_concat("' -r '", str_concat(find_runtime_o(1), "'")))
    ]
    if verbose == 1 [
        print_str("basaltc: ")
        print_str(cmd)
        print_nl()
    ]
    rc = system(cmd)
    if rc != 0 [
        box cmd2 = str_concat(find_basm_exe(), " '") string
        cmd2 = str_concat(cmd2, basm_path)
        cmd2 = str_concat(cmd2, "' -e -o '")
        cmd2 = str_concat(cmd2, out_path)
        cmd2 = str_concat(cmd2, "'")
        rc = system(cmd2)
        if rc != 0 [
            print_str("error: link failed (basm -e encode+link)\n")
            return(1)
        ]
    ]
    // ensure executable bit for JIT/shm binaries
    box chx = str_concat("chmod +x '", out_path) string
    chx = str_concat(chx, "' 2>/dev/null")
    box rcx = system(chx) int64
    print_str("basaltc: linked ")
    print_str(out_path)
    print_nl()

    if link_gpu == 1 [
        // Auto-link graphics runtime (basalt_gpu.o)
        box gobj = "bin/basalt_gpu.o" string
        box g2 = "lib/basalt_gpu.o" string
        box g3 = "basalt_gpu.o" string
        box gpath = gobj string
        // Prefer existing path via test open - try link with each
        box gcmd = "ld -nostdlib -static -e _start -o '" string
        gcmd = str_concat(gcmd, out_path)
        gcmd = str_concat(gcmd, ".gpu' '")
        gcmd = str_concat(gcmd, out_path)
        gcmd = str_concat(gcmd, "' ")
        // simpler: gcc link shared-ish
        box gcmd2 = "gcc -o '" string
        gcmd2 = str_concat(gcmd2, out_path)
        gcmd2 = str_concat(gcmd2, "' '" )
        gcmd2 = str_concat(gcmd2, out_path)
        gcmd2 = str_concat(gcmd2, "' bin/basalt_gpu.o -pthread 2>/dev/null")
        box gr = system(gcmd2) int64
        if gr != 0 [
            gcmd2 = "gcc -o '"
            gcmd2 = str_concat(gcmd2, out_path)
            gcmd2 = str_concat(gcmd2, "' '")
            gcmd2 = str_concat(gcmd2, out_path)
            gcmd2 = str_concat(gcmd2, "' lib/basalt_gpu.o -pthread 2>/dev/null")
            gr = system(gcmd2)
        ]
        if gr != 0 [
            gcmd2 = "gcc -o '"
            gcmd2 = str_concat(gcmd2, out_path)
            gcmd2 = str_concat(gcmd2, "' '")
            gcmd2 = str_concat(gcmd2, out_path)
            gcmd2 = str_concat(gcmd2, "' basalt_gpu.o -pthread 2>/dev/null")
            gr = system(gcmd2)
        ]
        if quiet == 0 [
            if gr == 0 [
                print_str("basaltc: linked GPU runtime\n")
            ]
            if gr != 0 [
                print_str("basaltc: note: GPU runtime link skipped (object missing or reloc)\n")
            ]
        ]
    ]

    // -JIT: chmod + exec from RAM + cleanup
    if do_jit == 1 [
        box chx2 = str_concat("chmod +x '", out_path) string
        chx2 = str_concat(chx2, "' 2>/dev/null")
        box rcx2 = system(chx2) int64
        if quiet == 0 [
            print_str("basaltc: JIT ")
            print_str(out_path)
            print_nl()
        ]
        box jcmd = str_concat("/bin/bash -c '", out_path) string
        jcmd = str_concat(jcmd, "'")
        box jrc = system(jcmd) int64
        // cleanup binary + basm on tmpfs
        box rm1 = str_concat("rm -f '", out_path) string
        rm1 = str_concat(rm1, "' '")
        rm1 = str_concat(rm1, basm_path)
        rm1 = str_concat(rm1, "' 2>/dev/null")
        box rmr = system(rm1) int64
        return(jrc)
    ]
    if is_pe == 1 [
        box exe = str_concat(out_path, ".exe") string
        // Cross-compile PE32+: pe_tool extracts .text and wraps PE
        box pcmd = "pe_tool '" string
        pcmd = str_concat(pcmd, out_path)
        pcmd = str_concat(pcmd, "' '")
        pcmd = str_concat(pcmd, exe)
        pcmd = str_concat(pcmd, "'")
        box pr = system(pcmd) int64
        if pr != 0 [
            pcmd = str_concat(find_pe_tool(), " '")
            pcmd = str_concat(pcmd, out_path)
            pcmd = str_concat(pcmd, "' '")
            pcmd = str_concat(pcmd, exe)
            pcmd = str_concat(pcmd, "'")
            pr = system(pcmd)
        ]
        if pr != 0 [
            pcmd = "bin/pe_tool '"
            pcmd = str_concat(pcmd, out_path)
            pcmd = str_concat(pcmd, "' '")
            pcmd = str_concat(pcmd, exe)
            pcmd = str_concat(pcmd, "'")
            pr = system(pcmd)
        ]
        // Builtin fallback
        if pr != 0 [
            pr = link_pe(out_path, exe)
        ]
        if pr != 0 [
            pr = link_pe(basm_path, exe)
        ]
        if pr == 0 [
            print_str("basaltc: wrote PE ")
            print_str(exe)
            print_nl()
        ]
        if pr != 0 [
            print_str("error: PE cross-compile failed\n")
        ]
    ]

    return(0)
]
