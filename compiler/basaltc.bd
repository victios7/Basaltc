@cpu call_sym(name string): string [
    box b = builtin_name(name) int64
    if b == 1 [
        if strcmp(name, "print!") == 0 [ return("basalt_print") ]
        box s = "basalt_" string
        return(str_concat(s, name))
    ]
    return(name)
]

@cpu report_error(line int64, col int64, msg string): int64 [
    print_str("basaltc: error: ")
    print_str(msg)
    print_nl()
    print_str("  --> ")
    print_str(itoa(line))
    print_str(":")
    print_str(itoa(col))
    print_nl()
    print_str("   |  (compile aborted if fatal)
")
    return(0)
]

@cpu report_note(line int64, col int64, msg string): int64 [
    print_str("basaltc: note: ")
    print_str(msg)
    print_nl()
    print_str("  --> ")
    print_str(itoa(line))
    print_str(":")
    print_str(itoa(col))
    print_nl()
