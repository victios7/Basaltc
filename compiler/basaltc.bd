    return(asm)
]

@cpu bpo_fold_memops(asm string): string [
    // Fast reject: no mov r2 pattern
    if strstr_has(asm, "mov     r2") == 0 [ return(asm) ]
    box p1 = "    load    r0, s8\n    mov     r2, r0\n    load    r0, s16\n    mov     r1, r0\n    mov     r0, r2\n    add     r0, r1\n    store   s8, r0\n" string
    box r1 = "    load    r0, s8\n    load    r1, s16\n    add     r0, r1\n    store   s8, r0\n" string
    box p2 = "    load    r0, s16\n    mov     r2, r0\n    load    r0, s8\n    mov     r1, r0\n    mov     r0, r2\n    add     r0, r1\n    store   s16, r0\n" string
    box r2 = "    load    r0, s16\n    load    r1, s8\n    add     r0, r1\n    store   s16, r0\n" string
    // generic s8/s16 variants already covered; also try without leading spaces variation
    box cur = asm string
    // simple contains-replace via scan
    box out = "" string
    box i = 0 int64
    box n = strlen(cur) int64
    box pn = strlen(p1) int64
    while i < n [
        box matched = 0 int64
        if i + pn <= n [
            box slice = substr(cur, i, pn) string
            if strcmp(slice, p1) == 0 [
                out = str_concat(out, r1)
                i = i + pn
                matched = 1
            ]
        ]
        if matched == 0 [
            if i + strlen(p2) <= n [
                box slice2 = substr(cur, i, strlen(p2)) string
                if strcmp(slice2, p2) == 0 [
                    out = str_concat(out, r2)
                    i = i + strlen(p2)
                    matched = 1
                ]
            ]
        ]
        if matched == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

