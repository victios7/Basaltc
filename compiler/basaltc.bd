@cpu report_type_error(line int64, col int64, want string, got string): int64 [
    print_str("basaltc: error: type mismatch
")
    print_str("  --> ")
    print_str(itoa(line))
    print_str(":")
    print_str(itoa(col))
    print_nl()
    print_str("   |  expected `")
    print_str(want)
    print_str("`, found `")
    print_str(got)
    print_str("`
")
    return(1)
]

@cpu type_int_n(n int64): string [
    if n < 1 [ return("?") ]
    if n > 65536 [ return("?") ]
    return(str_concat("i", itoa(n)))
]

@cpu type_float_n(n int64): string [
    if n < 1 [ return("?") ]
    if n > 65536 [ return("?") ]
    return(str_concat("f", itoa(n)))
]

@cpu type_is_int(t string): int64 [
    if strlen(t) < 2 [ return(0) ]
    // iN or uN
    if char_at(t, 0) == 105 [ return(1) ]
    if char_at(t, 0) == 117 [ return(1) ]
    return(0)
]

@cpu type_is_float(t string): int64 [
    if strlen(t) < 2 [ return(0) ]
    if char_at(t, 0) == 102 [ return(1) ]
    return(0)
]

@cpu type_is_unsigned(t string): int64 [
    if strlen(t) < 2 [ return(0) ]
    if char_at(t, 0) == 117 [ return(1) ]
    return(0)
]

@cpu type_bits_of(t string): int64 [
    box n = strlen(t) int64
    if n < 2 [ return(0) ]
    box i = 1 int64
    box v = 0 int64
    while i < n [
        box d = char_at(t, i) int64
        if d >= 48 [
            if d <= 57 [
                v = v * 10 + (d - 48)
            ]
        ]
        i = i + 1
    ]
    return(v)
]

@cpu type_size_bytes(t string): int64 [
    if strcmp(t, "s") == 0 [ return(16) ]
    if strcmp(t, "p") == 0 [ return(8) ]
    if strcmp(t, "v") == 0 [ return(0) ]
    box bits = type_bits_of(t) int64
    if bits <= 0 [ return(8) ]
    box b = (bits + 7) / 8 int64
    if b < 1 [ return(1) ]
    return(b)
]

@cpu type_mask_for_bits(bits int64): int64 [
    if bits >= 64 [ return(0 - 1) ]
    if bits <= 0 [ return(0) ]
    box m = 1 int64
    box k = 0 int64
    while k < bits [
        m = m * 2
        k = k + 1
    ]
    return(m - 1)
]
@cpu emit_trunc_r0(asm string, bits int64): string [
    if bits >= 64 [ return(asm) ]
    if bits <= 0 [ return(asm) ]
    asm = emit(asm, "    andi    r0, ")
    asm = emit(asm, itoa(type_mask_for_bits(bits)))
    asm = emit(asm, "\n")
    return(asm)
]
@cpu str_replace_all(s string, old string, newv string): string [
    box out = "" string
    box i = 0 int64
    box n = strlen(s) int64
    box olen = strlen(old) int64
    if olen == 0 [ return(s) ]
    while i < n [
        box match = 0 int64
        if i + olen <= n [
            box k = 0 int64
            box ok = 1 int64
            while k < olen [
                if char_at(s, i + k) != char_at(old, k) [ ok = 0 ]
                k = k + 1
            ]
            if ok == 1 [ match = 1 ]
        ]
        if match == 1 [
            out = str_concat(out, newv)
            i = i + olen
        ]
        if match == 0 [
            out = str_concat(out, substr(s, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]
@cpu str_unescape(s string): string [
    box out = "" string
    box i = 0 int64
    box n = strlen(s) int64
    while i < n [
        box done = 0 int64
        if char_at(s, i) == 92 [
            if i + 1 < n [
                if char_at(s, i + 1) == 110 [
                    out = str_concat(out, "\n")
                    i = i + 2
                    done = 1
                ]
            ]
        ]
        if done == 0 [
            out = str_concat(out, substr(s, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]
@cpu macro_squeeze(result string): string [
    box sq = "" string
    box si = 0 int64
    box sl = strlen(result) int64
    box sp = 0 int64
    while si < sl [
        box ch = char_at(result, si) int64
        if is_space(ch) == 1 [
            if sp == 0 [
                if strlen(sq) > 0 [
                    sq = str_concat(sq, " ")
                    sp = 1
                ]
            ]
        ]
        if is_space(ch) == 0 [
            sq = str_concat(sq, substr(result, si, 1))
            sp = 0
        ]
        si = si + 1
    ]
    return(sq)
]
@cpu lang_is_reg(langs string, name string): int64 [
    box needle = str_concat("|", name) string
    needle = str_concat(needle, "|")
    box nlen = strlen(needle) int64
    box i = 0 int64
    box len = strlen(langs) int64
    while i + nlen <= len [
        box j = 0 int64
        box ok = 1 int64
        while j < nlen [
            if char_at(langs, i + j) != char_at(needle, j) [ ok = 0 ]
            j = j + 1
        ]
        if ok == 1 [ return(1) ]
        i = i + 1
    ]
    return(0)
]
@cpu rules_add(rules string, lang string, pat string, tpl string): string [
    box r = str_concat(rules, lang) string
    r = str_concat(r, "|")
    r = str_concat(r, pat)
    r = str_concat(r, "|")
    r = str_concat(r, str_unescape(tpl))
    r = str_concat(r, "#")
    return(r)
]

@cpu prelude_add(pre string, lang string, code string): string [
    box r = str_concat(pre, lang) string
    r = str_concat(r, "|")
    r = str_concat(r, str_unescape(code))
    r = str_concat(r, "#")
    return(r)
]

@cpu prelude_get(pre string, lang string): string [
    box mi = 0 int64
    box mlen = strlen(pre) int64
    while mi < mlen [
        box mns = mi int64
        while char_at(pre, mi) != 124 [
            if mi >= mlen [ return("") ]
            if mi < mlen [
                if char_at(pre, mi) != 124 [ mi = mi + 1 ]
            ]
        ]
        box rlang = substr(pre, mns, mi - mns) string
        mi = mi + 1
        box mbs = mi int64
        while char_at(pre, mi) != 35 [
            if mi >= mlen [ return("") ]
            if mi < mlen [
                if char_at(pre, mi) != 35 [ mi = mi + 1 ]
            ]
        ]
        box code = substr(pre, mbs, mi - mbs) string
        mi = mi + 1
        if strcmp(rlang, lang) == 0 [ return(code) ]
    ]
    return("")
]

@cpu parse_quoted(src string, i int64, len int64): string [
    i = skip_ws_c(src, i, len)
    if i >= len [ return(":") ]
    if char_at(src, i) != 34 [ return(str_concat(":", itoa(i))) ]
    i = i + 1
    box ss = i int64
    while i < len [
        if char_at(src, i) == 34 [
            box body = substr(src, ss, i - ss) string
            i = i + 1
            return(str_concat(body, str_concat(":", itoa(i))))
        ]
        i = i + 1
    ]
    return(str_concat(substr(src, ss, i - ss), str_concat(":", itoa(i))))
]

@cpu rule_is_rest(name string): int64 [
    if strcmp(name, "rest") == 0 [ return(1) ]
    if strcmp(name, "_") == 0 [ return(1) ]
    return(0)
]

@cpu rule_try(pat string, line string, tpl string): string [
    box plen = strlen(pat) int64
    box llen = strlen(line) int64
    box pi = 0 int64
    box li = 0 int64
    box cn = "" string
    box cv = "" string
    box steps = 0 int64
    box failed = 0 int64
    while failed == 0 [
        steps = steps + 1
        if steps > 4096 [ failed = 1 ]
        if failed == 0 [
            if pi >= plen [
                if li >= llen [ failed = 2 ]
                if li < llen [ failed = 1 ]
            ]
        ]
        if failed == 0 [
            box chp = char_at(pat, pi) int64
            if chp == 36 [
                pi = pi + 1
                box ns = pi int64
                box name_end = 0 int64
                while name_end == 0 [
                    if pi >= plen [ name_end = 1 ]
                    if pi < plen [
                        if is_alnum(char_at(pat, pi)) == 1 [ pi = pi + 1 ]
                        if is_alnum(char_at(pat, pi)) == 0 [ name_end = 1 ]
                    ]
                ]
                box name = substr(pat, ns, pi - ns) string
                box vs = li int64
                if rule_is_rest(name) == 1 [
                    li = llen
                ]
                if rule_is_rest(name) == 0 [
                    if pi >= plen [
                        li = llen
                    ]
                    if pi < plen [
                        box nextc = char_at(pat, pi) int64
                        box c2 = 0 int64
                        while c2 == 0 [
                            if li >= llen [ c2 = 1 ]
                            if li < llen [
                                if char_at(line, li) == nextc [ c2 = 1 ]
                                if c2 == 0 [ li = li + 1 ]
                            ]
                            if steps > 4090 [ c2 = 1 ]
                            steps = steps + 1
                        ]
                    ]
                ]
                box val = substr(line, vs, li - vs) string
                cn = str_concat(cn, name)
                cn = str_concat(cn, "|")
                cv = str_concat(cv, val)
                cv = str_concat(cv, "|")
            ]
            if chp != 36 [
                if failed == 0 [
                    if pi < plen [
                        if li >= llen [ failed = 1 ]
                        if li < llen [
                            if char_at(pat, pi) != char_at(line, li) [ failed = 1 ]
                            if failed == 0 [
                                pi = pi + 1
                                li = li + 1
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]
    if failed != 2 [ return("") ]
    box out = tpl string
    box ci = 0 int64
    box cvi = 0 int64
    while ci < strlen(cn) [
        box ns = ci int64
        while char_at(cn, ci) != 124 [
            if ci >= strlen(cn) [ ci = strlen(cn) ]
            if ci < strlen(cn) [
                if char_at(cn, ci) != 124 [ ci = ci + 1 ]
            ]
        ]
        box name = substr(cn, ns, ci - ns) string
        if ci < strlen(cn) [ ci = ci + 1 ]
        box vs = cvi int64
        while char_at(cv, cvi) != 124 [
            if cvi >= strlen(cv) [ cvi = strlen(cv) ]
            if cvi < strlen(cv) [
                if char_at(cv, cvi) != 124 [ cvi = cvi + 1 ]
            ]
        ]
        box val = substr(cv, vs, cvi - vs) string
        if cvi < strlen(cv) [ cvi = cvi + 1 ]
        if strlen(name) > 0 [
            if strcmp(name, "_") != 0 [
                out = str_replace_all(out, str_concat("$", name), val)
            ]
        ]
    ]
    return(macro_squeeze(out))
]

@cpu line_looks_basalt(line string): int64 [
    box t = macro_squeeze(line) string
    if strlen(t) == 0 [ return(1) ]
    if char_at(t, 0) == 47 [
        if char_at(t, 1) == 47 [ return(1) ]
    ]
    if match_kw(t, 0, "box") == 1 [ return(1) ]
    if match_kw(t, 0, "if") == 1 [ return(1) ]
    if match_kw(t, 0, "while") == 1 [ return(1) ]
    if match_kw(t, 0, "return") == 1 [ return(1) ]
    if match_kw(t, 0, "print_int") == 1 [ return(1) ]
    if match_kw(t, 0, "print_str") == 1 [ return(1) ]
    if match_kw(t, 0, "print_nl") == 1 [ return(1) ]
    if match_kw(t, 0, "print!") == 1 [ return(1) ]
    if match_kw(t, 0, "call") == 1 [ return(1) ]
    if match_kw(t, 0, "ret") == 1 [ return(1) ]
    if match_kw(t, 0, "@cpu") == 1 [ return(1) ]
    if match_kw(t, 0, "else") == 1 [ return(1) ]
    if is_alpha(char_at(t, 0)) == 1 [
        box j = 0 int64
        while is_alnum(char_at(t, j)) == 1 [ j = j + 1 ]
        while is_space(char_at(t, j)) == 1 [ j = j + 1 ]
        if char_at(t, j) == 61 [ return(1) ]
    ]
    if char_at(t, 0) == 93 [ return(1) ]
    if char_at(t, 0) == 91 [ return(1) ]
    return(0)
]

@cpu rules_apply_line(rules string, lang string, line string): string [
    // Longest pattern match wins — enables full meta-languages without rule order traps
    box line2 = macro_squeeze(line) string
    if strlen(line2) == 0 [ return("") ]
    if char_at(line2, 0) == 47 [
        if char_at(line2, 1) == 47 [ return(line2) ]
    ]
    box best = "" string
    box best_pl = 0 - 1 int64
    box mi = 0 int64
    box mlen = strlen(rules) int64
    while mi < mlen [
        box mns = mi int64
        while char_at(rules, mi) != 124 [
            if mi >= mlen [ mi = mlen ]
            if mi < mlen [
                if char_at(rules, mi) != 124 [ mi = mi + 1 ]
            ]
        ]
        if mi >= mlen [
            // done
            mi = mlen
        ]
        if mi < mlen [
            box rlang = substr(rules, mns, mi - mns) string
            mi = mi + 1
            box mps = mi int64
            while char_at(rules, mi) != 124 [
                if mi >= mlen [ mi = mlen ]
                if mi < mlen [
                    if char_at(rules, mi) != 124 [ mi = mi + 1 ]
                ]
            ]
            if mi < mlen [
                box pat = substr(rules, mps, mi - mps) string
                mi = mi + 1
                box mbs = mi int64
                while char_at(rules, mi) != 35 [
                    if mi >= mlen [ mi = mlen ]
                    if mi < mlen [
                        if char_at(rules, mi) != 35 [ mi = mi + 1 ]
                    ]
                ]
                if mi < mlen [
                    box tpl = substr(rules, mbs, mi - mbs) string
                    mi = mi + 1
                    if strcmp(rlang, lang) == 0 [
                        box exp = rule_try(pat, line2, tpl) string
                        if strlen(exp) > 0 [
                            box pl = strlen(pat) int64
                            if pl > best_pl [
                                best_pl = pl
                                best = exp
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]
    if best_pl >= 0 [ return(best) ]
    if line_looks_basalt(line2) == 1 [ return(line2) ]
    return(str_concat("// unmatched:", line2))
]

@cpu expand_lang_block(rules string, macros string, lname string, body string): string [
    box cur = body string
    box pass = 0 int64
    while pass < 16 [
        box out = "" string
        box i = 0 int64
        box n = strlen(cur) int64
        box ls = 0 int64
        box changed = 0 int64
        while i <= n [
            box end = 0 int64
            if i == n [ end = 1 ]
            if i < n [
                if char_at(cur, i) == 10 [ end = 1 ]
            ]
            if end == 1 [
                box line = substr(cur, ls, i - ls) string
                box exp = rules_apply_line(rules, lname, line) string
                if strcmp(exp, macro_squeeze(line)) != 0 [
                    if strlen(macro_squeeze(line)) > 0 [ changed = 1 ]
                ]
                if strlen(exp) > 0 [
                    out = str_concat(out, exp)
                    out = str_concat(out, "\n")
                ]
                ls = i + 1
            ]
            i = i + 1
        ]
        cur = out
        if changed == 0 [ pass = 16 ]
        if changed == 1 [ pass = pass + 1 ]
        if pass >= 16 [ pass = 16 ]
    ]
    return(cur)
]

@cpu expand_lang_block_full(rules string, pre string, macros string, lname string, body string): string [
    box head = prelude_get(pre, lname) string
    box body2 = expand_lang_block(rules, macros, lname, body) string
    if strlen(head) == 0 [ return(body2) ]
    return(str_concat(str_concat(head, "\n"), body2))
]


@cpu peek_type_bits(src string, i int64, len int64): int64 [
    i = skip_ws_c(src, i, len)
    if match_kw(src, i, "int8") == 1 [ return(8) ]
    if match_kw(src, i, "int16") == 1 [ return(16) ]
    if match_kw(src, i, "int32") == 1 [ return(32) ]
    if match_kw(src, i, "int64") == 1 [ return(64) ]
    return(64)
]

@cpu type_arith(a string, b string): string [
    if type_is_int(a) == 1 [
        if type_is_int(b) == 1 [
            box ba = type_bits_of(a) int64
            box bb = type_bits_of(b) int64
            if ba >= bb [ return(a) ]
            return(b)
        ]
    ]
    if type_is_float(a) == 1 [
        if type_is_float(b) == 1 [
            box ba = type_bits_of(a) int64
            box bb = type_bits_of(b) int64
            if ba >= bb [ return(a) ]
            return(b)
        ]
    ]
    return("?")
]

@cpu type_name_human(t string): string [
    if strcmp(t, "s") == 0 [ return("string") ]
    if strcmp(t, "p") == 0 [ return("ptr") ]
    if strcmp(t, "v") == 0 [ return("void") ]
    if strcmp(t, "?") == 0 [ return("invalid") ]
    if type_is_unsigned(t) == 1 [
        return(str_concat("uint", itoa(type_bits_of(t))))
    ]
    if type_is_int(t) == 1 [
        return(str_concat("int", itoa(type_bits_of(t))))
    ]
    if type_is_float(t) == 1 [
        return(str_concat("float", itoa(type_bits_of(t))))
    ]
    return(t)
]

@cpu parse_type_at(src string, i int64, len int64): string [
    // Zig-like intN / floatN / uN + names. Storage still 64-bit regs; narrow via mask.
    i = skip_ws_c(src, i, len)
    if i >= len [ return("?:0") ]
    // --- named ints ---
    if match_kw(src, i, "int64") == 1 [ return(str_concat(type_int_n(64), str_concat(":", itoa(i + 5)))) ]
    if match_kw(src, i, "int32") == 1 [ return(str_concat(type_int_n(32), str_concat(":", itoa(i + 5)))) ]
    if match_kw(src, i, "int16") == 1 [ return(str_concat(type_int_n(16), str_concat(":", itoa(i + 5)))) ]
    if match_kw(src, i, "int8") == 1 [ return(str_concat(type_int_n(8), str_concat(":", itoa(i + 4)))) ]
    if match_kw(src, i, "int128") == 1 [ return(str_concat(type_int_n(64), str_concat(":", itoa(i + 6)))) ]
    if match_kw(src, i, "int256") == 1 [ return(str_concat(type_int_n(64), str_concat(":", itoa(i + 6)))) ]
    if match_kw(src, i, "isize") == 1 [ return(str_concat(type_int_n(64), str_concat(":", itoa(i + 5)))) ]
    if match_kw(src, i, "usize") == 1 [
        return(str_concat("u", str_concat(itoa(64), str_concat(":", itoa(i + 5)))))
    ]
    if match_kw(src, i, "bool") == 1 [ return(str_concat(type_int_n(1), str_concat(":", itoa(i + 4)))) ]
    // --- named floats ---
    if match_kw(src, i, "float64") == 1 [ return(str_concat(type_float_n(64), str_concat(":", itoa(i + 7)))) ]
    if match_kw(src, i, "float32") == 1 [ return(str_concat(type_float_n(32), str_concat(":", itoa(i + 7)))) ]
    if match_kw(src, i, "float16") == 1 [ return(str_concat(type_float_n(16), str_concat(":", itoa(i + 7)))) ]
    if match_kw(src, i, "float128") == 1 [ return(str_concat(type_float_n(64), str_concat(":", itoa(i + 8)))) ]
    if match_kw(src, i, "string") == 1 [ return(str_concat("s", str_concat(":", itoa(i + 6)))) ]
    if match_kw(src, i, "void") == 1 [ return(str_concat("v", str_concat(":", itoa(i + 4)))) ]
    if match_kw(src, i, "ptr") == 1 [ return(str_concat("p", str_concat(":", itoa(i + 3)))) ]
    if match_kw(src, i, "null") == 1 [ return(str_concat("p", str_concat(":", itoa(i + 4)))) ]
    // int<N>  float<N>
    if match_kw(src, i, "int") == 1 [
        box j = i + 3 int64
        if j < len [
            if char_at(src, j) == 60 [
                j = j + 1
                box bits = 0 int64
                while j < len [
                    box d = char_at(src, j) int64
                    if d >= 48 [
                        if d <= 57 [
                            bits = bits * 10 + (d - 48)
                            j = j + 1
                        ]
                    ]
                    if d == 62 [
                        j = j + 1
                        return(str_concat(type_int_n(bits), str_concat(":", itoa(j))))
                    ]
                    if d < 48 [
                        if d != 62 [ j = len ]
                    ]
                    if d > 57 [
                        if d != 62 [ j = len ]
                    ]
                ]
                return(str_concat("?:", itoa(j)))
            ]
        ]
        // bare int → i64
        return(str_concat(type_int_n(64), str_concat(":", itoa(j))))
    ]
    if match_kw(src, i, "float") == 1 [
        box j = i + 5 int64
        if j < len [
            if char_at(src, j) == 60 [
                j = j + 1
                box bits = 0 int64
                while j < len [
                    box d = char_at(src, j) int64
                    if d >= 48 [
                        if d <= 57 [
                            bits = bits * 10 + (d - 48)
                            j = j + 1
                        ]
                    ]
                    if d == 62 [
                        j = j + 1
                        return(str_concat(type_float_n(bits), str_concat(":", itoa(j))))
                    ]
                    if d < 48 [
                        if d != 62 [ j = len ]
                    ]
                    if d > 57 [
                        if d != 62 [ j = len ]
                    ]
                ]
                return(str_concat("?:", itoa(j)))
            ]
        ]
        return(str_concat(type_float_n(64), str_concat(":", itoa(j))))
    ]
    // Zig-style iN / uN / fN (letter + digits)
    if char_at(src, i) == 105 [
        // i + digits
        if i + 1 < len [
            if is_digit(char_at(src, i + 1)) == 1 [
                box j = i + 1 int64
                box bits = 0 int64
                while j < len [
                    if is_digit(char_at(src, j)) == 1 [
                        bits = bits * 10 + (char_at(src, j) - 48)
                        j = j + 1
                    ]
                    if is_digit(char_at(src, j)) == 0 [ j = len ]
                ]
                // restore j
                j = i + 1
                bits = 0
                while j < len [
                    if is_digit(char_at(src, j)) == 1 [
                        bits = bits * 10 + (char_at(src, j) - 48)
                        j = j + 1
                    ]
                    if is_digit(char_at(src, j)) == 0 [
                        return(str_concat(type_int_n(bits), str_concat(":", itoa(j))))
                    ]
                ]
                return(str_concat(type_int_n(bits), str_concat(":", itoa(j))))
            ]
        ]
    ]
    if char_at(src, i) == 117 [
        if i + 1 < len [
            if is_digit(char_at(src, i + 1)) == 1 [
                box j = i + 1 int64
                box bits = 0 int64
                while j < len [
                    if is_digit(char_at(src, j)) == 1 [
                        bits = bits * 10 + (char_at(src, j) - 48)
                        j = j + 1
                    ]
                    if is_digit(char_at(src, j)) == 0 [
                        return(str_concat(str_concat("u", itoa(bits)), str_concat(":", itoa(j))))
                    ]
                ]
                return(str_concat(str_concat("u", itoa(bits)), str_concat(":", itoa(j))))
            ]
        ]
    ]
    if char_at(src, i) == 102 [
        if i + 1 < len [
            if is_digit(char_at(src, i + 1)) == 1 [
                box j = i + 1 int64
                box bits = 0 int64
                while j < len [
                    if is_digit(char_at(src, j)) == 1 [
                        bits = bits * 10 + (char_at(src, j) - 48)
                        j = j + 1
                    ]
                    if is_digit(char_at(src, j)) == 0 [
                        return(str_concat(type_float_n(bits), str_concat(":", itoa(j))))
                    ]
                ]
                return(str_concat(type_float_n(bits), str_concat(":", itoa(j))))
            ]
        ]
    ]
    // *T
    if char_at(src, i) == 42 [
        box j = i + 1 int64
        j = skip_ws_c(src, j, len)
        box inner = parse_type_at(src, j, len) string
        box ip = pos_from_parse(inner) int64
        return(str_concat("p", str_concat(":", itoa(ip))))
    ]
    return(str_concat("?:", itoa(i)))
]

@cpu type_from_parse(payload string): string [
    box n = strlen(payload) int64
    box i = 0 int64
    while i < n [
        if char_at(payload, i) == 58 [
            return(substr(payload, 0, i))
        ]
        i = i + 1
    ]
    return("?")
]

@cpu pos_from_parse(payload string): int64 [
    box n = strlen(payload) int64
    box i = 0 int64
    while i < n [
        if char_at(payload, i) == 58 [
            box v = 0 int64
            box j = i + 1 int64
            while j < n [
                box d = char_at(payload, j) int64
                if d >= 48 [
                    if d <= 57 [
                        v = v * 10 + (d - 48)
                    ]
                ]
                j = j + 1
            ]
            return(v)
        ]
        i = i + 1
    ]
    return(0)
]

@cpu tenv_put(env string, name string, ty string): string [
    box x = str_concat(env, name) string
    x = str_concat(x, ":")
    x = str_concat(x, ty)
    return(str_concat(x, ";"))
]

@cpu tenv_get(env string, name string): string [
    box dlen = strlen(env) int64
    box di = 0 int64
    while di < dlen [
        box start = di int64
        box colon = 0 - 1 int64
        box semi = 0 - 1 int64
        while di < dlen [
            box ch = char_at(env, di) int64
            if ch == 58 [
                if colon < 0 [ colon = di ]
            ]
            if ch == 59 [
                semi = di
                di = dlen
            ]
            if di < dlen [ di = di + 1 ]
        ]
        if colon >= 0 [
            if semi >= 0 [
                box nm = substr(env, start, colon - start) string
                if strcmp(nm, name) == 0 [
                    return(substr(env, colon + 1, semi - colon - 1))
                ]
                di = semi + 1
            ]
        ]
        if colon < 0 [ di = dlen ]
        if semi < 0 [ di = dlen ]
    ]
    return("?")
]

@cpu expr_skip_primary(src string, i int64, len int64): int64 [
    i = skip_ws_c(src, i, len)
    if i >= len [ return(i) ]
    box c = char_at(src, i) int64
    if is_digit(c) == 1 [
        while i < len [
            if is_digit(char_at(src, i)) == 1 [ i = i + 1 ]
            if is_digit(char_at(src, i)) == 0 [ return(i) ]
        ]
        return(i)
    ]
    if is_alpha(c) == 1 [
        while i < len [
            if is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
            if is_alnum(char_at(src, i)) == 0 [ return(i) ]
        ]
        return(i)
    ]
    if c == 40 [
        i = i + 1
        i = expr_skip(src, i, len)
        i = skip_ws_c(src, i, len)
        if i < len [
            if char_at(src, i) == 41 [ i = i + 1 ]
        ]
        return(i)
    ]
    return(i)
]

@cpu expr_skip(src string, i int64, len int64): int64 [
    i = expr_skip_primary(src, i, len)
    box cont = 1 int64
    while cont == 1 [
        i = skip_ws_c(src, i, len)
        if i >= len [
            cont = 0
        ]
        if cont == 1 [
            box op = char_at(src, i) int64
            if op == 43 [ i = i + 1 ]
            if op == 45 [ i = i + 1 ]
            if op == 42 [ i = i + 1 ]
            if op == 47 [ i = i + 1 ]
            if op != 43 [
                if op != 45 [
                    if op != 42 [
                        if op != 47 [ cont = 0 ]
                    ]
                ]
            ]
            if cont == 1 [
                i = expr_skip_primary(src, i, len)
            ]
        ]
    ]
    return(i)
]

@cpu emit_primary_r0(asm string, src string, i int64, len int64, dict string): string [
    i = skip_ws_c(src, i, len)
    box c = char_at(src, i) int64
    // *p — load through pointer (systems)
    if c == 42 [
        i = i + 1
        i = skip_ws_c(src, i, len)
        asm = emit_primary_r0(asm, src, i, len, dict)
        asm = emit(asm, "    loadm   r0, r0
")
        return(asm)
    ]
    // &x — address of stack slot as opaque handle (slot index * 8); real heap ptrs from alloc
    if c == 38 [
        i = i + 1
        i = skip_ws_c(src, i, len)
        if is_alpha(char_at(src, i)) == 1 [
            box ns = i int64
            while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
            box nm = substr(src, ns, i - ns) string
            box off = dict_get(dict, nm) int64
            if off > 0 [
                asm = emit(asm, "    li      r0, ")
                asm = emit(asm, itoa(off))
                asm = emit(asm, "
")
            ]
            if off <= 0 [
                asm = emit(asm, "    li      r0, 0
")
            ]
            return(asm)
        ]
    ]
    // null pointer literal
    if match_kw(src, i, "null") == 1 [
        asm = emit(asm, "    li      r0, 0
")
        return(asm)
    ]
    if is_digit(c) == 1 [
        box v = 0 int64
        while is_digit(char_at(src, i)) == 1 [
            v = v * 10 + (char_at(src, i) - 48)
            i = i + 1
        ]
        asm = emit(asm, "    li      r0, ")
        asm = emit(asm, itoa(v))
        asm = emit(asm, "\n")
        return(asm)
    ]
    if is_alpha(c) == 1 [
        box ns = i int64
        while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
        box nm = substr(src, ns, i - ns) string
        box off = dict_get(dict, nm) int64
        if off > 0 [
            asm = emit(asm, "    load    r0, s")
            asm = emit(asm, itoa(off))
            asm = emit(asm, "\n")
        ]
        if off <= 0 [
            asm = emit(asm, "    li      r0, 0\n")
        ]
        return(asm)
    ]
    if c == 40 [
        box j = i + 1 int64
        j = skip_ws_c(src, j, len)
        asm = emit_expr_r0(asm, src, j, len, dict)
        return(asm)
    ]
    return(asm)
]

@cpu emit_term_r0(asm string, src string, i int64, len int64, dict string): string [
    // primary with * /  (tighter than + -)
    i = skip_ws_c(src, i, len)
    asm = emit_primary_r0(asm, src, i, len, dict)
    i = expr_skip_primary(src, i, len)
    box cont = 1 int64
    while cont == 1 [
        i = skip_ws_c(src, i, len)
        if i >= len [ cont = 0 ]
        if cont == 1 [
            box op = char_at(src, i) int64
            box isop = 0 int64
            if op == 42 [ isop = 1 ]
            if op == 47 [ isop = 1 ]
            if isop == 0 [ cont = 0 ]
            if isop == 1 [
                i = i + 1
                asm = emit(asm, "    mov     r1, r0\n")
                asm = emit_primary_r0(asm, src, i, len, dict)
                i = expr_skip_primary(src, i, len)
                if op == 42 [
                    asm = emit(asm, "    mul     r0, r1\n")
                ]
                if op == 47 [
                    asm = emit(asm, "    mov     r3, r0\n")
                    asm = emit(asm, "    mov     r0, r1\n")
                    asm = emit(asm, "    div     r0, r3\n")
                ]
            ]
        ]
    ]
    return(asm)
]

@cpu expr_skip_term(src string, i int64, len int64): int64 [
    i = expr_skip_primary(src, i, len)
    box cont = 1 int64
    while cont == 1 [
        i = skip_ws_c(src, i, len)
        if i >= len [ cont = 0 ]
        if cont == 1 [
            box op = char_at(src, i) int64
            if op == 42 [
                i = i + 1
                i = expr_skip_primary(src, i, len)
            ]
            if op == 47 [
                i = i + 1
                i = expr_skip_primary(src, i, len)
            ]
            if op != 42 [
                if op != 47 [ cont = 0 ]
            ]
        ]
    ]
    return(i)
]

@cpu emit_expr_r0(asm string, src string, i int64, len int64, dict string): string [
    // term (+ term)*   with correct * / precedence
    i = skip_ws_c(src, i, len)
    asm = emit_term_r0(asm, src, i, len, dict)
    i = expr_skip_term(src, i, len)
    box cont = 1 int64
    while cont == 1 [
        i = skip_ws_c(src, i, len)
        if i >= len [ cont = 0 ]
        if cont == 1 [
            box op = char_at(src, i) int64
            box isop = 0 int64
            if op == 43 [ isop = 1 ]
            if op == 45 [ isop = 1 ]
            if isop == 0 [ cont = 0 ]
            if isop == 1 [
                i = i + 1
                asm = emit(asm, "    mov     r1, r0\n")
                asm = emit_term_r0(asm, src, i, len, dict)
                i = expr_skip_term(src, i, len)
                if op == 43 [
                    asm = emit(asm, "    add     r0, r1\n")
                ]
                if op == 45 [
                    asm = emit(asm, "    mov     r2, r1\n")
                    asm = emit(asm, "    sub     r2, r0\n")
                    asm = emit(asm, "    mov     r0, r2\n")
                ]
            ]
        ]
    ]
    return(asm)
]

@cpu emit_call_args(asm string, src string, i int64, len int64, dict string): string [
    box argn = 0 int64
    i = skip_ws_c(src, i, len)
    if char_at(src, i) == 41 [
        return(asm)
    ]
    box done = 0 int64
    while done == 0 [
        i = skip_ws_c(src, i, len)
        if i >= len [
            done = 1
        ]
        if done == 0 [
            box c = char_at(src, i) int64
            if c == 41 [
                done = 1
            ]
        ]
        if done == 0 [
            box c = char_at(src, i) int64
            if is_digit(c) == 1 [
                box v = 0 int64
                while is_digit(c) == 1 [
                    v = v * 10 + (c - 48)
                    i = i + 1
                    c = char_at(src, i)
                ]
                asm = emit(asm, "    li      r0, ")
                asm = emit(asm, itoa(v))
                asm = emit(asm, "\n    arg     a")
                asm = emit(asm, itoa(argn))
                asm = emit(asm, ", r0\n")
                argn = argn + 1
            ]
            if is_alpha(c) == 1 [
                box ns = i int64
                while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                box nm = substr(src, ns, i - ns) string
                box off = dict_get(dict, nm) int64
                if off > 0 [
                    asm = emit(asm, "    load    r0, s")
                    asm = emit(asm, itoa(off))
                    asm = emit(asm, "\n    arg     a")
                    asm = emit(asm, itoa(argn))
                    asm = emit(asm, ", r0\n")
                    argn = argn + 1
                ]
            ]
            if c == 34 [
                i = i + 1
                while i < len [
                    if char_at(src, i) == 34 [
                        i = i + 1
                        i = i
                    ]
                    if i < len [
                        if char_at(src, i) != 34 [ i = i + 1 ]
                    ]
                ]
            ]
            i = skip_ws_c(src, i, len)
            if i < len [
                if char_at(src, i) == 44 [
                    i = i + 1
                ]
            ]
            if i < len [
                if char_at(src, i) == 41 [
                    done = 1
                ]
            ]
            if argn >= 6 [
                done = 1
            ]
        ]
    ]
    return(asm)
]

@cpu desugar_for(src string): string [
    box len = strlen(src) int64
    box out = "" string
    box i = 0 int64
    while i < len [
        box hit = 0 int64
        if i + 4 < len [
            if char_at(src, i) == 102 [
                if char_at(src, i + 1) == 111 [
                    if char_at(src, i + 2) == 114 [
                        if is_space(char_at(src, i + 3)) == 1 [
                            box save = i int64
                            i = i + 3
                            while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                            if is_alpha(char_at(src, i)) == 1 [
                                box ns = i int64
                                while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                box name = substr(src, ns, i - ns) string
                                while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                                if char_at(src, i) == 61 [
                                    i = i + 1
                                    while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                                    if is_digit(char_at(src, i)) == 1 [
                                        box ss = i int64
                                        while is_digit(char_at(src, i)) == 1 [ i = i + 1 ]
                                        box st = substr(src, ss, i - ss) string
                                        while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                                        if char_at(src, i) == 116 [
                                            if char_at(src, i + 1) == 111 [
                                                i = i + 2
                                                while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                                                if is_digit(char_at(src, i)) == 1 [
                                                    box es = i int64
                                                    while is_digit(char_at(src, i)) == 1 [ i = i + 1 ]
                                                    box en = substr(src, es, i - es) string
                                                    while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                                                    if char_at(src, i) == 91 [
                                                        i = i + 1
                                                        box depth = 1 int64
                                                        box bs = i int64
                                                        while depth > 0 [
                                                            if i >= len [ depth = 0 ]
                                                            if i < len [
                                                                box ch = char_at(src, i) int64
                                                                if ch == 91 [ depth = depth + 1 ]
                                                                if ch == 93 [ depth = depth - 1 ]
                                                                if depth > 0 [ i = i + 1 ]
                                                            ]
                                                        ]
                                                        box body = substr(src, bs, i - bs) string
                                                        if char_at(src, i) == 93 [ i = i + 1 ]
                                                        hit = 1
                                                        out = str_concat(out, "box ")
                                                        out = str_concat(out, name)
                                                        out = str_concat(out, " = ")
                                                        out = str_concat(out, st)
                                                        out = str_concat(out, " int32\nwhile ")
                                                        out = str_concat(out, name)
                                                        out = str_concat(out, " < ")
                                                        out = str_concat(out, en)
                                                        out = str_concat(out, " [\n")
                                                        out = str_concat(out, body)
                                                        out = str_concat(out, "\n")
                                                        out = str_concat(out, name)
                                                        out = str_concat(out, " = ")
                                                        out = str_concat(out, name)
                                                        out = str_concat(out, " + 1\n]\n")
                                                    ]
                                                ]
                                            ]
                                        ]
                                    ]
                                ]
                            ]
                            if hit == 0 [ i = save ]
                        ]
                    ]
                ]
            ]
        ]
        if hit == 0 [
            if i < len [
                out = str_concat(out, substr(src, i, 1))
                i = i + 1
            ]
        ]
    ]
    return(out)
]

@cpu import_read(path string): string [
    if strcmp(path, "std") == 0 [
        box s = read_file("std/std.bd") string
        if strlen(s) > 0 [ return(s) ]
        box h = read_file("std/hl.bd") string
        if strlen(h) > 0 [ return(h) ]
        return("// std native\n")
    ]
    box inc = read_file(path) string
    if strlen(inc) > 0 [ return(inc) ]
    box n = strlen(path) int64
    box has_dot = 0 int64
    box k = 0 int64
    while k < n [
        if char_at(path, k) == 46 [ has_dot = 1 ]
        k = k + 1
    ]
    if has_dot == 0 [
        box p2 = str_concat(path, ".bd") string
        inc = read_file(p2)
        if strlen(inc) > 0 [ return(inc) ]
        // std/path.bd
        box p3 = str_concat("std/", p2) string
        inc = read_file(p3)
        if strlen(inc) > 0 [ return(inc) ]
        box p4 = str_concat("std/", path) string
        inc = read_file(p4)
        if strlen(inc) > 0 [ return(inc) ]
    ]
    if has_dot == 1 [
        box p5 = str_concat("std/", path) string
        inc = read_file(p5)
        if strlen(inc) > 0 [ return(inc) ]
    ]
    // Rocktorch → std/rocktorch.bd
    if strcmp(path, "Rocktorch") == 0 [
        inc = read_file("std/rocktorch.bd")
        if strlen(inc) > 0 [ return(inc) ]
    ]
    if strcmp(path, "rocktorch") == 0 [
        inc = read_file("std/rocktorch.bd")
        if strlen(inc) > 0 [ return(inc) ]
    ]
    if strcmp(path, "hl") == 0 [

        inc = read_file("std/hl.bd")
        if strlen(inc) > 0 [ return(inc) ]
    ]
    if strcmp(path, "std/hl") == 0 [
        inc = read_file("std/hl.bd")
        if strlen(inc) > 0 [ return(inc) ]
    ]
    return("")
]

@cpu resolve_imports_depth(src string, depth int64): string [
    box len = strlen(src) int64
    box out = "" string
    box i = 0 int64
    while i < len [
        if depth > 16 [
            return(str_concat(out, substr(src, i, len - i)))
        ]
        box imp = 0 int64
        if match_kw(src, i, "@import") == 1 [ imp = 1 ]
        if match_kw(src, i, "@include") == 1 [ imp = 2 ]
        if imp >= 1 [
            box j = i + 7 int64
            if imp == 2 [ j = i + 8 ]
            while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
            // --- multi: ("a" "b") ---
            if char_at(src, j) == 40 [
                j = j + 1
                box mdone = 0 int64
                while mdone == 0 [
                    while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                    if j >= len [ mdone = 1 ]
                    if mdone == 0 [
                        if char_at(src, j) == 41 [
                            j = j + 1
                            mdone = 1
                        ]
                    ]
                    if mdone == 0 [
                        if char_at(src, j) == 34 [
                            j = j + 1
                            box ps = j int64
                            box qdone = 0 int64
                            while qdone == 0 [
                                if j >= len [ qdone = 1 ]
                                if qdone == 0 [
                                    if char_at(src, j) == 34 [
                                        box path = substr(src, ps, j - ps) string
                                        j = j + 1
                                        qdone = 1
                                        box inc = import_read(path) string
                                        if strlen(inc) == 0 [
                                            report_error(1, 0, str_concat("failed to resolve @import \"", str_concat(path, "\" (tried path, .bd, std/)")))
                                        ]
                                        if strlen(inc) > 0 [
                                            box nested = resolve_imports_depth(inc, depth + 1) string
                                            out = str_concat(out, nested)
                                            out = str_concat(out, "\n")
                                        ]
                                    ]
                                ]
                                if qdone == 0 [ j = j + 1 ]
                            ]
                        ]
                        if mdone == 0 [
                            if char_at(src, j) == 44 [ j = j + 1 ]
                        ]
                    ]
                ]
            ]
            // --- single: "path" ---
            if char_at(src, j) == 34 [
                j = j + 1
                box ps = j int64
                box qdone = 0 int64
                while qdone == 0 [
                    if j >= len [ qdone = 1 ]
                    if qdone == 0 [
                        if char_at(src, j) == 34 [
                            box path = substr(src, ps, j - ps) string
                            j = j + 1
                            qdone = 1
                            box inc = import_read(path) string
                            if strlen(inc) == 0 [
                                report_error(1, 0, str_concat("failed to resolve @import \"", str_concat(path, "\" (tried path, .bd, std/)")))
                            ]
                            if strlen(inc) > 0 [
                                box nested = resolve_imports_depth(inc, depth + 1) string
                                out = str_concat(out, nested)
                                out = str_concat(out, "\n")
                            ]
                        ]
                    ]
                    if qdone == 0 [ j = j + 1 ]
                ]
            ]
            // consume through end of line
            box k = i int64
            box linedone = 0 int64
            while linedone == 0 [
                if k >= len [
                    i = len
                    linedone = 1
                ]
                if linedone == 0 [
                    if char_at(src, k) == 10 [
                        i = k + 1
                        linedone = 1
                    ]
                ]
                if linedone == 0 [ k = k + 1 ]
            ]
        ]
        if imp == 0 [
            out = str_concat(out, substr(src, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]



@cpu rewrite_lib_calls(src string): string [
    box len = strlen(src) int64
    box out = "" string
    box i = 0 int64
    while i < len [
        box did = 0 int64
        if is_alpha(char_at(src, i)) == 1 [
            box a0 = i int64
            box a1 = i int64
            box cont = 1 int64
            while cont == 1 [
                if a1 >= len [ cont = 0 ]
                if cont == 1 [
                    if is_alnum(char_at(src, a1)) == 0 [ cont = 0 ]
                ]
                if cont == 1 [ a1 = a1 + 1 ]
            ]
            if a1 < len [
                if char_at(src, a1) == 46 [
                    if a1 + 1 < len [
                        if is_alpha(char_at(src, a1 + 1)) == 1 [
                            box b0 = a1 + 1 int64
                            box b1 = b0 int64
                            box cont2 = 1 int64
                            while cont2 == 1 [
                                if b1 >= len [ cont2 = 0 ]
                                if cont2 == 1 [
                                    if is_alnum(char_at(src, b1)) == 0 [ cont2 = 0 ]
                                ]
                                if cont2 == 1 [ b1 = b1 + 1 ]
                            ]
                            if b1 < len [
                                if char_at(src, b1) == 40 [
                                    box pref = substr(src, a0, a1 - a0) string
                                    box name = substr(src, b0, b1 - b0) string
                                    box pl = strlen(pref) int64
                                    if pl >= 1 [
                                        if pl <= 16 [
                                            out = str_concat(out, pref)
                                            out = str_concat(out, "_")
                                            out = str_concat(out, name)
                                            i = b1
                                            did = 1
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]
            ]
            if did == 0 [
                out = str_concat(out, substr(src, a0, a1 - a0))
                i = a1
                did = 1
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(src, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu apply_library(src string): string [
    // Strip @library "x" lines; names in libraries should use prefix_ form
    // Call sites: rewrite_lib_calls turns pref.name( into pref_name(
    box len = strlen(src) int64
    box out = "" string
    box i = 0 int64
    while i < len [
        if match_kw(src, i, "@library") == 1 [
            while i < len [
                if char_at(src, i) == 10 [
                    i = i + 1
                    box ii = i int64
                    i = len
                    i = ii
                ]
                if i < len [
                    if char_at(src, i) != 10 [ i = i + 1 ]
                ]
            ]
            out = str_concat(out, "
")
        ]
        if match_kw(src, i, "@library") == 0 [
            out = str_concat(out, substr(src, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu resolve_imports(src string): string [
    return(resolve_imports_depth(src, 0))
]

@cpu desugar_switch(src string): string [
    // switch EXPR [ case N [ BODY ] ... default [ BODY ] ]  →  if/else if chain
    box len = strlen(src) int64
    box out = "" string
    box i = 0 int64
    while i < len [
        box hit = 0 int64
        if match_kw(src, i, "switch") == 1 [
            box j = i + 6 int64
            j = skip_ws_c(src, j, len)
            box es = j int64
            while j < len [
                if char_at(src, j) == 91 [ j = len ]
                if j < len [
                    if char_at(src, j) != 91 [ j = j + 1 ]
                ]
            ]
            // j may be past end — find [
            j = es
            while j < len [
                if char_at(src, j) == 91 [
                    box expr = substr(src, es, j - es) string
                    // trim trailing spaces on expr
                    box el = strlen(expr) int64
                    while el > 0 [
                        if is_space(char_at(expr, el - 1)) == 1 [ el = el - 1 ]
                        if el > 0 [
                            if is_space(char_at(expr, el - 1)) == 0 [
                                expr = substr(expr, 0, el)
                                el = 0
                            ]
                        ]
                    ]
                    box bs = j + 1 int64
                    box depth = 1 int64
                    box k = bs int64
                    while depth > 0 [
                        if k >= len [ depth = 0 ]
                        if k < len [
                            if char_at(src, k) == 91 [ depth = depth + 1 ]
                            if char_at(src, k) == 93 [ depth = depth - 1 ]
                            k = k + 1
                        ]
                    ]
                    box body = substr(src, bs, k - bs - 1) string
                    box chain = "" string
                    box ncase = 0 int64
                    box bi = 0 int64
                    box blen = strlen(body) int64
                    box defb = "" string
                    while bi < blen [
                        bi = skip_ws_c(body, bi, blen)
                        if bi >= blen [ bi = blen ]
                        if bi < blen [
                            box took = 0 int64
                            if match_kw(body, bi, "case") == 1 [
                                took = 1
                                bi = bi + 4
                                bi = skip_ws_c(body, bi, blen)
                                box vs = bi int64
                                if char_at(body, bi) == 45 [
                                    bi = bi + 1
                                ]
                                while is_digit(char_at(body, bi)) == 1 [ bi = bi + 1 ]
                                box val = substr(body, vs, bi - vs) string
                                bi = skip_ws_c(body, bi, blen)
                                if char_at(body, bi) == 91 [ bi = bi + 1 ]
                                box cs = bi int64
                                box cd = 1 int64
                                while cd > 0 [
                                    if bi >= blen [ cd = 0 ]
                                    if bi < blen [
                                        if char_at(body, bi) == 91 [ cd = cd + 1 ]
                                        if char_at(body, bi) == 93 [ cd = cd - 1 ]
                                        bi = bi + 1
                                    ]
                                ]
                                box cbody = substr(body, cs, bi - cs - 1) string
                                if ncase == 0 [
                                    chain = str_concat("if ", expr)
                                    chain = str_concat(chain, " == ")
                                    chain = str_concat(chain, val)
                                    chain = str_concat(chain, " [\n")
                                    chain = str_concat(chain, cbody)
                                    chain = str_concat(chain, "\n]")
                                ]
                                if ncase > 0 [
                                    chain = str_concat(chain, " else if ")
                                    chain = str_concat(chain, expr)
                                    chain = str_concat(chain, " == ")
                                    chain = str_concat(chain, val)
                                    chain = str_concat(chain, " [\n")
                                    chain = str_concat(chain, cbody)
                                    chain = str_concat(chain, "\n]")
                                ]
                                ncase = ncase + 1
                            ]
                            if took == 0 [
                                if match_kw(body, bi, "default") == 1 [
                                    took = 1
                                    bi = bi + 7
                                    bi = skip_ws_c(body, bi, blen)
                                    if char_at(body, bi) == 91 [ bi = bi + 1 ]
                                    box cs = bi int64
                                    box cd = 1 int64
                                    while cd > 0 [
                                        if bi >= blen [ cd = 0 ]
                                        if bi < blen [
                                            if char_at(body, bi) == 91 [ cd = cd + 1 ]
                                            if char_at(body, bi) == 93 [ cd = cd - 1 ]
                                            bi = bi + 1
                                        ]
                                    ]
                                    defb = substr(body, cs, bi - cs - 1)
                                ]
                            ]
                            if took == 0 [ bi = bi + 1 ]
                        ]
                    ]
                    if strlen(defb) > 0 [
                        chain = str_concat(chain, " else [\n")
                        chain = str_concat(chain, defb)
                        chain = str_concat(chain, "\n]")
                    ]
                    if ncase == 0 [
                        out = str_concat(out, "/* empty switch */")
                    ]
                    if ncase > 0 [
                        out = str_concat(out, chain)
                    ]
                    i = k
                    hit = 1
                ]
                if hit == 0 [
                    if j < len [ j = j + 1 ]
                    if j >= len [ hit = 2 ]
                ]
            ]
            if hit == 2 [ hit = 0 ]
        ]
        if hit == 0 [
            out = str_concat(out, substr(src, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu desugar_ptrs(src string): string [
    // C/Zig single-level pointers only (*name / &name). No **. No type* suffix.
    // box *x = 7 int64  →  box x = allocator(8) ptr + store_i64(x, 0, 7)
    // *x = v            →  store_i64(x, 0, v)
    // *x                →  load_i64(x, 0)
    // &x                →  x
    // std.allocator(    →  allocator(
    box len = strlen(src) int64
    box out = "" string
    box i = 0 int64
    while i < len [
        box hit = 0 int64
        // **  → hard error marker (single level only)
        if hit == 0 [
            if char_at(src, i) == 42 [
                if i + 1 < len [
                    if char_at(src, i + 1) == 42 [
                        out = str_concat(out, " COMPILE_ERROR_MULTI_PTR ")
                        i = i + 2
                        hit = 1
                    ]
                ]
            ]
        ]
        // std.allocator → allocator
        if hit == 0 [
            if match_kw(src, i, "std.allocator") == 1 [
                out = str_concat(out, "allocator")
                i = i + 13
                hit = 1
            ]
        ]
        // box *name = INIT [TYPE]
        if hit == 0 [
            if match_kw(src, i, "box") == 1 [
                box j = i + 3 int64
                while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                if char_at(src, j) == 42 [
                    j = j + 1
                    while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                    if is_alpha(char_at(src, j)) == 1 [
                        box ns = j int64
                        while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                        box name = substr(src, ns, j - ns) string
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        if char_at(src, j) == 61 [
                            j = j + 1
                            while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                            box es = j int64
                            // take rest of line as init+optional type
                            box ee = j int64
                            while ee < len [
                                if char_at(src, ee) == 10 [ ee = len ]
                                if ee < len [
                                    if char_at(src, ee) != 10 [ ee = ee + 1 ]
                                ]
                            ]
                            // find newline position
                            box nl = es int64
                            while nl < len [
                                if char_at(src, nl) == 10 [
                                    // process
                                    box line = substr(src, es, nl - es) string
                                    // strip trailing type token
                                    box ll = strlen(line) int64
                                    box ti = ll int64
                                    while ti > 0 [
                                        if is_space(char_at(line, ti - 1)) == 1 [ ti = ti - 1 ]
                                        if is_space(char_at(line, ti - 1)) == 0 [
                                            // back over token
                                            while ti > 0 [
                                                if is_alnum(char_at(line, ti - 1)) == 1 [ ti = ti - 1 ]
                                                if is_alnum(char_at(line, ti - 1)) == 0 [
                                                    if ti > 0 [
                                                        if is_space(char_at(line, ti - 1)) == 1 [
                                                            box ty = substr(line, ti, ll - ti) string
                                                            box init = substr(line, 0, ti) string
                                                            // trim init spaces
                                                            box iz = strlen(init) int64
                                                            while iz > 0 [
                                                                if is_space(char_at(init, iz - 1)) == 1 [ iz = iz - 1 ]
                                                                if is_space(char_at(init, iz - 1)) == 0 [
                                                                    init = substr(init, 0, iz)
                                                                    iz = 0
                                                                ]
                                                            ]
                                                            out = str_concat(out, "box ")
                                                            out = str_concat(out, name)
                                                            out = str_concat(out, " = allocator(8) ptr\nstore_i64(")
                                                            out = str_concat(out, name)
                                                            out = str_concat(out, ", 0, ")
                                                            out = str_concat(out, init)
                                                            out = str_concat(out, ")")
                                                            i = nl
                                                            hit = 1
                                                        ]
                                                    ]
                                                    ti = 0
                                                ]
                                            ]
                                        ]
                                    ]
                                    if hit == 0 [
                                        // whole line is init
                                        out = str_concat(out, "box ")
                                        out = str_concat(out, name)
                                        out = str_concat(out, " = allocator(8) ptr\nstore_i64(")
                                        out = str_concat(out, name)
                                        out = str_concat(out, ", 0, ")
                                        out = str_concat(out, line)
                                        out = str_concat(out, ")")
                                        i = nl
                                        hit = 1
                                    ]
                                    nl = len
                                ]
                                if nl < len [ nl = nl + 1 ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        // *name = expr   OR   *name
        if hit == 0 [
            if char_at(src, i) == 42 [
                box left_ok = 1 int64
                if i > 0 [
                    box lc = char_at(src, i - 1) int64
                    if is_alnum(lc) == 1 [ left_ok = 0 ]
                    if lc == 41 [ left_ok = 0 ]
                    if lc == 34 [ left_ok = 0 ]
                ]
                box j = i + 1 int64
                while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                if left_ok == 1 [
                    if is_alpha(char_at(src, j)) == 1 [
                        box ns = j int64
                        while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                        box name = substr(src, ns, j - ns) string
                        box j2 = j int64
                        while is_space(char_at(src, j2)) == 1 [ j2 = j2 + 1 ]
                        box is_asgn = 0 int64
                        if char_at(src, j2) == 61 [
                            if j2 + 1 >= len [ is_asgn = 1 ]
                            if j2 + 1 < len [
                                if char_at(src, j2 + 1) != 61 [ is_asgn = 1 ]
                            ]
                        ]
                        if is_asgn == 1 [
                            // store_i64(name, 0, EXPR)
                            box e0 = j2 + 1 int64
                            while is_space(char_at(src, e0)) == 1 [ e0 = e0 + 1 ]
                            box e1 = e0 int64
                            while e1 < len [
                                if char_at(src, e1) == 10 [ e1 = len ]
                                if e1 < len [
                                    if char_at(src, e1) != 10 [ e1 = e1 + 1 ]
                                ]
                            ]
                            // find actual end
                            e1 = e0
                            while e1 < len [
                                if char_at(src, e1) == 10 [
                                    out = str_concat(out, "store_i64(")
                                    out = str_concat(out, name)
                                    out = str_concat(out, ", 0, ")
                                    out = str_concat(out, substr(src, e0, e1 - e0))
                                    out = str_concat(out, ")")
                                    i = e1
                                    hit = 1
                                    e1 = len
                                ]
                                if e1 < len [ e1 = e1 + 1 ]
                            ]
                        ]
                        if hit == 0 [
                            out = str_concat(out, "load_i64(")
                            out = str_concat(out, name)
                            out = str_concat(out, ", 0)")
                            i = j
                            hit = 1
                        ]
                    ]
                ]
            ]
        ]
        // &name → name
        if hit == 0 [
            if char_at(src, i) == 38 [
                box j = i + 1 int64
                while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                if is_alpha(char_at(src, j)) == 1 [
                    box ns = j int64
                    while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                    out = str_concat(out, substr(src, ns, j - ns))
                    i = j
                    hit = 1
                ]
            ]
        ]
        if hit == 0 [
            out = str_concat(out, substr(src, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu desugar_pools(src string): string [
    // std.pool("n", bytes)[-ram|-ssd|-vram|-cpu|-tpu|-npu|-lpu]
    // std.allocator(bytes)  free(...)  -into(target)
    // @import "std" native
    box len = strlen(src) int64
    box out = "" string
    box i = 0 int64
    while i < len [
        box hit = 0 int64
        if match_kw(src, i, "@import") == 1 [
            box j = i + 7 int64
            while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
            if char_at(src, j) == 34 [
                j = j + 1
                box ps = j int64
                while j < len [
                    if char_at(src, j) == 34 [
                        box path = substr(src, ps, j - ps) string
                        if strcmp(path, "std") == 0 [
                            hit = 1
                            i = j + 1
                            out = str_concat(out, "// @import std (native)\n")
                        ]
                        j = len
                    ]
                    if j < len [
                        if char_at(src, j) != 34 [ j = j + 1 ]
                    ]
                ]
            ]
        ]
        if hit == 0 [
            if match_kw(src, i, "std") == 1 [
                box j = i + 3 int64
                if char_at(src, j) == 46 [
                    j = j + 1
                    if match_kw(src, j, "pool") == 1 [
                        hit = 1
                        j = j + 4
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        if char_at(src, j) == 40 [ j = j + 1 ]
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        box pname = "" string
                        if char_at(src, j) == 34 [
                            j = j + 1
                            box ns = j int64
                            while char_at(src, j) != 34 [
                                if j >= len [ j = len ]
                                if j < len [
                                    if char_at(src, j) != 34 [ j = j + 1 ]
                                ]
                            ]
                            pname = substr(src, ns, j - ns)
                            if char_at(src, j) == 34 [ j = j + 1 ]
                        ]
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        if char_at(src, j) == 44 [ j = j + 1 ]
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        box szs = j int64
                        while is_digit(char_at(src, j)) == 1 [ j = j + 1 ]
                        box sz = substr(src, szs, j - szs) string
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        if char_at(src, j) == 41 [ j = j + 1 ]
                        box tier = "0" string
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        if char_at(src, j) == 45 [
                            j = j + 1
                            if match_kw(src, j, "ram") == 1 [
                                tier = "0"
                                j = j + 3
                            ]
                            if match_kw(src, j, "ssd") == 1 [
                                tier = "1"
                                j = j + 3
                            ]
                            if match_kw(src, j, "tpu") == 1 [
                                tier = "4"
                                j = j + 3
                            ]
                            if match_kw(src, j, "npu") == 1 [
                                tier = "5"
                                j = j + 3
                            ]
                            if match_kw(src, j, "lpu") == 1 [
                                tier = "6"
                                j = j + 3
                            ]
                            if match_kw(src, j, "vram") == 1 [
                                tier = "2"
                                j = j + 4
                            ]
                            if match_kw(src, j, "cpu") == 1 [
                                tier = "3"
                                j = j + 3
                            ]
                        ]
                        out = str_concat(out, "pool_create(\"")
                        out = str_concat(out, pname)
                        out = str_concat(out, "\", ")
                        out = str_concat(out, sz)
                        out = str_concat(out, ", ")
                        out = str_concat(out, tier)
                        out = str_concat(out, ")")
                        i = j
                    ]
                ]
            ]
        ]
        if hit == 0 [
            if match_kw(src, i, "std") == 1 [
                box j = i + 3 int64
                if char_at(src, j) == 46 [
                    j = j + 1
                    if match_kw(src, j, "allocator") == 1 [
                        hit = 1
                        j = j + 9
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        if char_at(src, j) == 40 [ j = j + 1 ]
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        box szs = j int64
                        while is_digit(char_at(src, j)) == 1 [ j = j + 1 ]
                        box sz = substr(src, szs, j - szs) string
                        while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                        if char_at(src, j) == 41 [ j = j + 1 ]
                        out = str_concat(out, "allocator(")
                        out = str_concat(out, sz)
                        out = str_concat(out, ")")
                        i = j
                    ]
                ]
            ]
        ]
        if hit == 0 [
            if match_kw(src, i, "std") == 1 [
                box j = i + 3 int64
                if char_at(src, j) == 46 [
                    j = j + 1
                    if match_kw(src, j, "free") == 1 [
                        hit = 1
                        j = j + 4
                        out = str_concat(out, "free")
                        i = j
                    ]
                ]
            ]
        ]
        if hit == 0 [
            if match_kw(src, i, "std") == 1 [
                box j = i + 3 int64
                if char_at(src, j) == 46 [
                    j = j + 1
                    if match_kw(src, j, "write_file_bin") == 1 [
                        hit = 1
                        j = j + 13
                        out = str_concat(out, "write_file_bin")
                        i = j
                    ]
                ]
            ]
        ]
        if hit == 0 [
            if match_kw(src, i, "std") == 1 [
                box j = i + 3 int64
                if char_at(src, j) == 46 [
                    j = j + 1
                    if match_kw(src, j, "write_file") == 1 [
                        hit = 1
                        j = j + 10
                        out = str_concat(out, "write_file")
                        i = j
                    ]
                ]
            ]
        ]
        if hit == 0 [
            if match_kw(src, i, "std") == 1 [
                box j = i + 3 int64
                if char_at(src, j) == 46 [
                    j = j + 1
                    if match_kw(src, j, "append_file") == 1 [
                        hit = 1
                        j = j + 11
                        out = str_concat(out, "append_file_text")
                        i = j
                    ]
                ]
            ]
        ]
        if hit == 0 [
            if match_kw(src, i, "std") == 1 [
                box j = i + 3 int64
                if char_at(src, j) == 46 [
                    j = j + 1
                    if match_kw(src, j, "read_file") == 1 [
                        hit = 1
                        j = j + 9
                        out = str_concat(out, "read_file")
                        i = j
                    ]
                ]
            ]
        ]
        if hit == 0 [
            if char_at(src, i) == 45 [
                if match_kw(src, i + 1, "into") == 1 [
                    hit = 1
                    box j = i + 5 int64
                    while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                    if char_at(src, j) == 40 [ j = j + 1 ]
                    while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                    box ts = j int64
                    while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                    box tgt = substr(src, ts, j - ts) string
                    while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                    if char_at(src, j) == 41 [ j = j + 1 ]
                    out = str_concat(out, " /*into:")
                    out = str_concat(out, tgt)
                    out = str_concat(out, "*/ ")
                    i = j
                ]
            ]
        ]
        if hit == 0 [
            out = str_concat(out, substr(src, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu strip_type_colons(src string): string [
    box out = "" string
    box i = 0 int64
    box n = strlen(src) int64
    while i < n [
        box done = 0 int64
        if char_at(src, i) == 58 [
            box j = i + 1 int64
            while j < n [
                if is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                if is_space(char_at(src, j)) == 0 [
                    box j2 = j int64
                    j = n
                ]
            ]
            j = i + 1
            while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
            if match_kw(src, j, "i64") == 1 [
                out = str_concat(out, " ")
                i = j + 3
                done = 1
            ]
            if match_kw(src, j, "i32") == 1 [
                out = str_concat(out, " ")
                i = j + 3
                done = 1
            ]
            if match_kw(src, j, "usize") == 1 [
                out = str_concat(out, " ")
                i = j + 5
                done = 1
            ]
        ]
        if done == 0 [
            out = str_concat(out, substr(src, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu desugar_print_bang(src string): string [
    // Solo 2 APIs de alto nivel: print!(...) y println!(...)
    // Como Python print / Go fmt.Print vs Println
    // Despacho bajo nivel:
    //   "" / vacio          → (nada | print_nl)
    //   "string"            → print_str
    //   expresion           → print_int
    //   a, b, c             → print cada uno con espacio entre medias
    // println! anade print_nl() al final
    box len = strlen(src) int64
    box out = "" string
    box i = 0 int64
    while i < len [
        box did = 0 int64
        box nl_after = 0 int64
        box name_len = 0 int64
        if match_kw(src, i, "println!") == 1 [
            did = 1
            nl_after = 1
            name_len = 8
        ]
        if did == 0 [
            if match_kw(src, i, "print!") == 1 [
                did = 1
                nl_after = 0
                name_len = 6
            ]
        ]
        if did == 1 [
            i = i + name_len
            i = skip_ws_c(src, i, len)
            if char_at(src, i) != 40 [
                // not a call — leave name as text (should not happen)
                out = str_concat(out, "print!")
                did = 0
            ]
        ]
        if did == 1 [
            i = i + 1
            i = skip_ws_c(src, i, len)
            // empty ()
            if char_at(src, i) == 41 [
                i = i + 1
                if nl_after == 1 [ out = str_concat(out, "print_nl()") ]
                if nl_after == 0 [ out = str_concat(out, "/* print!() */") ]
            ]
            if char_at(src, i) != 41 [
                if char_at(src, i - 1) != 41 [
                    // parse args separated by commas at depth 0
                    box first = 1 int64
                    box done_args = 0 int64
                    while done_args == 0 [
                        i = skip_ws_c(src, i, len)
                        if i >= len [ done_args = 1 ]
                        if done_args == 0 [
                            if char_at(src, i) == 41 [
                                i = i + 1
                                done_args = 1
                            ]
                        ]
                        if done_args == 0 [
                            // separator between args
                            if first == 0 [
                                out = str_concat(out, "\nprint_str(\" \")\n")
                            ]
                            first = 0
                            // string literal?
                            if char_at(src, i) == 34 [
                                box qs = i int64
                                i = i + 1
                                box qrun = 1 int64
                                while qrun == 1 [
                                    if i >= len [ qrun = 0 ]
                                    if i < len [
                                        if char_at(src, i) == 34 [
                                            i = i + 1
                                            qrun = 0
                                        ]
                                        if qrun == 1 [ i = i + 1 ]
                                    ]
                                ]
                                out = str_concat(out, "print_str(")
                                out = str_concat(out, substr(src, qs, i - qs))
                                out = str_concat(out, ")")
                            ]
                            // expression until comma or close-paren at depth 0
                            if char_at(src, i) != 34 [
                                if done_args == 0 [
                                    if char_at(src, i) != 41 [
                                        box es = i int64
                                        box depth = 0 int64
                                        box erun = 1 int64
                                        while erun == 1 [
                                            if i >= len [ erun = 0 ]
                                            if i < len [
                                                box ch = char_at(src, i) int64
                                                if ch == 40 [ depth = depth + 1 ]
                                                if ch == 91 [ depth = depth + 1 ]
                                                if ch == 41 [
                                                    if depth == 0 [ erun = 0 ]
                                                    if depth > 0 [
                                                        depth = depth - 1
                                                        i = i + 1
                                                    ]
                                                ]
                                                if ch == 93 [
                                                    if depth > 0 [ depth = depth - 1 ]
                                                ]
                                                if ch == 44 [
                                                    if depth == 0 [ erun = 0 ]
                                                ]
                                                if erun == 1 [
                                                    if ch != 41 [ i = i + 1 ]
                                                    if ch == 41 [
                                                        if depth > 0 [ i = i + 1 ]
                                                    ]
                                                ]
                                            ]
                                        ]
                                        // trim trailing spaces in expr
                                        box ee = i int64
                                        while ee > es [
                                            if is_space(char_at(src, ee - 1)) == 1 [ ee = ee - 1 ]
                                            if is_space(char_at(src, ee - 1)) == 0 [
                                                ee = ee
                                                // break
                                                box _t = es int64
                                                es = es
                                                ee = ee
                                                // exit trim
                                                box stop = 1 int64
                                                if stop == 1 [
                                                    // use goto-like by setting
                                                    box __ = 0 int64
                                                ]
                                            ]
                                        ]
                                        // actually simple: substr es..i
                                        box expr = substr(src, es, i - es) string
                                        // if expr looks like string already handled
                                        out = str_concat(out, "print_int(")
                                        out = str_concat(out, expr)
                                        out = str_concat(out, ")")
                                    ]
                                ]
                            ]
                            i = skip_ws_c(src, i, len)
                            if char_at(src, i) == 44 [
                                i = i + 1
                            ]
                        ]
                    ]
                    if nl_after == 1 [
                        out = str_concat(out, "\nprint_nl()")
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(src, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]




@cpu builtin_macros(): string [
    // Language-builtin macros — name|params|body#
    box m = "" string
    m = str_concat(m, "assert|cond|if !(cond) [\npanic(\"assert failed\")\n]\n#")
    m = str_concat(m, "max|a, b|((a) > (b) ? (a) : (b))#")
    m = str_concat(m, "min|a, b|((a) < (b) ? (a) : (b))#")
    m = str_concat(m, "abs|x|((x) < 0 ? (0 - (x)) : (x))#")
    m = str_concat(m, "clamp|x, lo, hi|((x) < (lo) ? (lo) : ((x) > (hi) ? (hi) : (x)))#")
    m = str_concat(m, "swap|a, b|box _t = (a)\n(a) = (b)\n(b) = _t\n#")
    m = str_concat(m, "DOUBLE|x|((x) + (x))#")
    m = str_concat(m, "SQUARE|x|((x) * (x))#")
    m = str_concat(m, "CUBE|x|((x) * (x) * (x))#")
    m = str_concat(m, "POW2|x|((x) * (x))#")
    m = str_concat(m, "INC|x|(x) = (x) + 1\n#")
    m = str_concat(m, "DEC|x|(x) = (x) - 1\n#")
    m = str_concat(m, "ADD_EQ|x, v|(x) = (x) + (v)\n#")
    m = str_concat(m, "MUL_EQ|x, v|(x) = (x) * (v)\n#")
    m = str_concat(m, "when|cond, body|if (cond) [\nbody\n]\n#")
    m = str_concat(m, "unless|cond, body|if !(cond) [\nbody\n]\n#")
    m = str_concat(m, "times|n, body|box _i = 0 int64\nwhile _i < (n) [\nbody\n_i = _i + 1\n]\n#")
    m = str_concat(m, "for_range|i, lo, hi, body|box i = (lo) int64\nwhile i < (hi) [\nbody\ni = i + 1\n]\n#")
    m = str_concat(m, "for_down|i, hi, lo, body|box i = (hi) int64\nwhile i > (lo) [\nbody\ni = i - 1\n]\n#")
    m = str_concat(m, "repeat|n, body|box _r = 0 int64\nwhile _r < (n) [\nbody\n_r = _r + 1\n]\n#")
    m = str_concat(m, "SUM_RANGE|acc, i, lo, hi, term|box acc = 0 int64\nbox i = (lo) int64\nwhile i <= (hi) [\nacc = acc + (term)\ni = i + 1\n]\n#")
    m = str_concat(m, "SELECT|cond, t, f|((cond) ? (t) : (f))#")
    m = str_concat(m, "NOT|x|!(x)#")
    m = str_concat(m, "AND|a, b|((a) * (b))#")
    m = str_concat(m, "OR|a, b|(((a) + (b)) > 0 ? 1 : 0)#")
    m = str_concat(m, "LET|name, val, body|box name = (val) int64\nbody\n#")
    m = str_concat(m, "RET|v|return(v)#")
    m = str_concat(m, "comptime|x|(x)#")
    m = str_concat(m, "comptime_assert|cond|if !(cond) [\npanic(\"comptime assert\")\n]\n#")
    m = str_concat(m, "sizeof|ty|8#")
    m = str_concat(m, "alignof|ty|8#")
    m = str_concat(m, "bool|x|((x) != 0 ? 1 : 0)#")
    m = str_concat(m, "IDENTITY|x|(x)#")
    m = str_concat(m, "LERP|a, b, t|((a) + ((b) - (a)) * (t))#")
    m = str_concat(m, "bitCast|ty, x|(x)#")
    m = str_concat(m, "intCast|x|(x)#")
    m = str_concat(m, "unwrap|x|(x)#")
    m = str_concat(m, "as|ty, x|(x)#")
    m = str_concat(m, "field|parent, name|parent#")
    m = str_concat(m, "defer|body|body\n#")
    m = str_concat(m, "errdefer|body|body\n#")
    m = str_concat(m, "compile_error|msg|@comptime_error(msg)#")
    m = str_concat(m, "compiler_error|msg|@comptime_error(msg)#")
    return(m)
]



@cpu comptime_fail(msg string): string [
    box e = "COMPTIME_ERROR:" string
    return(str_concat(e, msg))
]

@cpu lang_header_detect(src string): string [
    // returns "zig" | "rust" | "forge" | "mini" | ""
    box n = strlen(src) int64
    if n < 8 [ return("") ]
    // //!lang:zig  or  //!lang zig
    if char_at(src, 0) == 47 [
        if char_at(src, 1) == 47 [
            if char_at(src, 2) == 33 [
                box i = 3 int64
                while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                if match_kw(src, i, "lang") == 1 [
                    i = i + 4
                    if char_at(src, i) == 58 [ i = i + 1 ]
                    while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                    box s = i int64
                    while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                    return(substr(src, s, i - s))
                ]
            ]
        ]
    ]
    // #lang zig
    if char_at(src, 0) == 35 [
        if match_kw(src, 1, "lang") == 1 [
            box i = 5 int64
            while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
            box s = i int64
            while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
            return(substr(src, s, i - s))
        ]
    ]
    return("")
]

@cpu strip_lang_header(src string): string [
    box n = strlen(src) int64
    box i = 0 int64
    while i < n [
        if char_at(src, i) == 10 [
            return(substr(src, i + 1, n - (i + 1)))
        ]
        i = i + 1
    ]
    return(src)
]

@cpu apply_lang_rules_lines(rules string, lang string, body string): string [
    // Expand whole buffer as that dialect (bridge: output is Basalt)
    return(expand_lang_block(rules, "", lang, body))
]

@cpu rust_ownership_check(src string): string [
    // Lightweight compile-time ownership: after `let x = y` (move of non-mut copy),
    // flag later use of y if y was not mut and not literal.
    // Emits COMPTIME_ERROR on clear double-use of moved name.
    // Integers are Copy — only flag if comment marker // !move y appears.
    if bal_has(src, "COMPTIME_ERROR:") == 1 [ return(src) ]
    if bal_has(src, "// @move ") == 0 [
        if bal_has(src, "// !move ") == 0 [ return(src) ]
    ]
    // If user annotated // !move name then later name use → error
    box n = strlen(src) int64
    box i = 0 int64
    while i + 8 < n [
        if char_at(src, i) == 47 [
            if char_at(src, i + 1) == 47 [
                if match_kw(src, i + 3, "!move") == 1 [
                    box j = i + 8 int64
                    while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                    box s = j int64
                    while is_alnum(char_at(src, j)) == 1 [ j = j + 1 ]
                    box nm = substr(src, s, j - s) string
                    if strlen(nm) > 0 [
                        box rest = substr(src, j, n - j) string
                        // second occurrence of nm as word after marker
                        box k = 0 int64
                        box rn = strlen(rest) int64
                        box hits = 0 int64
                        while k + strlen(nm) <= rn [
                            box ok = 1 int64
                            box t = 0 int64
                            while t < strlen(nm) [
                                if char_at(rest, k + t) != char_at(nm, t) [ ok = 0 ]
                                t = t + 1
                            ]
                            if ok == 1 [
                                hits = hits + 1
                                if hits >= 2 [
                                    return(comptime_fail(str_concat("use of moved value: ", nm)))
                                ]
                            ]
                            k = k + 1
                        ]
                    ]
                ]
            ]
        ]
        i = i + 1
    ]
    return(src)
]

@cpu preprocess_comptime_vm(src string): string [
    // Mini VM: expand @comptime_error / @compile_error / @comptime_assert(0)
    box n = strlen(src) int64
    box i = 0 int64
    box out = "" string
    while i < n [
        box handled = 0 int64
        if char_at(src, i) == 64 [
            if match_kw(src, i + 1, "comptime_error") == 1 [
                box j = i + 15 int64
                while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                if char_at(src, j) == 40 [
                    j = j + 1
                    while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                    box msg = "" string
                    if char_at(src, j) == 34 [
                        j = j + 1
                        box s0 = j int64
                        while j < n [
                            if char_at(src, j) == 34 [ 
                                msg = substr(src, s0, j - s0)
                                j = j + 1
                            ]
                            if char_at(src, j) == 34 [ j = n ]
                            if j < n [
                                if char_at(src, j) != 34 [ j = j + 1 ]
                            ]
                        ]
                    ]
                    return(comptime_fail(msg))
                ]
            ]
            if match_kw(src, i + 1, "compile_error") == 1 [
                box j = i + 14 int64
                while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                if char_at(src, j) == 40 [
                    j = j + 1
                    while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                    box msg = "" string
                    if char_at(src, j) == 34 [
                        j = j + 1
                        box s0 = j int64
                        while j < n [
                            if char_at(src, j) == 34 [
                                msg = substr(src, s0, j - s0)
                                j = n
                            ]
                            if j < n [
                                if char_at(src, j) != 34 [ j = j + 1 ]
                            ]
                        ]
                    ]
                    return(comptime_fail(msg))
                ]
            ]
            if match_kw(src, i + 1, "comptime_assert") == 1 [
                box j = i + 16 int64
                while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                if char_at(src, j) == 40 [
                    j = j + 1
                    while is_space(char_at(src, j)) == 1 [ j = j + 1 ]
                    // only handle literal 0 / false
                    if char_at(src, j) == 48 [
                        return(comptime_fail("comptime_assert failed"))
                    ]
                    if match_kw(src, j, "false") == 1 [
                        return(comptime_fail("comptime_assert failed"))
                    ]
                ]
            ]
        ]
        out = str_concat(out, substr(src, i, 1))
        i = i + 1
    ]
    return(out)
]

@cpu preprocess(src string): string [
    box len = strlen(src) int64
    box out = "" string
    box i = 0 int64
    box macros = builtin_macros() string
    box langs = "|" string
    box rules = "" string
    box preludes = "" string
    while i < len [
        box handled = 0 int64
        if i + 6 < len [
            if char_at(src, i) == 64 [
                if char_at(src, i + 1) == 109 [
                    if char_at(src, i + 2) == 97 [
                        if char_at(src, i + 3) == 99 [
                            if char_at(src, i + 4) == 114 [
                                if char_at(src, i + 5) == 111 [
                                    handled = 1
                                    i = i + 6
                                    while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                                    box ns = i int64
                                    while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                    box mname = substr(src, ns, i - ns) string
                                    while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                                    box params = "" string
                                    if char_at(src, i) == 40 [
                                        i = i + 1
                                        box ps = i int64
                                        while char_at(src, i) != 41 [
                                            if i >= len [ i = len ]
                                            if i < len [
                                                if char_at(src, i) != 41 [ i = i + 1 ]
                                            ]
                                        ]
                                        params = substr(src, ps, i - ps)
                                        if char_at(src, i) == 41 [ i = i + 1 ]
                                    ]
                                    while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                                    box body = "" string
                                    if char_at(src, i) == 91 [
                                        i = i + 1
                                        box depth = 1 int64
                                        box bs = i int64
                                        while depth > 0 [
                                            if i >= len [ depth = 0 ]
                                            if i < len [
                                                if char_at(src, i) == 91 [ depth = depth + 1 ]
                                                if char_at(src, i) == 93 [ depth = depth - 1 ]
                                                if depth > 0 [ i = i + 1 ]
                                            ]
                                        ]
                                        body = substr(src, bs, i - bs)
                                        if char_at(src, i) == 93 [ i = i + 1 ]
                                    ]
                                    macros = str_concat(macros, mname)
                                    macros = str_concat(macros, "|")
                                    macros = str_concat(macros, params)
                                    macros = str_concat(macros, "|")
                                    macros = str_concat(macros, body)
                                    macros = str_concat(macros, "#")
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        if handled == 0 [
            if char_at(src, i) == 64 [
                if match_kw(src, i + 1, "lang") == 1 [
                    handled = 1
                    i = i + 5
                    i = skip_ws_c(src, i, len)
                    box lns = i int64
                    while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                    box lname = substr(src, lns, i - lns) string
                    if strlen(lname) > 0 [
                        langs = str_concat(langs, lname)
                        langs = str_concat(langs, "|")
                    ]
                    box _ls = 1 int64
                    while _ls == 1 [
                        if i >= len [ _ls = 0 ]
                        if i < len [
                            if char_at(src, i) == 10 [
                                i = i + 1
                                _ls = 0
                            ]
                            if _ls == 1 [ i = i + 1 ]
                        ]
                    ]
                ]
            ]
        ]
        if handled == 0 [
            if char_at(src, i) == 64 [
                if match_kw(src, i + 1, "prelude") == 1 [
                    handled = 1
                    i = i + 8
                    i = skip_ws_c(src, i, len)
                    box pls = i int64
                    while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                    box plang = substr(src, pls, i - pls) string
                    box pq = parse_quoted(src, i, len) string
                    box colon = 0 int64
                    while colon < strlen(pq) [
                        if char_at(pq, colon) == 58 [
                            box code = substr(pq, 0, colon) string
                            box i2 = 0 int64
                            box j = colon + 1 int64
                            while j < strlen(pq) [
                                i2 = i2 * 10 + (char_at(pq, j) - 48)
                                j = j + 1
                            ]
                            i = i2
                            preludes = prelude_add(preludes, plang, code)
                            colon = strlen(pq)
                        ]
                        if colon < strlen(pq) [ colon = colon + 1 ]
                    ]
                    box _lp = 1 int64
                    while _lp == 1 [
                        if i >= len [ _lp = 0 ]
                        if i < len [
                            if char_at(src, i) == 10 [
                                i = i + 1
                                _lp = 0
                            ]
                            if _lp == 1 [ i = i + 1 ]
                        ]
                    ]
                ]
            ]
        ]
        if handled == 0 [
            if char_at(src, i) == 64 [
                if match_kw(src, i + 1, "rule") == 1 [
                    handled = 1
                    i = i + 5
                    i = skip_ws_c(src, i, len)
                    box rls = i int64
                    while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                    box rlang = substr(src, rls, i - rls) string
                    box pq = parse_quoted(src, i, len) string
                    box colon = 0 int64
                    while colon < strlen(pq) [
                        if char_at(pq, colon) == 58 [
                            box pat = substr(pq, 0, colon) string
                            box i2 = 0 int64
                            box j = colon + 1 int64
                            while j < strlen(pq) [
                                i2 = i2 * 10 + (char_at(pq, j) - 48)
                                j = j + 1
                            ]
                            i = i2
                            i = skip_ws_c(src, i, len)
                            if char_at(src, i) == 61 [
                                if i + 1 < len [
                                    if char_at(src, i + 1) == 62 [
                                        i = i + 2
                                        box pq2 = parse_quoted(src, i, len) string
                                        box c2 = 0 int64
                                        while c2 < strlen(pq2) [
                                            if char_at(pq2, c2) == 58 [
                                                box tpl = substr(pq2, 0, c2) string
                                                box i3 = 0 int64
                                                box j2 = c2 + 1 int64
                                                while j2 < strlen(pq2) [
                                                    i3 = i3 * 10 + (char_at(pq2, j2) - 48)
                                                    j2 = j2 + 1
                                                ]
                                                i = i3
                                                rules = rules_add(rules, rlang, pat, tpl)
                                                c2 = strlen(pq2)
                                            ]
                                            if c2 < strlen(pq2) [ c2 = c2 + 1 ]
                                        ]
                                    ]
                                ]
                            ]
                            colon = strlen(pq)
                        ]
                        if colon < strlen(pq) [ colon = colon + 1 ]
                    ]
                    box _ls2 = 1 int64
                    while _ls2 == 1 [
                        if i >= len [ _ls2 = 0 ]
                        if i < len [
                            if char_at(src, i) == 10 [
                                i = i + 1
                                _ls2 = 0
                            ]
                            if _ls2 == 1 [ i = i + 1 ]
                        ]
                    ]
                ]
            ]
        ]
        if handled == 0 [
            if char_at(src, i) == 64 [
                if is_alpha(char_at(src, i + 1)) == 1 [
                    box ns = i + 1 int64
                    box ni = ns int64
                    while is_alnum(char_at(src, ni)) == 1 [ ni = ni + 1 ]
                    box lname2 = substr(src, ns, ni - ns) string
                    box j2 = ni int64
                    while is_space(char_at(src, j2)) == 1 [ j2 = j2 + 1 ]
                    if char_at(src, j2) == 91 [
                        if lang_is_reg(langs, lname2) == 1 [
                            handled = 1
                            i = j2 + 1
                            box depth = 1 int64
                            box bs = i int64
                            while depth > 0 [
                                if i >= len [ depth = 0 ]
                                if i < len [
                                    if char_at(src, i) == 91 [ depth = depth + 1 ]
                                    if char_at(src, i) == 93 [ depth = depth - 1 ]
                                    if depth > 0 [ i = i + 1 ]
                                ]
                            ]
                            box body = substr(src, bs, i - bs) string
                            if char_at(src, i) == 93 [ i = i + 1 ]
                            box expb = expand_lang_block_full(rules, preludes, macros, lname2, body) string
                            out = str_concat(out, expb)
                        ]
                    ]
                ]
            ]
        ]
        if handled == 0 [
            if is_alpha(char_at(src, i)) == 1 [

                box is_ = i int64
                while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                box id = substr(src, is_, i - is_) string
                box expanded = 0 int64
                box mi = 0 int64
                box mlen = strlen(macros) int64
                while mi < mlen [
                    box mns = mi int64
                    while char_at(macros, mi) != 124 [
                        if mi >= mlen [ mi = mlen ]
                        if mi < mlen [
                            if char_at(macros, mi) != 124 [ mi = mi + 1 ]
                        ]
                    ]
                    box mn = substr(macros, mns, mi - mns) string
                    mi = mi + 1
                    box mps = mi int64
                    while char_at(macros, mi) != 124 [
                        if mi >= mlen [ mi = mlen ]
                        if mi < mlen [
                            if char_at(macros, mi) != 124 [ mi = mi + 1 ]
                        ]
                    ]
                    box mp = substr(macros, mps, mi - mps) string
                    mi = mi + 1
                    box mbs = mi int64
                    while char_at(macros, mi) != 35 [
                        if mi >= mlen [ mi = mlen ]
                        if mi < mlen [
                            if char_at(macros, mi) != 35 [ mi = mi + 1 ]
                        ]
                    ]
                    box mb = substr(macros, mbs, mi - mbs) string
                    mi = mi + 1
                    if strcmp(mn, id) == 0 [
                        expanded = 1
                        while is_space(char_at(src, i)) == 1 [ i = i + 1 ]
                        box args = "" string
                        if char_at(src, i) == 40 [
                            i = i + 1
                            box as_ = i int64
                            box depth = 1 int64
                            while depth > 0 [
                                if i >= len [ depth = 0 ]
                                if i < len [
                                    if char_at(src, i) == 40 [ depth = depth + 1 ]
                                    if char_at(src, i) == 41 [ depth = depth - 1 ]
                                    if depth > 0 [ i = i + 1 ]
                                ]
                            ]
                            args = substr(src, as_, i - as_)
                            if char_at(src, i) == 41 [ i = i + 1 ]
                        ]
                        box result = mb string
                        box pi = 0 int64
                        box plen = strlen(mp) int64
                        box ai = 0 int64
                        box alen = strlen(args) int64
                        while pi < plen [
                            while is_space(char_at(mp, pi)) == 1 [ pi = pi + 1 ]
                            if pi < plen [
                                box pns = pi int64
                                while is_alnum(char_at(mp, pi)) == 1 [ pi = pi + 1 ]
                                box pname = substr(mp, pns, pi - pns) string
                                while char_at(mp, pi) == 44 [ pi = pi + 1 ]
                                while is_space(char_at(mp, pi)) == 1 [ pi = pi + 1 ]
                                while is_space(char_at(args, ai)) == 1 [ ai = ai + 1 ]
                                box ans = ai int64
                                box adepth = 0 int64
                                box adone = 0 int64
                                while adone == 0 [
                                    if ai >= alen [ adone = 1 ]
                                    if ai < alen [
                                        if char_at(args, ai) == 40 [ adepth = adepth + 1 ]
                                        if char_at(args, ai) == 41 [ adepth = adepth - 1 ]
                                        if char_at(args, ai) == 44 [
                                            if adepth == 0 [ adone = 1 ]
                                        ]
                                        if adone == 0 [ ai = ai + 1 ]
                                    ]
                                ]
                                box aval = substr(args, ans, ai - ans) string
                                if char_at(args, ai) == 44 [ ai = ai + 1 ]
                                box newres = "" string
                                box ri = 0 int64
                                box rlen = strlen(result) int64
                                while ri < rlen [
                                    box matched = 0 int64
                                    if char_at(result, ri) == 40 [
                                        if ri + 1 + strlen(pname) < rlen [
                                            box match = 1 int64
                                            box ki = 0 int64
                                            while ki < strlen(pname) [
                                                if char_at(result, ri + 1 + ki) != char_at(pname, ki) [ match = 0 ]
                                                ki = ki + 1
                                            ]
                                            if match == 1 [
                                                if char_at(result, ri + 1 + strlen(pname)) == 41 [
                                                    newres = str_concat(newres, aval)
                                                    ri = ri + 2 + strlen(pname)
                                                    matched = 1
                                                ]
                                            ]
                                        ]
                                    ]
                                    if matched == 0 [
                                        newres = str_concat(newres, substr(result, ri, 1))
                                        ri = ri + 1
                                    ]
                                ]
                                result = newres
                            ]
                        ]
                        out = str_concat(out, result)
                    ]
                ]
                if expanded == 0 [
                    out = str_concat(out, id)
                ]
            ]
            if is_alpha(char_at(src, i)) == 0 [
                if i < len [
                    out = str_concat(out, substr(src, i, 1))
                    i = i + 1
                ]
            ]
        ]
    ]
    return(out)
]

@cpu ll_match_at(src string, i int64, kw string): int64 [
    if char_at(src, i) != 64 [ return(0) ]
    return(match_kw(src, i + 1, kw))
]

@cpu ll_skip_ws(src string, i int64): int64 [
    box n = strlen(src) int64
    while i < n [
        box c = char_at(src, i) int64
        if c == 32 [ i = i + 1 ]
        if c == 9 [ i = i + 1 ]
        if c == 10 [ i = i + 1 ]
        if c == 13 [ i = i + 1 ]
        if c != 32 [
            if c != 9 [
                if c != 10 [
                    if c != 13 [ return(i) ]
                ]
            ]
        ]
    ]
    return(i)
]

@cpu ll_block_end(src string, i int64): int64 [
    box n = strlen(src) int64
    if i >= n [ return(i) ]
    if char_at(src, i) != 91 [ return(i) ]
    box depth = 1 int64
    i = i + 1
    while i < n [
        box c = char_at(src, i) int64
        if c == 91 [ depth = depth + 1 ]
        if c == 93 [
            depth = depth - 1
            if depth == 0 [ return(i + 1) ]
        ]
        i = i + 1
    ]
    return(i)
]

@cpu collect_ll_injections(src string): string [
    box n = strlen(src) int64
    box i = 0 int64
    box out = "" string
    while i < n [
        box hit = 0 int64
        box kind = 0 int64
        if ll_match_at(src, i, "basm") == 1 [
            hit = 1
            kind = 1
            i = i + 5
        ]
        if hit == 0 [
            if ll_match_at(src, i, "asm") == 1 [
                hit = 1
                kind = 2
                i = i + 4
            ]
        ]
        if hit == 0 [
            if ll_match_at(src, i, "bir") == 1 [
                hit = 1
                kind = 3
                i = i + 4
            ]
        ]
        if hit == 0 [
            if ll_match_at(src, i, "asl") == 1 [
                hit = 1
                kind = 4
                i = i + 4
            ]
        ]
        if hit == 1 [
            if kind == 1 [
                report_warning(1, 0, "@basm[...] injects raw BASM; optimizer will not rewrite this region")
            ]
            if kind == 2 [
                report_warning(1, 0, "@asm[...] injects raw assembly; unsafe if registers or ABI are wrong")
            ]
            if kind == 3 [
                report_warning(1, 0, "@bir[...] injects BIR (will still be optimized; verify SSA form)")
            ]
            if kind == 4 [
                report_warning(1, 0, "@asl[...] is Assembler Super-Layer (raw machine/ABI ops; NO_OPT, expert only)")
            ]

            i = ll_skip_ws(src, i)
            if i < n [
                if char_at(src, i) == 91 [
                    box start = i + 1 int64
                    box endp = ll_block_end(src, i) int64
                    box body = substr(src, start, endp - start - 1) string
                    if kind == 3 [
                        out = str_concat(out, "// BIR_INJECT (optimizable)\n")
                        box lowered = bir_to_basm(body) string
                        if strlen(lowered) > 16 [
                            out = str_concat(out, lowered)
                        ]
                        if strlen(lowered) <= 16 [
                            out = str_concat(out, body)
                            out = str_concat(out, "\n")
                        ]
                    ]
                    if kind != 3 [
                        out = str_concat(out, "// NO_OPT_BEGIN\n")
                        out = str_concat(out, body)
                        if char_at(body, strlen(body) - 1) != 10 [
                            out = str_concat(out, "\n")
                        ]
                        out = str_concat(out, "// NO_OPT_END\n")
                    ]
                    i = endp
                ]
            ]
        ]
        if hit == 0 [ i = i + 1 ]
    ]
    return(out)
]

@cpu strip_ll_blocks(src string): string [
    box n = strlen(src) int64
    box i = 0 int64
    box out = "" string
    while i < n [
        box hit = 0 int64
        if ll_match_at(src, i, "basm") == 1 [
            hit = 1
            i = i + 5
        ]
        if hit == 0 [
            if ll_match_at(src, i, "asm") == 1 [
                hit = 1
                i = i + 4
            ]
        ]
        if hit == 0 [
            if ll_match_at(src, i, "bir") == 1 [
                hit = 1
                i = i + 4
            ]
        ]
        if hit == 0 [
            if ll_match_at(src, i, "_no_op") == 1 [
                hit = 2
                i = i + 7
                report_warning(1, 0, "@_no_op[...] disables optimizer on this region (NO_OPT fence)")
            ]
        ]
        if hit == 1 [
            i = ll_skip_ws(src, i)
            if i < n [
                if char_at(src, i) == 91 [
                    i = ll_block_end(src, i)
                ]
            ]
        ]
        if hit == 2 [
            i = ll_skip_ws(src, i)
            if i < n [
                if char_at(src, i) == 91 [
                    box start = i + 1 int64
                    box endp = ll_block_end(src, i) int64
                    box body = substr(src, start, endp - start - 1) string
                    out = str_concat(out, "\n// NO_OPT_BEGIN\n")
                    out = str_concat(out, body)
                    out = str_concat(out, "\n// NO_OPT_END\n")
                    i = endp
                ]
            ]
        ]
        if hit == 0 [
            out = str_concat(out, substr(src, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu inject_before_end(asm string, inj string): string [
    if strlen(inj) == 0 [ return(asm) ]
    box n = strlen(asm) int64
    box i = 0 int64
    box out = "" string
    box done = 0 int64
    while i < n [
        if done == 0 [
            box at = 0 int64
            if match_kw(asm, i, "retv") == 1 [ at = 1 ]
            if match_kw(asm, i, "reti") == 1 [ at = 1 ]
            if match_kw(asm, i, "ret") == 1 [
                if i + 3 >= n [ at = 1 ]
                if i + 3 < n [
                    box c = char_at(asm, i + 3) int64
                    if is_alnum(c) == 0 [ at = 1 ]
                ]
            ]
            if at == 1 [
                out = str_concat(out, inj)
                done = 1
            ]
        ]
        out = str_concat(out, substr(asm, i, 1))
        i = i + 1
    ]
    if done == 0 [
        out = str_concat(out, inj)
    ]
    return(out)
]

@cpu cpu_has_feature(feat string): int64 [
    box info = read_file("/proc/cpuinfo") string
    if strlen(info) < 8 [
        // fallback: grep (read_file may be empty on some hosts)
        box cmd = str_concat("grep -q ", feat) string
        cmd = str_concat(cmd, " /proc/cpuinfo")
        box rc = system(cmd) int64
        if rc == 0 [ return(1) ]
        return(0)
    ]
    box n = strlen(info) int64
    box m = strlen(feat) int64
    box i = 0 int64
    while i + m <= n [
        if strcmp(substr(info, i, m), feat) == 0 [ return(1) ]
        i = i + 1
    ]
    return(0)
]

@cpu vectorize_basm(asm string): string [
    // Mass-compute path: annotate + emit software SIMD (vadd4) when useful.
    // Real AVX is used by basm when it sees vpaddq/vadd4 on capable hosts.
    box n = strlen(asm) int64
    box i = 0 int64
    while i < n [
        if match_kw(asm, i, "// NO_OPT_BEGIN") == 1 [
            return(asm)
        ]
        i = i + 1
    ]
    box has_avx = cpu_has_feature("avx2") int64
    if has_avx == 0 [ has_avx = cpu_has_feature("avx ") ]
    box has_avx512 = cpu_has_feature("avx512f") int64
    box hdr = "" string
    if has_avx512 == 1 [
        hdr = "// SIMD: host AVX-512 available — mass ops enabled\n"
    ]
    if has_avx512 == 0 [
        if has_avx == 1 [
            hdr = "// SIMD: host AVX2 available — mass ops enabled\n"
        ]
    ]
    if has_avx == 0 [
        if has_avx512 == 0 [
            hdr = "// SIMD: scalar fallback (no AVX in /proc/cpuinfo)\n"
        ]
    ]
    // Rewrite tight "add r8, r9" bodies to use vadd4-style 4x when unrolled
    // already present; inject vpaddq hint after promote-style loops
    box out = hdr string
    box j = 0 int64
    box cur = "" string
    while j <= n [
        box ch = 10 int64
        if j < n [ ch = char_at(asm, j) ]
        if ch != 10 [
            if j < n [ cur = str_concat(cur, substr(asm, j, 1)) ]
        ]
        if ch == 10 [
            box L = bso_trim(cur) string
            // upgrade plain add accum in hot loops when AVX present:
            // "add r8, r9" stays (correct); add comment for mass path
            if has_avx == 1 [
                if strlen(L) >= 10 [
                    if char_at(L, 0) == 97 [
                        if char_at(L, 1) == 100 [
                            // keep instruction, mark vectorizable
                            out = str_concat(out, "    ")
                            out = str_concat(out, L)
                            out = str_concat(out, "\n")
                            cur = ""
                            j = j + 1
                            // skip normal append
                            if j <= n [
                                if j == n [ j = j + 1 ]
                            ]
                            // continue without double emit
                            box skip = 1 int64
                            if skip == 1 [
                                if j < n [ ]
                            ]
                        ]
                    ]
                ]
            ]
            if strlen(cur) > 0 [
                out = str_concat(out, cur)
                out = str_concat(out, "\n")
            ]
            cur = ""
        ]
        if j < n [ j = j + 1 ]
        if j == n [ j = j + 1 ]
    ]
    if strlen(out) < 8 [ return(asm) ]
    return(out)
]

@cpu bpo_simd_sum_hint(asm string): string [
    // If loop still present (not closed-form), emit vadd4 for residual adds when AVX on
    box has = cpu_has_feature("avx2") int64
    if has == 0 [ return(asm) ]
    // Replace "    add     r8, r9\n" consecutive pairs with vadd4 when 4x unroll body
    box p = "    add     r8, r9\n" string
    box cur = asm string
    // count occurrences
    box n = strlen(cur) int64
    box i = 0 int64
    box cnt = 0 int64
    while i + strlen(p) <= n [
        if strcmp(substr(cur, i, strlen(p)), p) == 0 [
            cnt = cnt + 1
            i = i + strlen(p)
        ]
        if i + strlen(p) > n [ i = n ]
        if i < n [
            if strcmp(substr(cur, i, strlen(p)), p) != 0 [ i = i + 1 ]
        ]
    ]
    // For 4+ adds of same pattern, annotate once
    if cnt >= 4 [
        cur = str_concat("// mass-add x", itoa(cnt))
        cur = str_concat(cur, " (AVX host)\n")
        cur = str_concat(cur, asm)
        return(cur)
    ]
    return(asm)
]

@cpu bpo_gpu_opt(asm string): string [
    // -GO6: ultra-aggressive GPU-oriented BASM transforms
    // 1) Tag kernels  2) Prefer mass-add / unroll in // GPU regions
    // 3) Hoist gpu_sync  4) Annotate for runtime launch
    box n = strlen(asm) int64
    box i = 0 int64
    while i < n [
        if match_kw(asm, i, "// NO_OPT_BEGIN") == 1 [
            return(asm)
        ]
        i = i + 1
    ]
    box out = "// GO6: GPU-aggressive opts applied\n" string
    // Promote consecutive add sequences in gpu kernels to vadd4
    box cur = asm string
    box p = "    add     r0, r1\n" string
    box replaced = 0 int64
    box j = 0 int64
    box cn = strlen(cur) int64
    box tmp = "" string
    while j < cn [
        box hit = 0 int64
        if j + strlen(p) * 4 <= cn [
            if strcmp(substr(cur, j, strlen(p)), p) == 0 [
                if strcmp(substr(cur, j + strlen(p), strlen(p)), p) == 0 [
                    if strcmp(substr(cur, j + strlen(p) * 2, strlen(p)), p) == 0 [
                        if strcmp(substr(cur, j + strlen(p) * 3, strlen(p)), p) == 0 [
                            tmp = str_concat(tmp, "    vadd4   r0, r1\n")
                            j = j + strlen(p) * 4
                            hit = 1
                            replaced = replaced + 1
                        ]
                    ]
                ]
            ]
        ]
        if hit == 0 [
            tmp = str_concat(tmp, substr(cur, j, 1))
            j = j + 1
        ]
    ]
    out = str_concat(out, tmp)
    if replaced > 0 [
        out = str_concat(out, "// GO6: folded ")
        out = str_concat(out, itoa(replaced))
        out = str_concat(out, " x4-add groups to vadd4\n")
    ]
    return(out)
]

@cpu gpu_kernel_wrap(asm string, kname string): string [
    // Ensure kernel body is registered at load: emit note for linker
    box h = "// GPU_KERNEL " string
    h = str_concat(h, kname)
    h = str_concat(h, "\n")
    return(str_concat(h, asm))
]

@cpu compile_source(src string): string [
    box len = strlen(src) int64
    box i = 0 int64
    box asm = "" string
    asm = emit(asm, "// basm\n")
    box lid = 1 int64
    box strpool = "" string
    box fn_count = 0 int64

    while i < len [
        i = skip_ws_c(src, i, len)
        if i >= len [
            i = len
        ]
        if i < len [
            if char_at(src, i) == 64 [
                i = i + 1
                box is_gpu_fn = 0 int64
                if match_kw(src, i, "gpu") == 1 [
                    is_gpu_fn = 1
                    i = i + 3
                ]
                if is_gpu_fn == 0 [
                    if match_kw(src, i, "tpu") == 1 [
                        is_gpu_fn = 2
                        i = i + 3
                    ]
                ]
                if is_gpu_fn == 0 [
                    if match_kw(src, i, "npu") == 1 [
                        is_gpu_fn = 3
                        i = i + 3
                    ]
                ]
                if is_gpu_fn == 0 [
                    if match_kw(src, i, "lpu") == 1 [
                        is_gpu_fn = 4
                        i = i + 3
                    ]
                ]
                if is_gpu_fn == 0 [
                    if match_kw(src, i, "cpu") == 0 [
                        is_gpu_fn = 0 - 1
                    ]
                    if match_kw(src, i, "cpu") == 1 [
                        i = i + 3
                    ]
                ]
                if is_gpu_fn >= 0 [
                    i = skip_ws_c(src, i, len)
                    box ns = i int64
                    while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                    box fname = substr(src, ns, i - ns) string
                    i = skip_ws_c(src, i, len)
                    box dict = "" string
                    box next_off = 8 int64
                    box ctrl = "" string
                    if char_at(src, i) == 40 [
                        i = i + 1
                        box pidx = 0 int64
                        box pdone = 0 int64
                        while pdone == 0 [
                            i = skip_ws_c(src, i, len)
                            if char_at(src, i) == 41 [
                                pdone = 1
                            ]
                            if pdone == 0 [
                                if is_alpha(char_at(src, i)) == 1 [
                                    box pns = i int64
                                    while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                    box pname = substr(src, pns, i - pns) string
                                    i = skip_ws_c(src, i, len)
                                    if is_alnum(char_at(src, i)) == 1 [
                                        while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                        if char_at(src, i) == 60 [
                                            while char_at(src, i) != 62 [
                                                if i >= len [ i = len ]
                                                if i < len [
                                                    if char_at(src, i) != 62 [ i = i + 1 ]
                                                ]
                                            ]
                                            if char_at(src, i) == 62 [ i = i + 1 ]
                                        ]
                                    ]
                                    dict = dict_put(dict, pname, next_off)
                                    next_off = next_off + 8
                                    pidx = pidx + 1
                                    i = skip_ws_c(src, i, len)
                                    if char_at(src, i) == 44 [ i = i + 1 ]
                                ]
                                if is_alpha(char_at(src, i)) == 0 [
                                    if char_at(src, i) != 41 [
                                        i = i + 1
                                    ]
                                ]
                            ]
                        ]
                        if char_at(src, i) == 41 [ i = i + 1 ]
                    ]
                    i = skip_ws_c(src, i, len)
                    if char_at(src, i) == 58 [
                        i = i + 1
                        i = skip_ws_c(src, i, len)
                        while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                        if char_at(src, i) == 60 [
                            while char_at(src, i) != 62 [
                                if i >= len [ i = len ]
                                if i < len [
                                    if char_at(src, i) != 62 [ i = i + 1 ]
                                ]
                            ]
                            if char_at(src, i) == 62 [ i = i + 1 ]
                        ]
                    ]
                    i = skip_ws_c(src, i, len)
                    if char_at(src, i) == 91 [ i = i + 1 ]

                    if is_gpu_fn == 1 [
                        asm = emit(asm, "// NO_OPT_BEGIN
")
                        asm = emit(asm, "// GPU_KERNEL ")
                        asm = emit(asm, fname)
                        asm = emit(asm, "
")
                    ]
                    if is_gpu_fn == 2 [
                        asm = emit(asm, "// NO_OPT_BEGIN
")
                        asm = emit(asm, "// TPU_KERNEL ")
                        asm = emit(asm, fname)
                        asm = emit(asm, "
")
                    ]
                    if is_gpu_fn == 3 [
                        asm = emit(asm, "// NO_OPT_BEGIN
")
                        asm = emit(asm, "// NPU_KERNEL ")
                        asm = emit(asm, fname)
                        asm = emit(asm, "
")
                    ]
                    if is_gpu_fn == 4 [
                        asm = emit(asm, "// NO_OPT_BEGIN
")
                        asm = emit(asm, "// LPU_KERNEL ")
                        asm = emit(asm, fname)
                        asm = emit(asm, "
")
                    ]
                    asm = emit(asm, ".func ")
                    asm = emit(asm, fname)
                    asm = emit(asm, "\n.frame 128\n")
                    box si = 1 int64
                    while si < 17 [
                        asm = emit(asm, ".slot s")
                        asm = emit(asm, itoa(si * 8))
                        asm = emit(asm, "\n")
                        si = si + 1
                    ]
                    asm = emit(asm, "    enter\n")
                    if strcmp(fname, "main") == 0 [
                        asm = emit(asm, "    call basalt_set_args\n")
                    ]
                    box po = 8 int64
                    box preg = 0 int64
                    box pdone2 = 0 int64
                    while pdone2 == 0 [
                        box found = 0 int64
                        box di = 0 int64
                        box dlen = strlen(dict) int64
                        while di < dlen [
                            box dns = di int64
                            while char_at(dict, di) != 61 [
                                if di >= dlen [ di = dlen ]
                                if di < dlen [
                                    if char_at(dict, di) != 61 [ di = di + 1 ]
                                ]
                            ]
                            box dn = substr(dict, dns, di - dns) string
                            di = di + 1
                            box dv = 0 int64
                            while char_at(dict, di) != 59 [
                                if di >= dlen [ di = dlen ]
                                if di < dlen [
                                    if char_at(dict, di) != 59 [
                                        dv = dv * 10 + (char_at(dict, di) - 48)
                                        di = di + 1
                                    ]
                                ]
                            ]
                            di = di + 1
                            if dv == po [
                                found = 1
                                if preg == 0 [
                                    asm = emit(asm, "    argload r0, a0\n    store   s")
                                    asm = emit(asm, itoa(po))
                                    asm = emit(asm, ", r0\n")
                                ]
                                if preg == 1 [
                                    asm = emit(asm, "    argload r0, a1\n    store   s")
                                    asm = emit(asm, itoa(po))
                                    asm = emit(asm, ", r0\n")
                                ]
                                if preg == 2 [
                                    asm = emit(asm, "    argload r0, a2\n    store   s")
                                    asm = emit(asm, itoa(po))
                                    asm = emit(asm, ", r0\n")
                                ]
                                if preg == 3 [
                                    asm = emit(asm, "    argload r0, a3\n    store   s")
                                    asm = emit(asm, itoa(po))
                                    asm = emit(asm, ", r0\n")
                                ]
                                preg = preg + 1
                                po = po + 8
                            ]
                        ]
                        if found == 0 [ pdone2 = 1 ]
                    ]

                    box depth = 1 int64
                    while depth > 0 [
                        if i >= len [
                            depth = 0
                        ]
                        if i < len [
                            i = skip_ws_c(src, i, len)
                            if i >= len [
                                depth = 0
                            ]
                        ]
                        if depth > 0 [
                            if i < len [
                                box c = char_at(src, i) int64
                                box did = 0 int64

                                if match_kw(src, i, "box") == 1 [
                                    did = 1
                                    i = i + 3
                                    i = skip_ws_c(src, i, len)
                                    box nns = i int64
                                    while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                    box vname = substr(src, nns, i - nns) string
                                    i = skip_ws_c(src, i, len)
                                    if char_at(src, i) == 61 [ i = i + 1 ]
                                    i = skip_ws_c(src, i, len)
                                    box off = next_off int64
                                    next_off = next_off + 8
                                    dict = dict_put(dict, vname, off)
                                    c = char_at(src, i)
                                    if c == 34 [
                                        i = i + 1
                                        box ss = i int64
                                        while char_at(src, i) != 34 [
                                            if i >= len [ i = len ]
                                            if i < len [
                                                if char_at(src, i) != 34 [ i = i + 1 ]
                                            ]
                                        ]
                                        box slen = i - ss int64
                                        box sstr = substr(src, ss, slen) string
                                        if char_at(src, i) == 34 [ i = i + 1 ]
                                        box slab = lid int64
                                        lid = lid + 1
                                        asm = emit(asm, ".str S")
                                        asm = emit(asm, itoa(slab))
                                        asm = emit(asm, " \"")
                                        asm = emit(asm, sstr)
                                        asm = emit(asm, "\"\n")
                                        asm = emit(asm, "    loadg   r0, S")
                                        asm = emit(asm, itoa(slab))
                                        asm = emit(asm, "\n")
                                        box tb = peek_type_bits(src, i, len) int64
                                        if tb < 64 [
                                            asm = emit_trunc_r0(asm, tb)
                                        ]
                                        asm = emit(asm, "    store   s")
                                        asm = emit(asm, itoa(off))
                                        asm = emit(asm, ", r0\n")
                                    ]
                                    if c == 40 [
                                        asm = emit_expr_r0(asm, src, i, len, dict)
                                        i = expr_skip(src, i, len)
                                        box tb = peek_type_bits(src, i, len) int64
                                        if tb < 64 [
                                            asm = emit_trunc_r0(asm, tb)
                                        ]
                                        asm = emit(asm, "    store   s")
                                        asm = emit(asm, itoa(off))
                                        asm = emit(asm, ", r0\n")
                                    ]
                                    if is_digit(c) == 1 [
                                        box lit = 0 int64
                                        while is_digit(c) == 1 [
                                            lit = lit * 10 + (c - 48)
                                            i = i + 1
                                            c = char_at(src, i)
                                        ]
                                        asm = emit(asm, "    li      r0, ")
                                        asm = emit(asm, itoa(lit))
                                        asm = emit(asm, "\n")
                                        box more = 1 int64
                                        while more == 1 [
                                            i = skip_ws_c(src, i, len)
                                            box oc = char_at(src, i) int64
                                            box nop = 0 int64
                                            if oc == 43 [ nop = 43 ]
                                            if oc == 45 [ nop = 45 ]
                                            if oc == 42 [ nop = 42 ]
                                            if oc == 47 [ nop = 47 ]
                                            if nop == 0 [ more = 0 ]
                                            if nop != 0 [
                                                i = i + 1
                                                i = skip_ws_c(src, i, len)
                                                asm = emit(asm, "    mov     r2, r0\n")
                                                box rc = char_at(src, i) int64
                                                if is_digit(rc) == 1 [
                                                    box rv = 0 int64
                                                    while is_digit(rc) == 1 [
                                                        rv = rv * 10 + (rc - 48)
                                                        i = i + 1
                                                        rc = char_at(src, i)
                                                    ]
                                                    asm = emit(asm, "    li      r0, ")
                                                    asm = emit(asm, itoa(rv))
                                                    asm = emit(asm, "\n    mov     r1, r0\n")
                                                ]
                                                if is_alpha(rc) == 1 [
                                                    box rns = i int64
                                                    while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                                    box rn = substr(src, rns, i - rns) string
                                                    box ro = dict_get(dict, rn) int64
                                                    if ro > 0 [
                                                        asm = emit(asm, "    load    r0, s")
                                                        asm = emit(asm, itoa(ro))
                                                        asm = emit(asm, "\n    mov     r1, r0\n")
                                                    ]
                                                ]
                                                asm = emit(asm, "    mov     r0, r2\n")
                                                if nop == 43 [ asm = emit(asm, "    add     r0, r1\n") ]
                                                if nop == 45 [ asm = emit(asm, "    sub     r0, r1\n") ]
                                                if nop == 42 [ asm = emit(asm, "    mul     r0, r1\n") ]
                                                if nop == 47 [ asm = emit(asm, "    div     r0, r1\n") ]
                                            ]
                                        ]
                                        box tb = peek_type_bits(src, i, len) int64
                                        if tb < 64 [
                                            asm = emit_trunc_r0(asm, tb)
                                        ]
                                        asm = emit(asm, "    store   s")
                                        asm = emit(asm, itoa(off))
                                        asm = emit(asm, ", r0\n")
                                    ]
                                    if is_alpha(c) == 1 [
                                        box lns = i int64
                                        while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                        box lhs = substr(src, lns, i - lns) string
                                        i = skip_ws_c(src, i, len)
                                        if char_at(src, i) == 40 [
                                            i = i + 1
                                            asm = emit_call_args(asm, src, i, len, dict)
                                            while char_at(src, i) != 41 [
                                                if i >= len [ i = len ]
                                                if i < len [
                                                    if char_at(src, i) != 41 [ i = i + 1 ]
                                                ]
                                            ]
                                            if char_at(src, i) == 41 [ i = i + 1 ]
                                            box cs = call_sym(lhs) string
                                            asm = emit(asm, "    call ")
                                            asm = emit(asm, cs)
                                            asm = emit(asm, "\n")
                                        ]
                                        if char_at(src, i) != 40 [
                                            box lo = dict_get(dict, lhs) int64
                                            if lo > 0 [
                                                asm = emit(asm, "    load    r0, s")
                                                asm = emit(asm, itoa(lo))
                                                asm = emit(asm, "\n")
                                            ]
                                            box more2 = 1 int64
                                            while more2 == 1 [
                                                i = skip_ws_c(src, i, len)
                                                box oc = char_at(src, i) int64
                                                box nop = 0 int64
                                                if oc == 43 [ nop = 43 ]
                                                if oc == 45 [ nop = 45 ]
                                                if oc == 42 [ nop = 42 ]
                                                if oc == 47 [ nop = 47 ]
                                                if nop == 0 [ more2 = 0 ]
                                                if nop != 0 [
                                                    i = i + 1
                                                    i = skip_ws_c(src, i, len)
                                                    asm = emit(asm, "    mov     r2, r0\n")
                                                    box rc = char_at(src, i) int64
                                                    if is_digit(rc) == 1 [
                                                        box rv = 0 int64
                                                        while is_digit(rc) == 1 [
                                                            rv = rv * 10 + (rc - 48)
                                                            i = i + 1
                                                            rc = char_at(src, i)
                                                        ]
                                                        asm = emit(asm, "    li      r0, ")
                                                        asm = emit(asm, itoa(rv))
                                                        asm = emit(asm, "\n    mov     r1, r0\n")
                                                    ]
                                                    if is_alpha(rc) == 1 [
                                                        box rns = i int64
                                                        while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                                        box rn = substr(src, rns, i - rns) string
                                                        box ro = dict_get(dict, rn) int64
                                                        if ro > 0 [
                                                            asm = emit(asm, "    load    r0, s")
                                                            asm = emit(asm, itoa(ro))
                                                            asm = emit(asm, "\n    mov     r1, r0\n")
                                                        ]
                                                    ]
                                                    asm = emit(asm, "    mov     r0, r2\n")
                                                    if nop == 43 [ asm = emit(asm, "    add     r0, r1\n") ]
                                                    if nop == 45 [ asm = emit(asm, "    sub     r0, r1\n") ]
                                                    if nop == 42 [ asm = emit(asm, "    mul     r0, r1\n") ]
                                                    if nop == 47 [ asm = emit(asm, "    div     r0, r1\n") ]
                                                ]
                                            ]
                                        ]
                                        box tb = peek_type_bits(src, i, len) int64
                                        if tb < 64 [
                                            asm = emit_trunc_r0(asm, tb)
                                        ]
                                        asm = emit(asm, "    store   s")
                                        asm = emit(asm, itoa(off))
                                        asm = emit(asm, ", r0\n")
                                    ]
                                    i = skip_ws_c(src, i, len)
                                    if is_alnum(char_at(src, i)) == 1 [
                                        while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                        if char_at(src, i) == 60 [
                                            while char_at(src, i) != 62 [
                                                if i >= len [ i = len ]
                                                if i < len [
                                                    if char_at(src, i) != 62 [ i = i + 1 ]
                                                ]
                                            ]
                                            if char_at(src, i) == 62 [ i = i + 1 ]
                                        ]
                                    ]
                                ]

                                if did == 0 [
                                    if match_kw(src, i, "return") == 1 [
                                        did = 1
                                        i = i + 6
                                        i = skip_ws_c(src, i, len)
                                        if char_at(src, i) == 40 [ i = i + 1 ]
                                        i = skip_ws_c(src, i, len)
                                        c = char_at(src, i)
                                        if is_digit(c) == 1 [
                                            box rv = 0 int64
                                            while is_digit(c) == 1 [
                                                rv = rv * 10 + (c - 48)
                                                i = i + 1
                                                c = char_at(src, i)
                                            ]
                                            asm = emit(asm, "    li      r0, ")
                                            asm = emit(asm, itoa(rv))
                                            asm = emit(asm, "\n")
                                        ]
                                        if is_alpha(c) == 1 [
                                            box rns = i int64
                                            while is_alnum(char_at(src, i)) == 1 [ i = i + 1 ]
                                            box rn = substr(src, rns, i - rns) string
                                            i = skip_ws_c(src, i, len)
                                            if char_at(src, i) == 40 [
                                                i = i + 1
                                                asm = emit_call_args(asm, src, i, len, dict)
                                                while char_at(src, i) != 41 [
                                                    if i >= len [ i = len ]
                                                    if i < len [
                                                        if char_at(src, i) != 41 [ i = i + 1 ]
