            if char_at(src, i) != 64 [
                if i < len [
                    i = i + 1
                ]
            ]
        ]
    ]

    box sci = 0 int64
    box sclen = strlen(strpool) int64
    box has_ro = 0 int64
    while sci < sclen [
        if char_at(strpool, sci) == 83 [
            if sci + 1 < sclen [
                if char_at(strpool, sci + 1) == 58 [
                    if has_ro == 0 [
                        asm = emit(asm, "")
                        has_ro = 1
                    ]
                    sci = sci + 2
                    box slab = 0 int64
                    while char_at(strpool, sci) != 58 [
                        slab = slab * 10 + (char_at(strpool, sci) - 48)
                        sci = sci + 1
                    ]
                    sci = sci + 1
                    box sts = sci int64
                    while char_at(strpool, sci) != 59 [
                        sci = sci + 1
                    ]
                    box stxt = substr(strpool, sts, sci - sts) string
                    asm = emit(asm, ".str S")
                    asm = emit(asm, itoa(slab))
                    asm = emit(asm, " \"")
                    asm = emit(asm, stxt)
                    asm = emit(asm, "\"\n")
                ]
            ]
        ]
        sci = sci + 1
    ]
    return(asm)
]

@cpu bso_trim(line string): string [
    box n = strlen(line) int64
    box s = 0 int64
    box tr = 1 int64
    while tr == 1 [
        if s >= n [ tr = 0 ]
        if s < n [
            box ch = char_at(line, s) int64
            if ch == 32 [ s = s + 1 ]
            if ch == 9 [ s = s + 1 ]
            if ch != 32 [
                if ch != 9 [ tr = 0 ]
            ]
        ]
    ]
    if s >= n [ return("") ]
    return(substr(line, s, n - s))
]

@cpu bso_is_comment(L string): int64 [
    if strlen(L) < 2 [ return(0) ]
    if char_at(L, 0) == 47 [
        if char_at(L, 1) == 47 [ return(1) ]
    ]
    return(0)
]

@cpu bso_is_barrier(L string): int64 [
    box n = strlen(L) int64
    if n < 1 [ return(0) ]
    if char_at(L, 0) == 46 [ return(1) ]
    if char_at(L, 0) == 106 [ return(1) ]
    // loadg / print_str must not be rewritten by store-forward opts
    if match_kw(L, 0, "loadg") == 1 [ return(1) ]
    if match_kw(L, 0, "print_str") == 1 [ return(1) ]
    if match_kw(L, 0, "print_int") == 1 [ return(1) ]
    if match_kw(L, 0, "print_nl") == 1 [ return(1) ]
    if n >= 3 [
        if char_at(L, 0) == 99 [
            if char_at(L, 1) == 109 [
                if char_at(L, 2) == 112 [ return(1) ]
            ]
        ]
    ]
    if n >= 4 [
        if char_at(L, 0) == 99 [
            if char_at(L, 1) == 97 [
                if char_at(L, 2) == 108 [
                    if char_at(L, 3) == 108 [
                        if n == 4 [ return(1) ]
                        if n > 4 [
                            if char_at(L, 4) == 32 [ return(1) ]
                        ]
                    ]
                ]
            ]
        ]
    ]
    if n >= 3 [
        if char_at(L, 0) == 114 [
            if char_at(L, 1) == 101 [
                if char_at(L, 2) == 116 [ return(1) ]
            ]
        ]
    ]
    if n >= 5 [
        if char_at(L, 0) == 101 [
            if char_at(L, 1) == 110 [
                if char_at(L, 2) == 116 [
                    if char_at(L, 3) == 101 [
                        if char_at(L, 4) == 114 [ return(1) ]
                    ]
                ]
            ]
        ]
    ]
    return(0)
]

@cpu bso_map_get(m string, key string): string [
    box di = 0 int64
    box dlen = strlen(m) int64
    box klen = strlen(key) int64
    while di < dlen [
        box match = 1 int64
        box k = 0 int64
        while k < klen [
            if di + k >= dlen [ match = 0 ]
            if di + k < dlen [
                if char_at(m, di + k) != char_at(key, k) [ match = 0 ]
            ]
            k = k + 1
        ]
        if match == 1 [
            if di + klen < dlen [
                if char_at(m, di + klen) == 61 [
                    box vs = di + klen + 1 int64
                    box ve = vs int64
                    while ve < dlen [
                        if char_at(m, ve) == 59 [
                            return(substr(m, vs, ve - vs))
                        ]
                        ve = ve + 1
                    ]
                ]
            ]
        ]
        di = di + 1
    ]
    return("")
]

@cpu bso_map_put(m string, key string, val string): string [
    box dlen = strlen(m) int64
    box klen = strlen(key) int64
    box out = "" string
    box di = 0 int64
    while di < dlen [
        box match = 1 int64
        box k = 0 int64
        while k < klen [
            if di + k >= dlen [ match = 0 ]
            if di + k < dlen [
                if char_at(m, di + k) != char_at(key, k) [ match = 0 ]
            ]
            k = k + 1
        ]
        if match == 1 [
            if di + klen < dlen [
                if char_at(m, di + klen) == 61 [
                    while di < dlen [
                        if char_at(m, di) == 59 [
                            di = di + 1
                            di = dlen + di
                        ]
                        if di < dlen [
                            if char_at(m, di) != 59 [ di = di + 1 ]
                        ]
                    ]
                    if di > dlen [
                        di = di - dlen
                    ]
                ]
            ]
        ]
        if di < dlen [
            box es = di int64
            while di < dlen [
                if char_at(m, di) == 59 [
                    out = str_concat(out, substr(m, es, di - es + 1))
                    di = di + 1
                    di = dlen + di
                ]
                if di < dlen [
                    if char_at(m, di) != 59 [ di = di + 1 ]
                ]
            ]
            if di > dlen [
                di = di - dlen
            ]
        ]
    ]
    out = str_concat(out, key)
    out = str_concat(out, "=")
    out = str_concat(out, val)
    out = str_concat(out, ";")
    return(out)
]

@cpu bso_map_del(m string, key string): string [
    return(bso_map_put(m, key, ""))
]

@cpu bso_parse_int(s string): int64 [
    box n = strlen(s) int64
    box i = 0 int64
    box sign = 1 int64
    if n > 0 [
        if char_at(s, 0) == 45 [
            sign = 0 - 1
            i = 1
        ]
    ]
    box v = 0 int64
    while i < n [
        box d = char_at(s, i) int64
        if d >= 48 [
            if d <= 57 [
                v = v * 10 + (d - 48)
            ]
        ]
        i = i + 1
    ]
    return(v * sign)
]

@cpu bir_trim(line string): string [
    box n = strlen(line) int64
    box s = 0 int64
    while s < n [
        box ch = char_at(line, s) int64
        if ch != 32 [
            if ch != 9 [
                return(substr(line, s, n - s))
            ]
        ]
        s = s + 1
    ]
    return("")
]

@cpu basm_to_bir(asm string): string [
    box src = asm string
    box out = "// BIR\n" string
    box len = strlen(src) int64
    box i = 0 int64
    box line = "" string
    box vid = 0 int64
    box rmap = "" string
    while i <= len [
        box ch = 10 int64
        if i < len [ ch = char_at(src, i) ]
        if ch != 10 [
            if i < len [ line = str_concat(line, substr(src, i, 1)) ]
        ]
        if ch == 10 [
            box L = bir_trim(line) string
            line = ""
            if strlen(L) > 0 [
                if char_at(L, 0) == 46 [
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                ]
                if char_at(L, 0) == 46 [
                    box z = 0 int64
                ]
                if strcmp(L, "enter") == 0 [
                    out = str_concat(out, "enter\n")
                ]
                if char_at(L, 0) == 46 [
                    box zz = 0 int64
                ]
                if char_at(L, 0) == 46 [
                    if char_at(L, 1) == 76 [
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) == 108 [
                    if char_at(L, 1) == 105 [
                        box j = 2 int64
                        while char_at(L, j) == 32 [ j = j + 1 ]
                        if char_at(L, j) == 114 [
                            j = j + 1
                            box rn = 0 int64
                            while is_digit(char_at(L, j)) == 1 [
                                rn = rn * 10 + (char_at(L, j) - 48)
                                j = j + 1
                            ]
                            while char_at(L, j) == 32 [ j = j + 1 ]
                            if char_at(L, j) == 44 [ j = j + 1 ]
                            while char_at(L, j) == 32 [ j = j + 1 ]
                            box imm = 0 int64
                            box neg = 0 int64
                            if char_at(L, j) == 45 [
                                neg = 1
                                j = j + 1
                            ]
                            while is_digit(char_at(L, j)) == 1 [
                                imm = imm * 10 + (char_at(L, j) - 48)
                                j = j + 1
                            ]
                            if neg == 1 [ imm = 0 - imm ]
                            out = str_concat(out, "v")
                            out = str_concat(out, itoa(vid))
                            out = str_concat(out, " = const ")
                            out = str_concat(out, itoa(imm))
                            out = str_concat(out, "\n")
                            rmap = str_concat(rmap, "r")
                            rmap = str_concat(rmap, itoa(rn))
                            rmap = str_concat(rmap, "=")
                            rmap = str_concat(rmap, itoa(vid))
                            rmap = str_concat(rmap, ";")
                            vid = vid + 1
                        ]
                    ]
                ]
                if char_at(L, 0) == 115 [
                    if char_at(L, 1) == 116 [
                        if char_at(L, 2) == 111 [
                            box j = 5 int64
                            while char_at(L, j) == 32 [ j = j + 1 ]
                            box ss = j int64
                            while is_alnum(char_at(L, j)) == 1 [ j = j + 1 ]
                            box slot = substr(L, ss, j - ss) string
                            while char_at(L, j) == 32 [ j = j + 1 ]
                            if char_at(L, j) == 44 [ j = j + 1 ]
                            while char_at(L, j) == 32 [ j = j + 1 ]
                            box rn = 0 int64
                            if char_at(L, j) == 114 [
                                j = j + 1
                                while is_digit(char_at(L, j)) == 1 [
                                    rn = rn * 10 + (char_at(L, j) - 48)
                                    j = j + 1
                                ]
                            ]
                            box di = 0 int64
                            box dlen = strlen(rmap) int64
                            box found = 0 - 1 int64
                            while di < dlen [
                                if char_at(rmap, di) == 114 [
                                    box k = di + 1 int64
                                    box rrn = 0 int64
                                    while is_digit(char_at(rmap, k)) == 1 [
                                        rrn = rrn * 10 + (char_at(rmap, k) - 48)
                                        k = k + 1
                                    ]
                                    if char_at(rmap, k) == 61 [
                                        k = k + 1
                                        box vv = 0 int64
                                        while is_digit(char_at(rmap, k)) == 1 [
                                            vv = vv * 10 + (char_at(rmap, k) - 48)
                                            k = k + 1
                                        ]
                                        if rrn == rn [ found = vv ]
                                    ]
                                ]
                                di = di + 1
                            ]
                            out = str_concat(out, "store v")
                            out = str_concat(out, itoa(found))
                            out = str_concat(out, " -> ")
                            out = str_concat(out, slot)
                            out = str_concat(out, "\n")
                        ]
                    ]
                ]
                if char_at(L, 0) == 108 [
                    if char_at(L, 1) == 111 [
                        if char_at(L, 2) == 97 [
                            box j = 4 int64
                            while char_at(L, j) == 32 [ j = j + 1 ]
                            box rn = 0 int64
                            if char_at(L, j) == 114 [
                                j = j + 1
                                while is_digit(char_at(L, j)) == 1 [
                                    rn = rn * 10 + (char_at(L, j) - 48)
                                    j = j + 1
                                ]
                            ]
                            while char_at(L, j) == 32 [ j = j + 1 ]
                            if char_at(L, j) == 44 [ j = j + 1 ]
                            while char_at(L, j) == 32 [ j = j + 1 ]
                            box ss = j int64
                            while is_alnum(char_at(L, j)) == 1 [ j = j + 1 ]
                            box slot = substr(L, ss, j - ss) string
                            out = str_concat(out, "v")
                            out = str_concat(out, itoa(vid))
                            out = str_concat(out, " = load ")
                            out = str_concat(out, slot)
                            out = str_concat(out, "\n")
                            rmap = str_concat(rmap, "r")
                            rmap = str_concat(rmap, itoa(rn))
                            rmap = str_concat(rmap, "=")
                            rmap = str_concat(rmap, itoa(vid))
                            rmap = str_concat(rmap, ";")
                            vid = vid + 1
                        ]
                    ]
                ]
                if char_at(L, 0) == 97 [
                    if char_at(L, 1) == 100 [
                        if char_at(L, 2) == 100 [
                            out = str_concat(out, "v")
                            out = str_concat(out, itoa(vid))
                            out = str_concat(out, " = add r0, r1\n")
                            rmap = str_concat(rmap, "r0=")
                            rmap = str_concat(rmap, itoa(vid))
                            rmap = str_concat(rmap, ";")
                            vid = vid + 1
                        ]
                    ]
                ]
                if char_at(L, 0) == 115 [
                    if char_at(L, 1) == 117 [
                        if char_at(L, 2) == 98 [
                            out = str_concat(out, "v")
                            out = str_concat(out, itoa(vid))
                            out = str_concat(out, " = sub r0, r1\n")
                            rmap = str_concat(rmap, "r0=")
                            rmap = str_concat(rmap, itoa(vid))
                            rmap = str_concat(rmap, ";")
                            vid = vid + 1
                        ]
                    ]
                ]
                if char_at(L, 0) == 99 [
                    if char_at(L, 1) == 109 [
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) == 106 [
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                ]
                if char_at(L, 0) == 112 [
                    if char_at(L, 1) == 114 [
                        out = str_concat(out, "call print_int\n")
                    ]
                ]
                if char_at(L, 0) == 99 [
                    if char_at(L, 1) == 97 [
                        if char_at(L, 2) == 108 [
                            out = str_concat(out, L)
                            out = str_concat(out, "\n")
                        ]
                    ]
                ]
                if char_at(L, 0) == 114 [
                    if char_at(L, 1) == 101 [
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) == 97 [
                    if char_at(L, 1) == 114 [
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) == 109 [
                    if char_at(L, 1) == 111 [
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
            ]
        ]
        if i < len [ i = i + 1 ]
        if i == len [
            if strlen(line) > 0 [
                ch = 10
            ]
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bir_dedupe(bir string): string [
    // Drop consecutive duplicate lines (BIR often re-emits const)
    box src = bir string
    box out = "" string
    box prev = "" string
    box len = strlen(src) int64
    box i = 0 int64
    box line = "" string
    while i <= len [
        box ch = 10 int64
        if i < len [ ch = char_at(src, i) ]
        if ch != 10 [
            if i < len [ line = str_concat(line, substr(src, i, 1)) ]
        ]
        if ch == 10 [
            if strlen(line) > 0 [
                if strcmp(line, prev) != 0 [
                    out = str_concat(out, line)
                    out = str_concat(out, "\n")
                    prev = line
                ]
            ]
            line = ""
        ]
        if i < len [ i = i + 1 ]
        if i == len [
            if strlen(line) > 0 [ ch = 10 ]
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bir_const_fold_add(bir string): string [
    // vX = add vA, vB where both const -> vX = const (a+b)
    // Lightweight SSA-ish fold for O5
    box src = bir string
    // Build simple const map from "vN = const IMM"
    box cmap = "" string
    box len = strlen(src) int64
    box i = 0 int64
    box line = "" string
    while i <= len [
        box ch = 10 int64
        if i < len [ ch = char_at(src, i) ]
        if ch != 10 [
            if i < len [ line = str_concat(line, substr(src, i, 1)) ]
        ]
        if ch == 10 [
            box L = bir_trim(line) string
            line = ""
            if strlen(L) > 2 [
                if char_at(L, 0) == 118 [
                    box j = 1 int64
                    box vn = 0 int64
                    while is_digit(char_at(L, j)) == 1 [
                        vn = vn * 10 + (char_at(L, j) - 48)
                        j = j + 1
                    ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    if char_at(L, j) == 61 [ j = j + 1 ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    if char_at(L, j) == 99 [
                        if char_at(L, j + 1) == 111 [
                            j = j + 6
                            while char_at(L, j) == 32 [ j = j + 1 ]
                            box imm = 0 int64
                            box neg = 0 int64
                            if char_at(L, j) == 45 [
                                neg = 1
                                j = j + 1
                            ]
                            while is_digit(char_at(L, j)) == 1 [
                                imm = imm * 10 + (char_at(L, j) - 48)
                                j = j + 1
                            ]
                            if neg == 1 [ imm = 0 - imm ]
                            cmap = str_concat(cmap, "v")
                            cmap = str_concat(cmap, itoa(vn))
                            cmap = str_concat(cmap, "=")
                            cmap = str_concat(cmap, itoa(imm))
                            cmap = str_concat(cmap, ";")
                        ]
                    ]
                ]
            ]
        ]
        if i < len [ i = i + 1 ]
        if i == len [
            if strlen(line) > 0 [ ch = 10 ]
            i = i + 1
        ]
    ]
    // Second pass: rewrite add of two consts
    box out = "" string
    i = 0
    line = ""
    while i <= len [
        box ch2 = 10 int64
        if i < len [ ch2 = char_at(src, i) ]
        if ch2 != 10 [
            if i < len [ line = str_concat(line, substr(src, i, 1)) ]
        ]
        if ch2 == 10 [
            box L = bir_trim(line) string
            line = ""
            box rewritten = 0 int64
            if strlen(L) > 6 [
                if char_at(L, 0) == 118 [
                    // look for "= add v"
                    box j = 1 int64
                    box vn = 0 int64
                    while is_digit(char_at(L, j)) == 1 [
                        vn = vn * 10 + (char_at(L, j) - 48)
                        j = j + 1
                    ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    if char_at(L, j) == 61 [ j = j + 1 ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    if char_at(L, j) == 97 [
                        if char_at(L, j + 1) == 100 [
                            if char_at(L, j + 2) == 100 [
                                j = j + 3
                                while char_at(L, j) == 32 [ j = j + 1 ]
                                if char_at(L, j) == 118 [
                                    j = j + 1
                                    box a = 0 int64
                                    while is_digit(char_at(L, j)) == 1 [
                                        a = a * 10 + (char_at(L, j) - 48)
                                        j = j + 1
                                    ]
                                    while char_at(L, j) == 32 [ j = j + 1 ]
                                    if char_at(L, j) == 44 [ j = j + 1 ]
                                    while char_at(L, j) == 32 [ j = j + 1 ]
                                    if char_at(L, j) == 118 [
                                        j = j + 1
                                        box b = 0 int64
                                        while is_digit(char_at(L, j)) == 1 [
                                            b = b * 10 + (char_at(L, j) - 48)
                                            j = j + 1
                                        ]
                                        // lookup a and b in cmap
                                        box ka = str_concat("v", itoa(a)) string
                                        box kb = str_concat("v", itoa(b)) string
                                        box va = bso_map_get(cmap, ka) string
                                        box vb = bso_map_get(cmap, kb) string
                                        if strlen(va) > 0 [
                                            if strlen(vb) > 0 [
                                                box suma = bso_parse_int(va) + bso_parse_int(vb) int64
                                                out = str_concat(out, "v")
                                                out = str_concat(out, itoa(vn))
                                                out = str_concat(out, " = const ")
                                                out = str_concat(out, itoa(suma))
                                                out = str_concat(out, "\n")
                                                rewritten = 1
                                            ]
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]
            ]
            if rewritten == 0 [
                if strlen(L) > 0 [
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                ]
            ]
        ]
        if i < len [ i = i + 1 ]
        if i == len [
            if strlen(line) > 0 [ ch2 = 10 ]
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bir_optimize(bir string): string [
    box cur = bir string
    box pass = 0 int64
    while pass < 6 [
        box out = "" string
        box len = strlen(cur) int64
        box i = 0 int64
        box line = "" string
        box cmap = "" string
        while i <= len [
            box ch = 10 int64
            if i < len [ ch = char_at(cur, i) ]
