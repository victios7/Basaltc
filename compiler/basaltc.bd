
@cpu is_space(c int64): int64 [
    if c == 32 [ return(1) ]
    if c == 9 [ return(1) ]
    if c == 10 [ return(1) ]
    if c == 13 [ return(1) ]
    return(0)
]

@cpu is_digit(c int64): int64 [
    if c >= 48 [
        if c <= 57 [ return(1) ]
    ]
    return(0)
]

@cpu is_alpha(c int64): int64 [
    if c >= 65 [
        if c <= 90 [ return(1) ]
    ]
    if c >= 97 [
        if c <= 122 [ return(1) ]
    ]
    if c == 95 [ return(1) ]
    return(0)
]

@cpu is_alnum(c int64): int64 [
    if is_alpha(c) == 1 [ return(1) ]
    if is_digit(c) == 1 [ return(1) ]
    return(0)
]

@cpu dict_put(d string, name string, off int64): string [
    box x = str_concat(d, name) string
    x = str_concat(x, "=")
    x = str_concat(x, itoa(off))
    x = str_concat(x, ";")
    return(x)
]

@cpu dict_get(d string, name string): int64 [
    box di = 0 int64
    box dlen = strlen(d) int64
    while di < dlen [
        box dns = di int64
        while char_at(d, di) != 61 [
            if di >= dlen [ return(0 - 1) ]
            if char_at(d, di) != 61 [ di = di + 1 ]
        ]
        box dn = substr(d, dns, di - dns) string
        di = di + 1
        box dv = 0 int64
        while char_at(d, di) != 59 [
            if di >= dlen [ return(0 - 1) ]
            dv = dv * 10 + (char_at(d, di) - 48)
            di = di + 1
        ]
        di = di + 1
        if strcmp(dn, name) == 0 [ return(dv) ]
    ]
    return(0 - 1)
]

@cpu emit(a string, s string): string [
    return(str_concat(a, s))
]

@cpu skip_ws_c(src string, i int64, len int64): int64 [
    box cont = 1 int64
    while cont == 1 [
        if i >= len [ cont = 0 ]
        if i < len [
            box c = char_at(src, i) int64
            if is_space(c) == 1 [
                i = i + 1
            ]
            if is_space(c) == 0 [
                // // line comment
                if c == 47 [
                    if i + 1 < len [
                        if char_at(src, i + 1) == 47 [
                            i = i + 2
                            box ic = 1 int64
                            while ic == 1 [
                                if i >= len [ ic = 0 ]
                                if i < len [
                                    if char_at(src, i) == 10 [ ic = 0 ]
                                    i = i + 1
                                ]
                            ]
                        ]
                        // /* block comment */
                        if char_at(src, i + 1) == 42 [
                            i = i + 2
                            box bc = 1 int64
                            while bc == 1 [
                                if i + 1 >= len [ bc = 0 ]
                                if i + 1 < len [
                                    if char_at(src, i) == 42 [
                                        if char_at(src, i + 1) == 47 [
                                            i = i + 2
                                            bc = 0
                                        ]
                                    ]
                                    if bc == 1 [ i = i + 1 ]
                                ]
                            ]
                        ]
                        if char_at(src, i + 1) != 47 [
                            if char_at(src, i + 1) != 42 [ cont = 0 ]
                        ]
                    ]
                    if i + 1 >= len [ cont = 0 ]
                ]
                // ; line comment (asm-style)
                if c == 59 [
                    i = i + 1
                    box sc = 1 int64
                    while sc == 1 [
                        if i >= len [ sc = 0 ]
                        if i < len [
                            if char_at(src, i) == 10 [ sc = 0 ]
                            i = i + 1
                        ]
                    ]
                ]
                if c != 47 [
                    if c != 59 [ cont = 0 ]
                ]
            ]
        ]
    ]
    return(i)
]

@cpu match_kw(src string, i int64, kw string): int64 [
    if i > 0 [
        if is_alnum(char_at(src, i - 1)) == 1 [ return(0) ]
    ]
    box klen = strlen(kw) int64
    box j = 0 int64
    while j < klen [
        if i + j >= strlen(src) [ return(0) ]
        if char_at(src, i + j) != char_at(kw, j) [ return(0) ]
        j = j + 1
    ]
    if i + klen < strlen(src) [
        if is_alnum(char_at(src, i + klen)) == 1 [ return(0) ]
    ]
    return(1)
]

