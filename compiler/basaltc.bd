@cpu bpo_peep_cpu(asm string): string [
    box cur = asm string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    box dup = "    arg     a0, r0
    arg     a0, r0
" string
    box one = "    arg     a0, r0
" string
    while i < n [
