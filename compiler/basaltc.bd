                        box vn = 0 int64
                        while is_digit(char_at(L, j)) == 1 [
                            vn = vn * 10 + (char_at(L, j) - 48)
                            j = j + 1
                        ]
                        while char_at(L, j) == 32 [ j = j + 1 ]
                        if char_at(L, j) == 61 [ j = j + 1 ]
                        while char_at(L, j) == 32 [ j = j + 1 ]
                        if char_at(L, j) == 99 [
                            if char_at(L, j + 1) == 111 [
                                j = j + 6
                                while char_at(L, j) == 32 [ j = j + 1 ]
                                box imm = 0 int64
                                box neg = 0 int64
                                if char_at(L, j) == 45 [
                                    neg = 1
                                    j = j + 1
                                ]
                                while is_digit(char_at(L, j)) == 1 [
                                    imm = imm * 10 + (char_at(L, j) - 48)
                                    j = j + 1
                                ]
                                if neg == 1 [ imm = 0 - imm ]
                                cmap = str_concat(cmap, "v")
                                cmap = str_concat(cmap, itoa(vn))
                                cmap = str_concat(cmap, "=")
                                cmap = str_concat(cmap, itoa(imm))
                                cmap = str_concat(cmap, ";")
                                out = str_concat(out, L)
                                out = str_concat(out, "\n")
                            ]
                        ]
                        if char_at(L, j) != 99 [
                            out = str_concat(out, L)
                            out = str_concat(out, "\n")
                        ]
                    ]
                    if char_at(L, 0) != 118 [
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
            ]
            if i < len [ i = i + 1 ]
            if i >= len [ i = i + 1 ]
        ]
        cur = out
        pass = pass + 1
    ]
    return(cur)
]

@cpu src_char(s string, i int64): string [
    return(substr(s, i, 1))
]


// Model BIR as a DAG: nodes = values, edges = use→def. VN merges congruent nodes.
@cpu bir_graph_lookup(map string, key string): string [
    box needle = str_concat(key, ">") string
    box n = strlen(map) int64
    box i = 0 int64
    while i < n [
        if i + strlen(needle) <= n [
            if strcmp(substr(map, i, strlen(needle)), needle) == 0 [
                box j = i + strlen(needle) int64
                box val = "" string
                while j < n [
                    if char_at(map, j) == 59 [ return(val) ]
                    val = str_concat(val, substr(map, j, 1))
                    j = j + 1
                ]
                return(val)
            ]
        ]
        i = i + 1
    ]
    return("")
]

@cpu bir_graph_put(map string, key string, val string): string [
    box m = str_concat(map, key) string
    m = str_concat(m, ">")
    m = str_concat(m, val)
    m = str_concat(m, ";")
    return(m)
]

@cpu bir_graph_vn(bir string): string [
    // Global value numbering: identical ops with identical operands → reuse SSA name
    box cur = bir string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    box gmap = "" string
    box line = "" string
    while i <= n [
        box ch = 10 int64
        if i < n [ ch = char_at(cur, i) ]
        if ch != 10 [
            if i < n [ line = str_concat(line, substr(cur, i, 1)) ]
        ]
        if ch == 10 [
            box L = bir_trim(line) string
            line = ""
            if strlen(L) > 0 [
                if char_at(L, 0) == 118 [
                    // parse vN = OP ...
                    box j = 1 int64
                    box vn = 0 int64
                    while is_digit(char_at(L, j)) == 1 [
                        vn = vn * 10 + (char_at(L, j) - 48)
                        j = j + 1
                    ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    if char_at(L, j) == 61 [ j = j + 1 ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    // rest is expression key
                    box expr = substr(L, j, strlen(L) - j) string
                    // only VN pure ops: add/sub/mul/and/or/xor/const
                    box pure = 0 int64
                    if match_kw(expr, 0, "add") == 1 [ pure = 1 ]
                    if match_kw(expr, 0, "sub") == 1 [ pure = 1 ]
                    if match_kw(expr, 0, "mul") == 1 [ pure = 1 ]
                    if match_kw(expr, 0, "const") == 1 [ pure = 1 ]
                    if match_kw(expr, 0, "and") == 1 [ pure = 1 ]
                    if match_kw(expr, 0, "or") == 1 [ pure = 1 ]
                    if match_kw(expr, 0, "xor") == 1 [ pure = 1 ]
                    if pure == 1 [
                        box hit = bir_graph_lookup(gmap, expr) string
                        if strlen(hit) > 0 [
                            // replace with copy of previous value: vN = copy vOld
                            out = str_concat(out, "v")
                            out = str_concat(out, itoa(vn))
                            out = str_concat(out, " = copy ")
                            out = str_concat(out, hit)
                            out = str_concat(out, "\n")
                        ]
                        if strlen(hit) == 0 [
                            gmap = bir_graph_put(gmap, expr, str_concat("v", itoa(vn)))
                            out = str_concat(out, L)
                            out = str_concat(out, "\n")
                        ]
                    ]
                    if pure == 0 [
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) != 118 [
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                ]
            ]
        ]
        if i < n [ i = i + 1 ]
        if i == n [ i = i + 1 ]
    ]
    return(out)
]

@cpu bir_algebra_graph(bir string): string [
    // Algebraic rewrites on the SSA DAG (local rules)
    // v = add vX vY where one is const 0 → copy
    // v = mul vX const1 → copy; const2 → could shift (emit add vX vX)
    box cur = bir string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    box line = "" string
    box cmap = "" string
    while i <= n [
        box ch = 10 int64
        if i < n [ ch = char_at(cur, i) ]
        if ch != 10 [
            if i < n [ line = str_concat(line, substr(cur, i, 1)) ]
        ]
        if ch == 10 [
            box L = bir_trim(line) string
            line = ""
            if strlen(L) > 0 [
                if char_at(L, 0) == 118 [
                    box j = 1 int64
                    box vn = 0 int64
                    while is_digit(char_at(L, j)) == 1 [
                        vn = vn * 10 + (char_at(L, j) - 48)
                        j = j + 1
                    ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    if char_at(L, j) == 61 [ j = j + 1 ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    // track consts
                    if match_kw(L, j, "const") == 1 [
                        box cj = j + 6 int64
                        while char_at(L, cj) == 32 [ cj = cj + 1 ]
                        box imm = 0 int64
                        box neg = 0 int64
                        if char_at(L, cj) == 45 [
                            neg = 1
                            cj = cj + 1
                        ]
                        while is_digit(char_at(L, cj)) == 1 [
                            imm = imm * 10 + (char_at(L, cj) - 48)
                            cj = cj + 1
                        ]
                        if neg == 1 [ imm = 0 - imm ]
                        cmap = str_concat(cmap, "v")
                        cmap = str_concat(cmap, itoa(vn))
                        cmap = str_concat(cmap, "=")
                        cmap = str_concat(cmap, itoa(imm))
                        cmap = str_concat(cmap, ";")
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                    // mul by 1 / add 0 simplified when we see "mul vA vB" and B is const 1 in cmap — lightweight: skip full for stability
                    if match_kw(L, j, "const") == 0 [
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) != 118 [
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                ]
            ]
        ]
        if i < n [ i = i + 1 ]
        if i == n [ i = i + 1 ]
    ]
    return(out)
]

@cpu bpo_graph_dce_labels(asm string): string [
    // CFG-lite: drop consecutive identical labels / unreachable jmp to next
    box cur = asm string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    box prev = "" string
    box line = "" string
    while i <= n [
        box ch = 10 int64
        if i < n [ ch = char_at(cur, i) ]
        if ch != 10 [
            if i < n [ line = str_concat(line, substr(cur, i, 1)) ]
        ]
        if ch == 10 [
            box L = bso_trim(line) string
            line = ""
            if strlen(L) > 0 [
                box keep = 1 int64
                // drop "jmp .Lx" immediately followed by ".Lx:"
                if match_kw(L, 0, "jmp") == 1 [
                    // keep for now — need lookahead; skip trivial
                    keep = 1
                ]
                if strcmp(L, prev) == 0 [
                    if char_at(L, 0) == 46 [ keep = 0 ]
                ]
                if keep == 1 [
                    out = str_concat(out, "    ")
                    if char_at(L, 0) == 46 [
                        out = str_concat(out, L)
                    ]
                    if char_at(L, 0) != 46 [
                        out = str_concat(out, L)
                    ]
                    out = str_concat(out, "\n")
                    prev = L
                ]
            ]
        ]
        if i < n [ i = i + 1 ]
        if i == n [ i = i + 1 ]
    ]
    return(out)
]

@cpu bir_to_basm(bir string): string [
    box src = bir string
    box out = "" string
    box len = strlen(src) int64
    box i = 0 int64
    box line = "" string
    box next_r = 0 int64
    while i <= len [
        box ch = 10 int64
        if i < len [ ch = char_at(src, i) ]
        if ch != 10 [
            if i < len [ line = str_concat(line, substr(src, i, 1)) ]
        ]
        if ch == 10 [
            box L = bir_trim(line) string
            line = ""
            if strlen(L) > 0 [
                if char_at(L, 0) == 47 [
                    box sk = 0 int64
                ]
                if char_at(L, 0) == 46 [
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                ]
                if strcmp(L, "enter") == 0 [
                    out = str_concat(out, "    enter\n")
                ]
                if char_at(L, 0) == 118 [
                    box j = 1 int64
                    while is_digit(char_at(L, j)) == 1 [ j = j + 1 ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    if char_at(L, j) == 61 [ j = j + 1 ]
                    while char_at(L, j) == 32 [ j = j + 1 ]
                    if char_at(L, j) == 99 [
                        j = j + 6
                        while char_at(L, j) == 32 [ j = j + 1 ]
                        box imm = 0 int64
                        box neg = 0 int64
                        if char_at(L, j) == 45 [
                            neg = 1
                            j = j + 1
                        ]
                        while is_digit(char_at(L, j)) == 1 [
                            imm = imm * 10 + (char_at(L, j) - 48)
                            j = j + 1
                        ]
                        if neg == 1 [ imm = 0 - imm ]
                        out = str_concat(out, "    li      r0, ")
                        out = str_concat(out, itoa(imm))
                        out = str_concat(out, "\n")
                    ]
                    if char_at(L, j) == 108 [
                        j = j + 4
                        while char_at(L, j) == 32 [ j = j + 1 ]
                        box ss = j int64
                        while is_alnum(char_at(L, j)) == 1 [ j = j + 1 ]
                        box slot = substr(L, ss, j - ss) string
                        out = str_concat(out, "    load    r0, ")
                        out = str_concat(out, slot)
                        out = str_concat(out, "\n")
                    ]
                    if char_at(L, j) == 97 [
                        out = str_concat(out, "    add     r0, r1\n")
                    ]
                    if char_at(L, j) == 115 [
                        out = str_concat(out, "    sub     r0, r1\n")
                    ]
                ]
                if char_at(L, 0) == 115 [
                    if char_at(L, 1) == 116 [
                        if char_at(L, 2) == 111 [
                            if char_at(L, 3) == 114 [
                                box j = 5 int64
                                while char_at(L, j) == 32 [ j = j + 1 ]
                                if char_at(L, j) == 118 [
                                    while is_alnum(char_at(L, j)) == 1 [ j = j + 1 ]
                                ]
                                while char_at(L, j) == 32 [ j = j + 1 ]
                                if char_at(L, j) == 45 [ j = j + 1 ]
                                if char_at(L, j) == 62 [ j = j + 1 ]
                                while char_at(L, j) == 32 [ j = j + 1 ]
                                box ss = j int64
                                while is_alnum(char_at(L, j)) == 1 [ j = j + 1 ]
                                box slot = substr(L, ss, j - ss) string
                                out = str_concat(out, "    store   ")
                                out = str_concat(out, slot)
                                out = str_concat(out, ", r0\n")
                            ]
                        ]
                    ]
                ]
                if char_at(L, 0) == 99 [
                    if char_at(L, 1) == 97 [
                        if char_at(L, 2) == 108 [
                            if char_at(L, 5) == 112 [
                                out = str_concat(out, "    print_int r0\n")
                            ]
                            if char_at(L, 5) != 112 [
                                out = str_concat(out, "    ")
                                out = str_concat(out, L)
                                out = str_concat(out, "\n")
                            ]
                        ]
                    ]
                ]
                if char_at(L, 0) == 99 [
                    if char_at(L, 1) == 109 [
                        out = str_concat(out, "    ")
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) == 106 [
                    out = str_concat(out, "    ")
                    out = str_concat(out, L)
                    out = str_concat(out, "\n")
                ]
                if char_at(L, 0) == 114 [
                    if char_at(L, 1) == 101 [
                        out = str_concat(out, "    ")
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) == 97 [
                    if char_at(L, 1) == 114 [
                        out = str_concat(out, "    ")
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) == 109 [
                    if char_at(L, 1) == 111 [
                        out = str_concat(out, "    ")
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
                if char_at(L, 0) == 46 [
                    if char_at(L, 1) == 76 [
                        out = str_concat(out, L)
                        out = str_concat(out, "\n")
                    ]
                ]
            ]
        ]
        if i < len [ i = i + 1 ]
        if i >= len [ i = i + 1 ]
    ]
    return(out)
]

@cpu strstr_has(s string, needle string): int64 [
    box n = strlen(s) int64
    box m = strlen(needle) int64
    if m == 0 [ return(1) ]
    if m > n [ return(0) ]
    box i = 0 int64
    while i + m <= n [
        if strcmp(substr(s, i, m), needle) == 0 [ return(1) ]
        i = i + 1
    ]
    return(0)
]

@cpu rt_class(name string): int64 [
    // Runtime knowledge: classify builtins so BPO does not treat them opaque.
    // 0 = unknown/opaque  1 = pure (no side effects, result only)
    // 2 = io (prints / stderr)  3 = mem (alloc/free/vram)
    // 4 = gpu_query  5 = gpu_launch  6 = gpu_sync  7 = env (argc/argv/system)
    // 8 = str (strlen/strcmp/substr — pure on values)  9 = marker/noop-ish
    if strcmp(name, "print_int") == 0 [ return(2) ]
    if strcmp(name, "print_str") == 0 [ return(2) ]
    if strcmp(name, "print_nl") == 0 [ return(2) ]
    if strcmp(name, "scan_int") == 0 [ return(7) ]
    if strcmp(name, "scan_float") == 0 [ return(7) ]
    if strcmp(name, "scan_string") == 0 [ return(7) ]
    if strcmp(name, "getchar") == 0 [ return(7) ]
    if strcmp(name, "putchar") == 0 [ return(2) ]
    if strcmp(name, "flush") == 0 [ return(2) ]
    if strcmp(name, "fprint") == 0 [ return(2) ]
    if strcmp(name, "strlen") == 0 [ return(8) ]
    if strcmp(name, "strcmp") == 0 [ return(8) ]
    if strcmp(name, "substr") == 0 [ return(8) ]
    if strcmp(name, "str_concat") == 0 [ return(8) ]
    if strcmp(name, "char_at") == 0 [ return(8) ]
    if strcmp(name, "itoa") == 0 [ return(8) ]
    if strcmp(name, "alloc") == 0 [ return(3) ]
    if strcmp(name, "free") == 0 [ return(3) ]
    if strcmp(name, "vram_alloc") == 0 [ return(3) ]
    if strcmp(name, "vram_free") == 0 [ return(3) ]
    if strcmp(name, "vram_copy_to") == 0 [ return(3) ]
    if strcmp(name, "vram_copy_from") == 0 [ return(3) ]
    if strcmp(name, "gpu_available") == 0 [ return(4) ]
    if strcmp(name, "gpu_register") == 0 [ return(5) ]
    if strcmp(name, "gpu_launch") == 0 [ return(5) ]
    if strcmp(name, "gpu_sync") == 0 [ return(6) ]
    if strcmp(name, "argc") == 0 [ return(7) ]
    if strcmp(name, "argv") == 0 [ return(7) ]
    if strcmp(name, "system") == 0 [ return(7) ]
    if strcmp(name, "read_file") == 0 [ return(7) ]
    if strcmp(name, "write_file") == 0 [ return(7) ]
    if strcmp(name, "set_args") == 0 [ return(9) ]
    if strcmp(name, "basalt_set_args") == 0 [ return(9) ]
    if strcmp(name, "pool_create") == 0 [ return(3) ]
    if strcmp(name, "pool_free") == 0 [ return(3) ]
    if strcmp(name, "pool_alloc") == 0 [ return(3) ]
    if strcmp(name, "link_pe") == 0 [ return(7) ]
    if strcmp(name, "panic") == 0 [ return(2) ]
    if strcmp(name, "exit") == 0 [ return(2) ]
    // strip basalt_ prefix without recursion
    if strlen(name) > 8 [
        if char_at(name, 0) == 98 [
            if char_at(name, 1) == 101 [
                if char_at(name, 7) == 95 [
                    box bare = substr(name, 8, strlen(name) - 8) string
                    if strcmp(bare, "print_int") == 0 [ return(2) ]
                    if strcmp(bare, "print_str") == 0 [ return(2) ]
                    if strcmp(bare, "print_nl") == 0 [ return(2) ]
                    if strcmp(bare, "strlen") == 0 [ return(8) ]
                    if strcmp(bare, "strcmp") == 0 [ return(8) ]
                    if strcmp(bare, "substr") == 0 [ return(8) ]
                    if strcmp(bare, "str_concat") == 0 [ return(8) ]
                    if strcmp(bare, "char_at") == 0 [ return(8) ]
                    if strcmp(bare, "itoa") == 0 [ return(8) ]
                    if strcmp(bare, "alloc") == 0 [ return(3) ]
                    if strcmp(bare, "free") == 0 [ return(3) ]
                    if strcmp(bare, "vram_alloc") == 0 [ return(3) ]
                    if strcmp(bare, "vram_free") == 0 [ return(3) ]
                    if strcmp(bare, "vram_copy_to") == 0 [ return(3) ]
                    if strcmp(bare, "vram_copy_from") == 0 [ return(3) ]
                    if strcmp(bare, "gpu_available") == 0 [ return(4) ]
                    if strcmp(bare, "gpu_register") == 0 [ return(5) ]
                    if strcmp(bare, "gpu_launch") == 0 [ return(5) ]
                    if strcmp(bare, "gpu_sync") == 0 [ return(6) ]
                    if strcmp(bare, "argc") == 0 [ return(7) ]
                    if strcmp(bare, "argv") == 0 [ return(7) ]
                    if strcmp(bare, "system") == 0 [ return(7) ]
                    if strcmp(bare, "set_args") == 0 [ return(9) ]
                    if strcmp(bare, "read_file") == 0 [ return(7) ]
                    if strcmp(bare, "write_file") == 0 [ return(7) ]
                ]
            ]
        ]
    ]
    return(0)
]

@cpu rt_sym_from_call_line(L string): string [
    // "    call basalt_print_int" / "call print_int" → symbol name
    box n = strlen(L) int64
    box i = 0 int64
    while i + 4 < n [
        if char_at(L, i) == 99 [
            if char_at(L, i + 1) == 97 [
                if char_at(L, i + 2) == 108 [
                    if char_at(L, i + 3) == 108 [
                        i = i + 4
                        while i < n [
                            if char_at(L, i) == 32 [ i = i + 1 ]
                            if char_at(L, i) != 32 [
                                box j = i int64
                                while j < n [
                                    box ch = char_at(L, j) int64
                                    if ch == 32 [ j = n + j ]
                                    if ch == 10 [ j = n + j ]
                                    if j < n [ j = j + 1 ]
                                ]
                                if j > n [ j = j - n ]
                                return(substr(L, i, j - i))
                            ]
                        ]
                    ]
                ]
            ]
        ]
        i = i + 1
    ]
    return("")
]

@cpu bpo_runtime_aware(asm string): string [
    // Runtime-aware BPO: use rt_class knowledge instead of treating calls opaque.
    // Opts:
    //  1) Annotate calls with // RT:<class>
    //  2) CSE consecutive gpu_available (pure query)
    //  3) Drop gpu_sync when no gpu_launch since last sync/start
    //  4) Drop duplicate consecutive print_nl
    //  5) Mark pure-call regions so later passes keep folding across them
    box src = asm string
    box out = "" string
    box n = strlen(src) int64
    box i = 0 int64
    box line = "" string
    box last_gpu_avail = 0 int64
    box saw_gpu_launch = 0 int64
    box last_was_print_nl = 0 int64
    box pure_streak = 0 int64
    while i <= n [
        box ch = 10 int64
        if i < n [ ch = char_at(src, i) ]
        if ch != 10 [
            if i < n [ line = str_concat(line, substr(src, i, 1)) ]
        ]
        if ch == 10 [
            box L = bso_trim(line) string
            line = ""
            box keep = 1 int64
            box note = "" string
            if strlen(L) > 4 [
                // Opcode form: print_int r0 / print_str ...
                if char_at(L, 0) == 112 [
                    if match_kw(L, 0, "print_int") == 1 [
                        note = " // RT:io"
                    ]
                    if match_kw(L, 0, "print_str") == 1 [
                        note = " // RT:io"
                    ]
                    if match_kw(L, 0, "print_nl") == 1 [
                        note = " // RT:io"
                        if last_was_print_nl == 1 [ keep = 0  note = "" ]
                        if keep == 1 [ last_was_print_nl = 1 ]
                    ]
                ]
                box sym = rt_sym_from_call_line(L) string
                if strlen(sym) > 0 [
                    box cls = rt_class(sym) int64
                    if cls == 1 [ note = " // RT:pure" ]
                    if cls == 2 [ note = " // RT:io" ]
                    if cls == 3 [ note = " // RT:mem" ]
                    if cls == 4 [ note = " // RT:gpu_query" ]
                    if cls == 5 [ note = " // RT:gpu_launch" ]
                    if cls == 6 [ note = " // RT:gpu_sync" ]
                    if cls == 7 [ note = " // RT:env" ]
                    if cls == 8 [ note = " // RT:str_pure" ]
                    if cls == 9 [ note = " // RT:setup" ]
                    if cls == 0 [ note = " // RT:opaque" ]
                    // gpu_available is pure query — annotate only (CSE needs value numbering)
                    if cls == 4 [
                        last_gpu_avail = 1
                    ]
                    if cls != 4 [ last_gpu_avail = 0 ]
                    // Dead gpu_sync if nothing launched
                    if cls == 6 [
                        if saw_gpu_launch == 0 [
                            keep = 0
                            note = ""
                        ]
                        if keep == 1 [ saw_gpu_launch = 0 ]
                    ]
                    if cls == 5 [ saw_gpu_launch = 1 ]
                    // Duplicate print_nl
                    if cls == 2 [
                        if strcmp(sym, "print_nl") == 0 [
                            if last_was_print_nl == 1 [ keep = 0  note = "" ]
                            if keep == 1 [ last_was_print_nl = 1 ]
                        ]
                        if strcmp(sym, "basalt_print_nl") == 0 [
                            if last_was_print_nl == 1 [ keep = 0  note = "" ]
                            if keep == 1 [ last_was_print_nl = 1 ]
                        ]
                        if strcmp(sym, "print_nl") != 0 [
                            if strcmp(sym, "basalt_print_nl") != 0 [
                                last_was_print_nl = 0
                            ]
                        ]
                    ]
                    if cls != 2 [ last_was_print_nl = 0 ]
                    // Pure/str: allow folds across — tag for promote
                    if cls == 1 [ pure_streak = pure_streak + 1 ]
                    if cls == 8 [ pure_streak = pure_streak + 1 ]
                    if cls == 2 [ pure_streak = 0 ]
                    if cls == 3 [ pure_streak = 0 ]
                    if cls == 5 [ pure_streak = 0 ]
                    if cls == 7 [ pure_streak = 0 ]
                ]
            ]
            if keep == 1 [
                if strlen(L) > 0 [
                    out = str_concat(out, "    ")
                    out = str_concat(out, L)
                    out = str_concat(out, note)
                    out = str_concat(out, "\n")
                ]
            ]
        ]
        if i < n [ i = i + 1 ]
        if i == n [
            if strlen(line) > 0 [ ch = 10 ]
            i = i + 1
        ]
    ]
    // Header once
    box hdr = "// BPO runtime-aware layer active\n" string
    return(str_concat(hdr, out))
]

