@cpu bpo_promote_loop_regs(asm string): string [
    // Match modern sum loop:
    //   li N / store s8 / li 1 / store s16 / li 0 / store s24
    //   .L1: load s16 / load s8 / cmp / jg .L2 /
    //   load s24 / ... add ... store s24 / load s16 / +1 / store s16 / jmp .L1
    //   .L2: load s24
    // Promote to registers r8=s, r9=i, r10=n
    box head = "    li      r0, " string
    box cur = asm string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    while i < n [
        box did = 0 int64
        if i + 20 <= n [
            if strcmp(substr(cur, i, strlen(head)), head) == 0 [
                // try parse: li N; store s8; li 1; store s16; li 0; store s24; .L1:
                box k = i + strlen(head) int64
                box lim = "" string
                box dig = 1 int64
                while dig == 1 [
                    if k >= n [ dig = 0 ]
                    if dig == 1 [
                        box ch = char_at(cur, k) int64
                        if is_digit(ch) == 1 [
                            lim = str_concat(lim, substr(cur, k, 1))
                            k = k + 1
                        ]
                        if is_digit(ch) == 0 [ dig = 0 ]
                    ]
                ]
                box rest1 = "\n    store   s8, r0\n    li      r0, 1\n    store   s16, r0\n    li      r0, 0\n    store   s24, r0\n.L1:\n    load    r0, s16\n    load    r1, s8\n    cmp     r0, r1\n    jg .L2\n" string
                if strlen(lim) > 0 [
                    if k + strlen(rest1) <= n [
                        if strcmp(substr(cur, k, strlen(rest1)), rest1) == 0 [
                            // skip body until .L2:\n    load    r0, s24\n
                            box j = k + strlen(rest1) int64
                            box marker = ".L2:\n    load    r0, s24\n" string
                            box found = 0 int64
                            while j + strlen(marker) <= n [
                                if strcmp(substr(cur, j, strlen(marker)), marker) == 0 [
                                    found = 1
                                    out = str_concat(out, "    li      r8, 0\n")
                                    out = str_concat(out, "    li      r9, 1\n")
                                    out = str_concat(out, "    li      r10, ")
                                    out = str_concat(out, lim)
                                    out = str_concat(out, "\n.L1:\n    cmp     r9, r10\n    jg .L2\n    add     r8, r9\n    add     r9, 1\n    jmp .L1\n.L2:\n    mov     r0, r8\n")
                                    i = j + strlen(marker)
                                    did = 1
                                    j = n
                                ]
                                if found == 0 [ j = j + 1 ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bpo_unroll_reg_loop(asm string): string [
    // O4: 2x unroll of promoted sum loop (add r9, 1 form)
    box head = "    li      r8, 0\n    li      r9, 1\n    li      r10, " string
    box mid = "\n.L1:\n    cmp     r9, r10\n    jg .L2\n    add     r8, r9\n    add     r9, 1\n    jmp .L1\n.L2:\n    mov     r0, r8\n" string
    box cur = asm string
    box n = strlen(cur) int64
    box hn = strlen(head) int64
    box mn = strlen(mid) int64
    box i = 0 int64
    box out = "" string
    while i < n [
        box did = 0 int64
        if i + hn <= n [
            if strcmp(substr(cur, i, hn), head) == 0 [
                box k = i + hn int64
                box lim = "" string
                box dig = 1 int64
                while dig == 1 [
                    if k >= n [ dig = 0 ]
                    if dig == 1 [
                        box ch = char_at(cur, k) int64
                        if is_digit(ch) == 1 [
                            lim = str_concat(lim, substr(cur, k, 1))
                            k = k + 1
                        ]
                        if is_digit(ch) == 0 [ dig = 0 ]
                    ]
                ]
                if strlen(lim) > 0 [
                    if k + mn <= n [
                        if strcmp(substr(cur, k, mn), mid) == 0 [
                            out = str_concat(out, "    li      r8, 0\n")
                            out = str_concat(out, "    li      r9, 1\n")
                            out = str_concat(out, "    li      r10, ")
                            out = str_concat(out, lim)
                            out = str_concat(out, "\n.L1:\n")
                            out = str_concat(out, "    cmp     r9, r10\n")
                            out = str_concat(out, "    jg .L2\n")
                            out = str_concat(out, "    add     r8, r9\n")
                            out = str_concat(out, "    add     r9, 1\n")
                            out = str_concat(out, "    cmp     r9, r10\n")
                            out = str_concat(out, "    jg .L2\n")
                            out = str_concat(out, "    add     r8, r9\n")
                            out = str_concat(out, "    add     r9, 1\n")
                            out = str_concat(out, "    jmp .L1\n")
                            out = str_concat(out, ".L2:\n")
                            out = str_concat(out, "    mov     r0, r8\n")
                            i = k + mn
                            did = 1
                        ]
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu bpo_unroll_x4(asm string): string [
    if strlen(asm) > 3000 [ return(asm) ]
    // O5: 4x unroll of promoted sum loop
    box head = "    li      r8, 0\n    li      r9, 1\n    li      r10, " string
    box mid = "\n.L1:\n    cmp     r9, r10\n    jg .L2\n    add     r8, r9\n    add     r9, 1\n    jmp .L1\n.L2:\n    mov     r0, r8\n" string
    // also match 2x-unrolled form and expand to 4x
    box mid2 = "\n.L1:\n    cmp     r9, r10\n    jg .L2\n    add     r8, r9\n    add     r9, 1\n    cmp     r9, r10\n    jg .L2\n    add     r8, r9\n    add     r9, 1\n    jmp .L1\n.L2:\n    mov     r0, r8\n" string
    box cur = asm string
    box n = strlen(cur) int64
    box hn = strlen(head) int64
    box i = 0 int64
    box out = "" string
    while i < n [
        box did = 0 int64
        if i + hn <= n [
            if strcmp(substr(cur, i, hn), head) == 0 [
                box k = i + hn int64
                box lim = "" string
                box dig = 1 int64
                while dig == 1 [
                    if k >= n [ dig = 0 ]
                    if dig == 1 [
                        box ch = char_at(cur, k) int64
                        if is_digit(ch) == 1 [
                            lim = str_concat(lim, substr(cur, k, 1))
                            k = k + 1
                        ]
                        if is_digit(ch) == 0 [ dig = 0 ]
                    ]
                ]
                if strlen(lim) > 0 [
                    box body = "" string
                    box blen = 0 int64
                    // try mid2 first (already 2x)
                    if k + strlen(mid2) <= n [
                        if strcmp(substr(cur, k, strlen(mid2)), mid2) == 0 [
                            body = "4"
                            blen = strlen(mid2)
                        ]
                    ]
                    if strlen(body) == 0 [
                        if k + strlen(mid) <= n [
                            if strcmp(substr(cur, k, strlen(mid)), mid) == 0 [
                                body = "4"
                                blen = strlen(mid)
                            ]
                        ]
                    ]
                    if strlen(body) > 0 [
                        out = str_concat(out, "    li      r8, 0\n")
                        out = str_concat(out, "    li      r9, 1\n")
                        out = str_concat(out, "    li      r10, ")
                        out = str_concat(out, lim)
                        out = str_concat(out, "\n.L1:\n")
                        // 4x
                        out = str_concat(out, "    cmp     r9, r10\n    jg .L2\n    add     r8, r9\n    add     r9, 1\n")
                        out = str_concat(out, "    cmp     r9, r10\n    jg .L2\n    add     r8, r9\n    add     r9, 1\n")
                        out = str_concat(out, "    cmp     r9, r10\n    jg .L2\n    add     r8, r9\n    add     r9, 1\n")
                        out = str_concat(out, "    cmp     r9, r10\n    jg .L2\n    add     r8, r9\n    add     r9, 1\n")
                        out = str_concat(out, "    jmp .L1\n.L2:\n    mov     r0, r8\n")
                        i = k + blen
                        did = 1
                    ]
                ]
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

@cpu basm_has_loop(asm string): int64 [
    box n = strlen(asm) int64
    box i = 0 int64
    while i + 3 < n [
        if char_at(asm, i) == 46 [
            if char_at(asm, i + 1) == 76 [
                if char_at(asm, i + 2) == 49 [ return(1) ]
            ]
        ]
        i = i + 1
    ]
    return(0)
]

@cpu bpo_dead_li(asm string): string [
    // Remove "li r1, K" / "li r2, K" that are never used after (simple scan)
    box cur = asm string
    // Drop consecutive useless zeroing pattern after promote
    box p = "    li      r1, 3\n    li      r2, 7\n.L1:\n" string
    box r = ".L1:\n" string
    box n = strlen(cur) int64
    box i = 0 int64
    box out = "" string
    while i < n [
        box did = 0 int64
        if i + strlen(p) <= n [
            if strcmp(substr(cur, i, strlen(p)), p) == 0 [
                out = str_concat(out, r)
                i = i + strlen(p)
                did = 1
            ]
        ]
        if did == 0 [
            out = str_concat(out, substr(cur, i, 1))
            i = i + 1
        ]
    ]
    return(out)
]

